@* Meal Dictionary Modal *@
@if (showMealModal)
{
    <div class="fp-modal-overlay" @onclick="() => showMealModal = false">
        <div class="fp-data-modal" style="max-width: 950px; width: 95%; max-height: 90vh; overflow-y: auto;" @onclick:stopPropagation="true">
            <div class="fp-data-modal-header">
                <span class="fp-data-modal-title"><i class="fa fa-utensils"></i> @(editMeal.Id == 0 ? "ADD" : "EDIT") DICTIONARY MEAL</span>
                <button class="fp-data-modal-close" @onclick="() => showMealModal = false"><i class="fa fa-times"></i></button>
            </div>
            <div class="fp-data-modal-body">
                <div style="display: grid; grid-template-columns: 1fr 1.25fr; gap: 28px; align-items: start;">
                    
                    <!-- Left Column: Meal General Details -->
                    <div style="display: flex; flex-direction: column; gap: 20px;">
                        <div class="fp-input-group" style="margin-bottom: 0;">
                            <label>Meal Name *</label>
                            <input @bind="editMeal.MealName" placeholder="e.g. Chicken Pasta, Beef Rice..." />
                        </div>
                        <div class="fp-input-group" style="margin-bottom: 0;">
                            <label>Recipe / Instructions</label>
                            <textarea @bind="editMeal.Instruction" rows="6" placeholder="e.g. Cook the chicken with garlic, add rice and serve hot..." style="height: 140px;"></textarea>
                        </div>
                        <div class="fp-input-group" style="margin-bottom: 0;">
                            <label>Video or Recipe Link (optional)</label>
                            <input @bind="editMeal.Link" placeholder="https://youtube.com/..." />
                        </div>
                        
                        <!-- Manual Override Panel -->
                        <div class="fp-manual-override-panel">
                            <span class="fp-manual-override-title">
                                <i class="fa fa-sliders-h"></i> Manual Macro Override
                            </span>
                            <div class="fp-grid-2" style="gap: 12px;">
                                <div class="fp-input-group" style="margin-bottom:0;"><label style="font-size:11px;">Calories *</label><input type="number" @bind="editMeal.Calories" disabled="@editMealIngredients.Any()" /></div>
                                <div class="fp-input-group" style="margin-bottom:0;"><label style="font-size:11px;">Protein (g)</label><input type="number" @bind="editMeal.Protein" disabled="@editMealIngredients.Any()" /></div>
                            </div>
                            <div class="fp-grid-2" style="gap: 12px; margin-top: 12px;">
                                <div class="fp-input-group" style="margin-bottom:0;"><label style="font-size:11px;">Carbs (g)</label><input type="number" @bind="editMeal.Carbs" disabled="@editMealIngredients.Any()" /></div>
                                <div class="fp-input-group" style="margin-bottom:0;"><label style="font-size:11px;">Fats (g)</label><input type="number" @bind="editMeal.Fats" disabled="@editMealIngredients.Any()" /></div>
                            </div>
                            @if (editMealIngredients.Any())
                            {
                                <span style="font-size: 10px; color: var(--fp-accent); display: block; margin-top: 10px; font-weight: 500;">
                                    * Macros are calculated automatically from ingredients list.
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Right Column: Ingredients & Macros -->
                    <div>
                        <!-- Macro Summary Badges -->
                        <span class="fp-macro-box-title">Calculated Macro Totals</span>
                        <div class="fp-macro-grid">
                            <div class="fp-macro-box protein">
                                <span class="fp-macro-box-label">Protein</span>
                                <span class="fp-macro-box-value">@editMeal.Protein<small>g</small></span>
                            </div>
                            <div class="fp-macro-box carbs">
                                <span class="fp-macro-box-label">Carbs</span>
                                <span class="fp-macro-box-value">@editMeal.Carbs<small>g</small></span>
                            </div>
                            <div class="fp-macro-box fats">
                                <span class="fp-macro-box-label">Fats</span>
                                <span class="fp-macro-box-value">@editMeal.Fats<small>g</small></span>
                            </div>
                            <div class="fp-macro-box calories">
                                <span class="fp-macro-box-label">Calories</span>
                                <span class="fp-macro-box-value">@editMeal.Calories<small>kcal</small></span>
                            </div>
                        </div>

                        <!-- Ingredients block -->
                        <div class="fp-ing-container">
                            <div class="fp-ing-header">
                                <span>Ingredients List</span>
                                <button type="button" class="fp-btn-primary fp-data-btn" style="padding: 6px 14px; font-size: 12px; border-radius: 8px;" @onclick="AddIngredientToDictMeal">
                                    <i class="fa fa-plus"></i> Add Food Item
                                </button>
                            </div>
                            
                            @if (!editMealIngredients.Any())
                            {
                                <div style="text-align: center; padding: 40px 20px; opacity: 0.5;">
                                    <i class="fa fa-info-circle" style="font-size: 32px; margin-bottom: 12px; display: block; color: var(--fp-accent);"></i>
                                    <span style="font-size: 13px; color: var(--fp-text-secondary);">No ingredients added yet. Click "Add Food Item" to build your meal's recipe details and auto-calculate macros!</span>
                                </div>
                            }
                            else
                            {
                                @for (int i = 0; i < editMealIngredients.Count; i++)
                                {
                                    var idx = i;
                                    var ing = editMealIngredients[idx];
                                    
                                    <div class="fp-ing-card">
                                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                                            <span class="fp-ing-card-title">Food Item #@(idx + 1)</span>
                                            <div style="display: flex; align-items: center; gap: 8px;">
                                                <button type="button" class="fp-data-btn-secondary fp-data-btn" style="color: #22c55e; border-color: rgba(34,197,94,0.3); padding: 4px 10px; font-size: 11px; border-radius: 6px;" @onclick="() => FetchIngredientMacrosFromNinja(ing)">
                                                    <i class="fa fa-bolt"></i> Ninja Fill
                                                </button>
                                                <button type="button" class="fp-action-btn btn-delete" style="width: 24px; height: 24px; border-radius: 6px;" @onclick="() => RemoveIngredientFromDictMeal(idx)">
                                                    <i class="fa fa-times"></i>
                                                </button>
                                            </div>
                                        </div>
                                        
                                        <div class="fp-ing-inner-row">
                                            <div style="flex: 2.2; min-width: 0;">
                                                <input @bind="ing.MealName" placeholder="Food Name (e.g. Basmati Rice)" class="fp-ing-inner-input" />
                                            </div>
                                            <div style="flex: 1; min-width: 0;">
                                                <input type="number" step="any" @bind="ing.Quantity" @bind:after="RecalculateDictionaryMealMacros" placeholder="Qty" class="fp-ing-inner-input" />
                                            </div>
                                            <div style="flex: 1; min-width: 0;">
                                                <input @bind="ing.Unit" placeholder="Unit (e.g. g)" class="fp-ing-inner-input" />
                                            </div>
                                        </div>
                                        
                                        <div class="fp-ing-inner-grid">
                                            <div>
                                                <label>Protein (g)</label>
                                                <input type="number" @bind="ing.Protein" @bind:after="RecalculateDictionaryMealMacros" class="fp-ing-inner-input" />
                                            </div>
                                            <div>
                                                <label>Carbs (g)</label>
                                                <input type="number" @bind="ing.Carbs" @bind:after="RecalculateDictionaryMealMacros" class="fp-ing-inner-input" />
                                            </div>
                                            <div>
                                                <label>Fats (g)</label>
                                                <input type="number" @bind="ing.Fats" @bind:after="RecalculateDictionaryMealMacros" class="fp-ing-inner-input" />
                                            </div>
                                            <div>
                                                <label>Calories</label>
                                                <input type="number" @bind="ing.Calories" readonly style="color: var(--fp-accent); font-weight: bold;" class="fp-ing-inner-input" />
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="fp-data-modal-footer">
                <button class="fp-data-btn-secondary fp-data-btn" @onclick="() => showMealModal = false" disabled="@isSaving">Cancel</button>
                <button class="fp-btn-primary fp-data-btn" @onclick="SaveMeal" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span style="width: 12px; height: 12px; border: 2px solid #fff; border-right-color: transparent; border-radius: 50%; display: inline-block; animation: fp-spin 0.75s linear infinite; margin-right: 6px; vertical-align: middle;"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <i class="fa fa-save"></i> <span>Save Meal</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

