@page "/login"
@layout EmptyLayout

@inject NavigationManager Nav

<PageTitle>FitPanel — Sign In</PageTitle>

<div class="fp-login-page">

    @* ── Left: Branding Panel ── *@
    <div class="fp-brand-panel">
        <div class="fp-brand-inner">
            <div class="fp-logo">
                <span class="fp-logo-icon">FP</span>
                <span class="fp-logo-text">FIT<span>PANEL</span></span>
            </div>
            <h1 class="fp-brand-headline">TRAIN.<br/>TRACK.<br/>TRANSFORM.</h1>
            <p class="fp-brand-sub">
                The professional coaching platform for elite fitness coaches.
                Manage clients, build programs, and track progress — all in one place.
            </p>
            <div class="fp-brand-stats">
                <div class="fp-stat">
                    <span class="fp-stat-num">500+</span>
                    <span class="fp-stat-label">Clients Managed</span>
                </div>
                <div class="fp-stat">
                    <span class="fp-stat-num">50+</span>
                    <span class="fp-stat-label">Coaches</span>
                </div>
                <div class="fp-stat">
                    <span class="fp-stat-num">1000+</span>
                    <span class="fp-stat-label">Programs Created</span>
                </div>
            </div>
        </div>
    </div>

    @* ── Right: Login Form ── *@
    <div class="fp-form-panel">
        <div class="fp-form-inner">

            <div class="fp-form-header">
                <span class="fp-form-tag">WELCOME BACK</span>
                <h2>SIGN IN</h2>
                <div class="fp-form-line"></div>
            </div>

            @if (errorMessage == "invalid")
            {
                <div class="fp-alert fp-alert-danger">
                    <i class="fa fa-exclamation-circle"></i> Invalid email or password.
                </div>
            }
            else if (errorMessage == "locked")
            {
                <div class="fp-alert fp-alert-danger">
                    <i class="fa fa-lock"></i> Account locked. Try again in 15 minutes.
                </div>
            }

            <form method="post" action="/account/login" class="fp-form">
                <AntiforgeryToken />

                <div class="fp-field">
                    <label>EMAIL ADDRESS</label>
                    <input name="email"
                           type="email"
                           class="fp-input"
                           placeholder="coach@fitpanel.com"
                           required />
                </div>

                <div class="fp-field">
                    <label>PASSWORD</label>
                    <input name="password"
                           type="password"
                           class="fp-input"
                           placeholder="••••••••••"
                           required />
                </div>

                <div class="fp-remember">
                    <label class="fp-check-label">
                        <input name="rememberMe" type="checkbox" value="true" class="fp-checkbox" />
                        <span>Remember me</span>
                    </label>
                </div>

                <button type="submit" class="fp-btn">
                    <span>SIGN IN</span>
                    <i class="fa fa-arrow-right"></i>
                </button>
            </form>

            <div class="fp-form-footer">
                <p>© @DateTime.Now.Year FitPanel. All rights reserved.</p>
            </div>
        </div>
    </div>
</div>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Teko:wght@300..700&display=swap');
    @@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&display=swap');

    .fp-login-page {
        display: flex;
        min-height: 100vh;
        font-family: 'DM Sans', sans-serif;
        background: #0a0a0a;
    }
    .fp-brand-panel {
        flex: 1.1;
        background: linear-gradient(135deg, #0a0a0a 0%, #0d1a2e 60%, #001233 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
        padding: 60px;
    }
    .fp-brand-panel::before {
        content: '';
        position: absolute;
        width: 500px; height: 500px;
        background: radial-gradient(circle, rgba(234,33,39,0.15) 0%, transparent 70%);
        border-radius: 50%;
        top: 50%; left: 50%;
        transform: translate(-50%, -50%);
        animation: fp-pulse 5s ease-in-out infinite;
    }
    .fp-brand-panel::after {
        content: '';
        position: absolute;
        inset: 0;
        background: repeating-linear-gradient(
            0deg, transparent, transparent 60px,
            rgba(234,33,39,0.03) 60px, rgba(234,33,39,0.03) 61px
        ),
        repeating-linear-gradient(
            90deg, transparent, transparent 60px,
            rgba(234,33,39,0.03) 60px, rgba(234,33,39,0.03) 61px
        );
    }
    @@keyframes fp-pulse {
        0%, 100% { transform: translate(-50%,-50%) scale(1); opacity: 0.5; }
        50% { transform: translate(-50%,-50%) scale(1.3); opacity: 0.9; }
    }
    .fp-brand-inner { position: relative; z-index: 2; }
    .fp-logo { display: flex; align-items: center; gap: 14px; margin-bottom: 50px; }
    .fp-logo-icon {
        width: 52px; height: 52px;
        background: #ea2127;
        color: #fff;
        font-family: 'Teko', sans-serif;
        font-size: 22px; font-weight: 700;
        display: flex; align-items: center; justify-content: center;
        clip-path: polygon(0 0, 90% 0, 100% 10%, 100% 100%, 10% 100%, 0 90%);
    }
    .fp-logo-text {
        font-family: 'Teko', sans-serif;
        font-size: 28px; font-weight: 600;
        color: #fff; letter-spacing: 3px; text-transform: uppercase;
    }
    .fp-logo-text span { color: #ea2127; }
    .fp-brand-headline {
        font-family: 'Teko', sans-serif;
        font-size: 80px; font-weight: 700;
        line-height: 80px; color: #fff;
        text-transform: uppercase; margin-bottom: 30px; letter-spacing: 2px;
    }
    .fp-brand-sub {
        font-size: 16px; line-height: 28px; color: #888;
        max-width: 420px; margin-bottom: 50px; font-family: 'DM Sans', sans-serif;
    }
    .fp-brand-stats {
        display: flex; gap: 40px;
        border-top: 1px solid rgba(255,255,255,0.1); padding-top: 30px;
    }
    .fp-stat { display: flex; flex-direction: column; gap: 4px; }
    .fp-stat-num {
        font-family: 'Teko', sans-serif;
        font-size: 42px; font-weight: 700; color: #ea2127; line-height: 1;
    }
    .fp-stat-label {
        font-size: 13px; color: #666;
        text-transform: uppercase; letter-spacing: 1px; font-family: 'DM Sans', sans-serif;
    }
    .fp-form-panel {
        flex: 0.9; background: #111;
        display: flex; align-items: center; justify-content: center;
        padding: 60px 50px;
        border-left: 1px solid rgba(234,33,39,0.2);
    }
    .fp-form-inner { width: 100%; max-width: 420px; }
    .fp-form-header { margin-bottom: 40px; }
    .fp-form-tag {
        font-family: 'DM Sans', sans-serif;
        font-size: 13px; font-weight: 600; color: #ea2127;
        letter-spacing: 3px; text-transform: uppercase;
        display: block; margin-bottom: 10px;
    }
    .fp-form-header h2 {
        font-family: 'Teko', sans-serif;
        font-size: 60px; font-weight: 700; color: #fff;
        line-height: 1; text-transform: uppercase; margin: 0 0 16px;
    }
    .fp-form-line {
        width: 60px; height: 4px; background: #ea2127;
        clip-path: polygon(0 0, 95% 0, 100% 50%, 95% 100%, 0 100%);
    }
    .fp-alert {
        padding: 14px 18px; margin-bottom: 24px;
        font-size: 15px; font-family: 'DM Sans', sans-serif;
        border-left: 4px solid #ea2127;
    }
    .fp-alert-danger { background: rgba(234,33,39,0.1); color: #ff6b6b; }
    .fp-alert i { margin-right: 8px; }
    .fp-form { display: flex; flex-direction: column; gap: 20px; }
    .fp-field { display: flex; flex-direction: column; gap: 8px; }
    .fp-field label {
        font-family: 'DM Sans', sans-serif;
        font-size: 12px; font-weight: 600; color: #555;
        text-transform: uppercase; letter-spacing: 2px;
    }
    .fp-input {
        height: 56px; background: #1a1a1a !important;
        border: 1px solid #2a2a2a; color: #fff !important;
        padding: 0 20px; font-size: 15px; font-family: 'DM Sans', sans-serif;
        transition: border-color 0.3s; width: 100%; outline: none; border-radius: 0;
    }
    .fp-input:focus { border-color: #ea2127; }
    .fp-input::placeholder { color: #444; }
    .fp-remember { display: flex; align-items: center; margin-top: -4px; }
    .fp-check-label {
        display: flex; align-items: center; gap: 10px;
        cursor: pointer; font-size: 14px; color: #666; font-family: 'DM Sans', sans-serif;
    }
    .fp-checkbox { width: 18px; height: 18px; accent-color: #ea2127; cursor: pointer; }
    .fp-btn {
        height: 58px; background: #ea2127; color: #fff;
        border: 2px solid #ea2127; font-family: 'Teko', sans-serif;
        font-size: 22px; font-weight: 600; letter-spacing: 3px;
        text-transform: uppercase; cursor: pointer; transition: all 0.3s;
        display: flex; align-items: center; justify-content: center; gap: 12px;
        margin-top: 8px;
        clip-path: polygon(0 0, 97% 0, 100% 15%, 100% 100%, 3% 100%, 0 85%);
        width: 100%;
    }
    .fp-btn:hover { background: transparent; color: #ea2127; }
    .fp-form-footer {
        margin-top: 40px; padding-top: 24px;
        border-top: 1px solid #1e1e1e; text-align: center;
    }
    .fp-form-footer p { font-size: 13px; color: #444; font-family: 'DM Sans', sans-serif; }
    /* ── Mobile: ≤ 900px — brand panel hidden, form fills screen ── */
    @@media (max-width: 900px) {
        .fp-brand-panel { display: none; }
        .fp-form-panel {
            flex: 1;
            padding: 48px 28px;
            border-left: none;
        }
        .fp-form-inner {
            max-width: 100%;
        }
    }

    /* ── Small phones: ≤ 480px ── */
    @@media (max-width: 480px) {
        .fp-form-panel {
            padding: 36px 20px;
            align-items: flex-start;
            padding-top: 60px;
        }
        .fp-form-inner {
            width: 100%;
        }
        .fp-form-tag {
            font-size: 11px;
            letter-spacing: 2px;
        }
        .fp-form-header h2 {
            font-size: 42px;
        }
        .fp-form-header {
            margin-bottom: 28px;
        }
        .fp-input {
            height: 52px;
            font-size: 16px; /* prevents iOS zoom on focus */
            padding: 0 16px;
        }
        .fp-field label {
            font-size: 11px;
            letter-spacing: 1.5px;
        }
        .fp-btn {
            height: 54px;
            font-size: 20px;
            letter-spacing: 2px;
        }
        .fp-alert {
            font-size: 14px;
            padding: 12px 14px;
        }
        .fp-form-footer {
            margin-top: 28px;
        }
    }
</style>

@code {
    private string errorMessage = string.Empty;

    protected override void OnInitialized()
    {
        var uri = new Uri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        errorMessage = query["error"] ?? string.Empty;
    }
}