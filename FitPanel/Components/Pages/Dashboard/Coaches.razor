@code {
    private List<PanelUser> coaches = new();
    private bool isLoading = true;
    private bool showModal = false;
    private bool isSaving = false;
    private string formError = string.Empty;
    private string successMsg = string.Empty;

    private CreateCoachDto dto = new();
    
    private bool showEditModal = false;
    private PanelUser editingCoach = new();
    private string newCoachPassword = string.Empty;

    // Delete coach state
    private bool showDeleteModal = false;
    private PanelUser? coachToDelete = null;
    private bool isDeleting = false;
    private string deleteError = "";

    protected override async Task OnInitializedAsync()
    {
        var allCoaches = await UserManager.GetUsersInRoleAsync("Coach");
        coaches = allCoaches.ToList();
        isLoading = false;
    }

    private void CloseModal()
    {
        showModal = false;
        formError = string.Empty;
        successMsg = string.Empty;
       dto = new();
    }

    private async Task CreateCoach()
    {
        formError = string.Empty;
        successMsg = string.Empty;

        if (string.IsNullOrWhiteSpace(dto.FullName))
        { formError = "Full name is required."; return; }
        if (string.IsNullOrWhiteSpace(dto.Email))
        { formError = "Email is required."; return; }
        if (string.IsNullOrWhiteSpace(dto.Password) || dto.Password.Length < 8)
        { formError = "Password must be at least 8 characters."; return; }

        isSaving = true;
        var (success, message) = await AuthService.CreateCoachAsync(dto);
        isSaving = false;

        if (success)
        {
            successMsg = "Coach created successfully!";
            var allCoaches = await UserManager.GetUsersInRoleAsync("Coach");
            coaches = allCoaches.ToList();
            await Task.Delay(1500);
            CloseModal();
        }
        else
        {
            formError = message;
        }
    }

    private void OpenEditModal(PanelUser coach)
    {
        editingCoach = coach;
        newCoachPassword = string.Empty;
        showEditModal = true;
        formError = string.Empty;
        successMsg = string.Empty;
    }

    private async Task CloseEditModal()
    {
        showEditModal = false;
        newCoachPassword = string.Empty;
        var allCoaches = await UserManager.GetUsersInRoleAsync("Coach");
        coaches = allCoaches.ToList();
    }

    private async Task SaveEditCoach()
    {
        formError = string.Empty;
        successMsg = string.Empty;
        isSaving = true;

        // Fetch current DB values without tracking before update
        var originalCoach = await UserManager.FindByIdAsync(editingCoach.Id);
        int? oldMaxClients = originalCoach?.MaxClients;
        bool? oldIsActive = originalCoach?.IsActive;
        string? oldSpecialization = originalCoach?.Specialization;
        string? oldFullName = originalCoach?.FullName;

        if (!string.IsNullOrWhiteSpace(newCoachPassword))
        {
            if (newCoachPassword.Length < 8)
            {
                formError = "New password must be at least 8 characters.";
                isSaving = false;
                return;
            }

            var token = await UserManager.GeneratePasswordResetTokenAsync(editingCoach);
            var resetResult = await UserManager.ResetPasswordAsync(editingCoach, token, newCoachPassword);
            if (!resetResult.Succeeded)
            {
                formError = "Failed to update password: " + string.Join(", ", resetResult.Errors.Select(e => e.Description));
                isSaving = false;
                return;
            }
        }

        if (!editingCoach.IsActive)
        {
            await UserManager.UpdateSecurityStampAsync(editingCoach);
        }

        var result = await UserManager.UpdateAsync(editingCoach);
        isSaving = false;

        if (result.Succeeded)
        {
            if (oldMaxClients != null && oldMaxClients != editingCoach.MaxClients)
            {
                var title = "🔒 Client Limit Updated";
                var message = $"An administrator has updated your maximum allowed client limit to {editingCoach.MaxClients}. You can now manage up to {editingCoach.MaxClients} clients.";
                await NotificationService.CreateNotificationAsync(editingCoach.Id, title, message);
            }

            successMsg = "Coach updated successfully!";
            await Task.Delay(1500);
            await CloseEditModal();
        }
        else
        {
            formError = string.Join(", ", result.Errors.Select(e => e.Description));
        }
    }

    private async Task RenewSubscription(PanelUser coach)
    {
        coach.SubscriptionEndDate = DateTime.UtcNow.AddYears(1);
        await UserManager.UpdateAsync(coach);
    }

    private async Task TogglePdfThemePermission(PanelUser coach)
    {
        coach.CanChangePdfTheme = !coach.CanChangePdfTheme;
        await UserManager.UpdateAsync(coach);
        StateHasChanged();
    }

    private void PromptDeleteCoach(PanelUser coach)
    {
        coachToDelete = coach;
        deleteError = "";
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        coachToDelete = null;
        isDeleting = false;
        deleteError = "";
    }

    private async Task DeleteCoach()
    {
        if (coachToDelete == null) return;
        isDeleting = true;
        deleteError = "";

        try
        {
            // 1. Delete associated clients first to prevent Restrict foreign key violation
            var clientsToDelete = DbContext.Clients.Where(c => c.CoachId == coachToDelete.Id).ToList();
            if (clientsToDelete.Any())
            {
                DbContext.Clients.RemoveRange(clientsToDelete);
            }

            // 2. Delete templates
            var dietTemplates = DbContext.Set<DietTemplate>().Where(dt => dt.CoachId == coachToDelete.Id).ToList();
            if (dietTemplates.Any())
            {
                DbContext.Set<DietTemplate>().RemoveRange(dietTemplates);
            }

            var workoutTemplates = DbContext.Set<WorkoutTemplate>().Where(wt => wt.CoachId == coachToDelete.Id).ToList();
            if (workoutTemplates.Any())
            {
                DbContext.Set<WorkoutTemplate>().RemoveRange(workoutTemplates);
            }

            // 3. Delete dictionaries
            var exerciseDict = DbContext.Set<CoachExerciseDictionary>().Where(ed => ed.CoachId == coachToDelete.Id).ToList();
            if (exerciseDict.Any())
            {
                DbContext.Set<CoachExerciseDictionary>().RemoveRange(exerciseDict);
            }

            var mealDict = DbContext.Set<CoachMealDictionary>().Where(md => md.CoachId == coachToDelete.Id).ToList();
            if (mealDict.Any())
            {
                DbContext.Set<CoachMealDictionary>().RemoveRange(mealDict);
            }

            // Save EF Core changes
            await DbContext.SaveChangesAsync();

            // 4. Finally delete the Identity user
            var result = await UserManager.DeleteAsync(coachToDelete);
            if (result.Succeeded)
            {
                var allCoaches = await UserManager.GetUsersInRoleAsync("Coach");
                coaches = allCoaches.ToList();
                CloseDeleteModal();
            }
            else
            {
                deleteError = string.Join(", ", result.Errors.Select(e => e.Description));
            }
        }
        catch (Exception ex)
        {
            deleteError = "An error occurred while deleting the coach: " + ex.Message;
        }
        finally
        {
            isDeleting = false;
        }
    }
}
