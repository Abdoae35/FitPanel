@* Components/Layout/DashboardLayout.razor *@

@namespace FitPanel.Components.Layout
@inject SignInManager<PanelUser> SignInManager
@inject UserManager<PanelUser> UserManager
@inject NavigationManager Nav
@inject INotificationService NotificationService

@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime JS
<head>
    <link href="https://fonts.googleapis.com/css2?family=Teko:wght@300..700&display=swap" rel="stylesheet">
    <link href="/lib/bootstrap/dist/css/style.css" rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    </head>
<!-- Loader Start -->
  <div class="preloader" id="fp-preloader" style="top: -100%;">
    <div class="loader-wrap-heading">
      <div class="load-text"> <span>L</span> <span>o</span> <span>a</span> <span>d</span> <span>i</span> <span>n</span> <span>g</span> </div>
    </div>
  </div>
  <!-- Loader End -->

<div class="fp-dashboard @(isDark ? "fp-dark" : "fp-light")" id="fp-dashboard">

    @* ── Sidebar ── *@
    <aside class="fp-sidebar @(sidebarOpen ? "open" : "")" id="fp-sidebar">

        @* Logo *@
        <div class="fp-sidebar-logo">
            <span class="fp-logo-icon">FP</span>
            <span class="fp-logo-text">FIT<span>PANEL</span></span>
            @* JS-driven close button — no Blazor @onclick needed *@
            <button class="fp-close-sidebar-mobile" onclick="fpCloseSidebar()" type="button">
                <i class="fa fa-times"></i>
            </button>
        </div>

        @* Nav *@
        <nav class="fp-nav">
            <div class="fp-nav-group">
                <span class="fp-nav-label">MAIN</span>

                <NavLink href="/dashboard" Match="NavLinkMatch.All" class="fp-nav-item" onclick="fpCloseSidebar()">
                    <i class="fa fa-chart-line"></i>
                    <span>Dashboard</span>
                </NavLink>

                @* Admin only *@
                <AuthorizeView Roles="Admin" Context="adminCtx">
                    <Authorized>
                        <NavLink href="/dashboard/coaches" class="fp-nav-item" onclick="fpCloseSidebar()">
                            <i class="fa fa-user-tie"></i>
                            <span>Coaches</span>
                        </NavLink>
                    </Authorized>
                </AuthorizeView>

                @* Coach only *@
                <AuthorizeView Roles="Coach" Context="coachCtx">
                    <Authorized>
                        <NavLink href="/dashboard/clients" class="fp-nav-item" onclick="fpCloseSidebar()">
                            <i class="fa fa-users"></i>
                            <span>My Clients</span>
                        </NavLink>
                        <NavLink href="/dashboard/my-data" class="fp-nav-item" onclick="fpCloseSidebar()">
                            <i class="fa fa-database"></i>
                            <span>My Data</span>
                        </NavLink>
                        <NavLink href="/dashboard/profile" class="fp-nav-item" onclick="fpCloseSidebar()">
                            <i class="fa fa-user-cog"></i>
                            <span>My Profile</span>
                        </NavLink>
                    </Authorized>
                </AuthorizeView>
            </div>
        </nav>

        @* Bottom: user + logout *@
        <div class="fp-sidebar-bottom">
            <AuthorizeView Context="userCtx">
                <Authorized>
                    <div class="fp-user-card">
                        @if (!string.IsNullOrEmpty(currentUser?.ProfilePicture))
                        {
                            <img src="@currentUser.ProfilePicture" class="fp-user-avatar" alt="Avatar" style="object-fit: cover;" />
                        }
                        else
                        {
                            <div class="fp-user-avatar">
                                @GetInitials(currentUser?.FullName ?? userCtx.User.Identity?.Name)
                            </div>
                        }
                        <div class="fp-user-info">
                            <span class="fp-user-name">@(currentUser?.FullName ?? userCtx.User.Identity?.Name)</span>
                            <span class="fp-user-role">
                                @(userCtx.User.IsInRole(Policies.AdminRole) ? "Administrator" : Policies.CoachRole)
                            </span>
                        </div>
                    </div>
                </Authorized>
            </AuthorizeView>

            <form action="/logout" method="post" class="fp-logout-form">
                <AntiforgeryToken />
                <button type="submit" class="fp-logout-btn" title="Logout">
                    <i class="fa fa-sign-out-alt"></i>
                    <span>Logout</span>
                </button>
            </form>
        </div>
    </aside>

    @* ── Mobile Backdrop (JS-driven, no Blazor state needed) ── *@
    <div class="fp-sidebar-backdrop" id="fp-sidebar-backdrop" onclick="fpCloseSidebar()"></div>

    <div class="fp-main">

        @* Top Bar *@
        <header class="fp-topbar">
            <div class="fp-topbar-left">
                @* Burger button — pure JS, always works *@
                <button class="fp-toggle-sidebar" onclick="fpToggleSidebar()" type="button" id="fp-burger-btn">
                    <i class="fa fa-bars" id="fp-burger-icon"></i>
                </button>
                <div class="fp-breadcrumb">
                    <span class="hide-mobile-breadcrumb">FitPanel</span>
                    <i class="fa fa-chevron-right hide-mobile-breadcrumb"></i>
                    <span>@currentPage</span>
                </div>
            </div>

            <div class="fp-topbar-right">
              

                @* Settings/Profile Redirect button *@
                <a href="/dashboard/profile" class="fp-theme-toggle" title="My Profile & Settings" style="text-decoration: none; display: flex; align-items: center; justify-content: center; cursor: pointer;">
                    <i class="fa fa-cog"></i>
                </a>

                @* Notification Bell dropdown *@
                <div style="position: relative; display: inline-block;">
                    <button class="fp-theme-toggle" @onclick="ToggleNotificationDropdown" title="Notifications" type="button">
                        <i class="fa fa-bell"></i>
                        @if (notifications.Any(n => !n.IsRead))
                        {
                            <span class="fp-notification-badge">@notifications.Count(n => !n.IsRead)</span>
                        }
                    </button>

                    @if (showNotificationDropdown)
                    {
                        <div class="fp-notification-dropdown">
                            <div class="fp-notif-header">
                                <span>NOTIFICATIONS</span>
                                @if (notifications.Any(n => !n.IsRead))
                                {
                                    <button class="fp-notif-clear-btn" @onclick="MarkAllAsRead" type="button">Mark all read</button>
                                }
                            </div>
                            <div class="fp-notif-body">
                                @if (!notifications.Any())
                                {
                                    <div class="fp-notif-empty">
                                        <i class="fa fa-bell-slash"></i>
                                        <span>No new notifications</span>
                                    </div>
                                }
                                else
                                {
                                    @foreach (var notif in notifications)
                                    {
                                        <div class="fp-notif-item @(notif.IsRead ? "read" : "unread")">
                                            <div style="display:flex; justify-content:space-between; align-items:start; gap:8px;">
                                                <span class="fp-notif-title">@notif.Title</span>
                                                <div style="display:flex; gap:4px; flex-shrink:0;">
                                                    @if (!notif.IsRead)
                                                    {
                                                        <button class="fp-notif-action-btn" title="Mark as read" @onclick="() => MarkAsRead(notif)" type="button">
                                                            <i class="fa fa-check"></i>
                                                        </button>
                                                    }
                                                    <button class="fp-notif-action-btn delete" title="Delete" @onclick="() => DeleteNotification(notif)" type="button">
                                                        <i class="fa fa-trash"></i>
                                                    </button>
                                                </div>
                                            </div>
                                            <p class="fp-notif-msg">@notif.Message</p>
                                            <span class="fp-notif-time">@notif.CreatedAt.ToLocalTime().ToString("g")</span>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </header>

        @* Page Content — hidden on mobile when sidebar is open via CSS class on body *@
        <main class="fp-content">
            <div class="fp-page-body">
                @Body
            </div>
            
            <footer class="fp-footer">
                <div class="fp-footer-left">
                    &copy; @DateTime.Now.Year <span class="fp-logo-text-footer">FIT<span class="fp-text-accent">PANEL</span></span>. All rights reserved.
                </div>
                <div class="fp-footer-right">
                    <a href="#" class="fp-social-icon" title="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="#" class="fp-social-icon" title="Instagram"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#" class="fp-social-icon" title="X (Twitter)"><i class="fa-brands fa-x-twitter"></i></a>
                    <a href="#" class="fp-social-icon" title="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
                </div>
            </footer>
        </main>
    </div>
</div>

@* ── JS Helpers ── *@
<script>
    // Add 'open' class immediately on desktop so sidebar starts expanded
    (function() {
        if (window.innerWidth > 768) {
            var s = document.getElementById('fp-sidebar');
            if (s) s.classList.add('open');
        }
    })();

    function fpToggleSidebar() {
        var sidebar = document.getElementById('fp-sidebar');
        var icon = document.getElementById('fp-burger-icon');
        if (window.innerWidth <= 768) {
            var isOpen = document.body.classList.toggle('fp-sidebar-open');
            if (icon) icon.className = isOpen ? 'fa fa-times' : 'fa fa-bars';
        } else {
            if (sidebar) sidebar.classList.toggle('open');
        }
    }
    function fpCloseSidebar() {
        document.body.classList.remove('fp-sidebar-open');
        var icon = document.getElementById('fp-burger-icon');
        if (icon) icon.className = 'fa fa-bars';
    }

    // ── Preloader: DOM-based URL polling ──────────────────────────────────
    // Works for ALL Blazor render modes (including InteractiveServer/SignalR)
    // because it only watches window.location.href via setInterval — no
    // Blazor events, lifecycle hooks, or JS interop needed.
    (function () {
        var _lastUrl = '';
        var _hideTimer = null;
        var _transition = '0.7s cubic-bezier(0.86, 0, 0.09, 1)';

        function getEl() {
            return document.getElementById('fp-preloader');
        }

        function hidePreloader() {
            var el = getEl();
            if (!el) return;
            el.style.transition = 'top ' + _transition;
            el.style.top = '-100%';
        }

        function showAndScheduleHide() {
            var el = getEl();
            if (el) {
                // Show immediately (no transition on the way in)
                el.style.transition = 'none';
                el.style.top = '0';
            }
            if (_hideTimer) clearTimeout(_hideTimer);
            // Hide after 2 seconds
            _hideTimer = setTimeout(hidePreloader, 2000);
        }

        // First load: hide after 2s
        _lastUrl = window.location.href;
        showAndScheduleHide();

        // Poll every 100ms for URL changes (catches Blazor SignalR navigation)
        setInterval(function () {
            var url = window.location.href;
            if (url !== _lastUrl) {
                _lastUrl = url;
                showAndScheduleHide();
            }
        }, 100);
    })();
</script>

@* ── Styles ── *@
<style>
    @@import url('https://fonts.googleapis.com/css2?family=Teko:wght@300..700&display=swap');
@@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&display=swap');
@@import url('https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css');
    /* ── CSS Variables ── */
    .fp-dashboard.fp-dark {
        --fp-bg: #0a0a0a;
        --fp-surface: #111111;
        --fp-surface2: #1a1a1a;
        --fp-border: #222222;
        --fp-text: #ffffff;
        --fp-text-muted: #666666;
        --fp-text-secondary: #999999;
        --fp-accent: #ea2127;
        --fp-accent-hover: #c41920;
        --fp-sidebar-w: 240px;
        --fp-sidebar-w-closed: 70px;
    }
    .fp-dashboard.fp-light {
        --fp-bg: #f7f6f2;
        --fp-surface: #ffffff;
        --fp-surface2: #f0ede8;
        --fp-border: #e0ddd8;
        --fp-text: #111111;
        --fp-text-muted: #999999;
        --fp-text-secondary: #666666;
        --fp-accent: #ea2127;
        --fp-accent-hover: #c41920;
        --fp-sidebar-w: 240px;
        --fp-sidebar-w-closed: 70px;
    }

    /* ── Layout ── */
    body, html {
        margin: 0;
        padding: 0;
    }

    .fp-dashboard {
        display: flex;
        height: 100vh;
        height: 100dvh;
        background: var(--fp-bg);
        font-family: 'DM Sans', sans-serif;
        transition: background 0.3s;
        overflow: hidden;
    }

    /* ── Sidebar ── */
    .fp-sidebar {
        width: var(--fp-sidebar-w-closed);
        background: var(--fp-surface);
        border-right: 1px solid var(--fp-border);
        display: flex;
        flex-direction: column;
        transition: width 0.3s ease;
        overflow: hidden;
        position: sticky;
        top: 0;
        height: 100vh;
        flex-shrink: 0;
    }
    .fp-sidebar.open { width: var(--fp-sidebar-w); }

    /* ── Collapsed state text hiding (replaces old Blazor .hidden class) ── */
    .fp-sidebar:not(.open) .fp-logo-text { opacity: 0; width: 0; overflow: hidden; }
    .fp-sidebar:not(.open) .fp-nav-label { opacity: 0; }
    .fp-sidebar:not(.open) .fp-nav-item span { opacity: 0; width: 0; overflow: hidden; }
    .fp-sidebar:not(.open) .fp-user-info { opacity: 0; width: 0; overflow: hidden; }
    .fp-sidebar:not(.open) .fp-logout-btn span { opacity: 0; width: 0; overflow: hidden; }
    .fp-sidebar:not(.open) .fp-user-card { justify-content: center; }
    .fp-sidebar:not(.open) .fp-user-card .fp-user-avatar { margin: 0 auto; }

    /* Logo */
    .fp-sidebar-logo {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 20px 14px;
        border-bottom: 1px solid var(--fp-border);
        min-height: 70px;
        overflow: hidden;
        white-space: nowrap;
    }
    .fp-close-sidebar-mobile { display: none; }

    .fp-logo-icon {
        width: 42px; height: 42px;
        background: var(--fp-accent);
        color: #fff;
        font-family: 'Teko', sans-serif;
        font-size: 18px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        clip-path: polygon(0 0, 88% 0, 100% 12%, 100% 100%, 12% 100%, 0 88%);
    }
    .fp-logo-text {
        font-family: 'Teko', sans-serif;
        font-size: 22px;
        font-weight: 600;
        color: var(--fp-text);
        letter-spacing: 2px;
        text-transform: uppercase;
        transition: opacity 0.3s;
    }
    .fp-logo-text span { color: var(--fp-accent); }
    .fp-logo-text.hidden { opacity: 0; width: 0; overflow: hidden; }

    /* Nav */
    .fp-nav {
        flex: 1;
        padding: 16px 10px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        overflow-y: auto;
        overflow-x: hidden;
    }
    .fp-nav-group { display: flex; flex-direction: column; gap: 4px; margin-bottom: 16px; }
    .fp-nav-label {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--fp-text-muted);
        padding: 0 10px;
        margin-bottom: 4px;
        white-space: nowrap;
        overflow: hidden;
        transition: opacity 0.3s;
    }
    .fp-nav-label.hidden { opacity: 0; }

    .fp-nav-item {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 10px;
        color: var(--fp-text-secondary);
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
        border-left: 3px solid transparent;
        transition: all 0.2s;
        white-space: nowrap;
        overflow: hidden;
        border-radius: 2px;
    }
    .fp-nav-item i {
        font-size: 16px;
        width: 20px;
        text-align: center;
        flex-shrink: 0;
    }
    .fp-nav-item span { overflow: hidden; transition: opacity 0.3s; }
    .fp-nav-item span.hidden { opacity: 0; width: 0; }
    .fp-nav-item:hover {
        color: var(--fp-text);
        background: var(--fp-surface2);
        border-left-color: var(--fp-accent);
    }
    .fp-nav-item.active {
        color: var(--fp-accent);
        background: rgba(234,33,39,0.08);
        border-left-color: var(--fp-accent);
    }

    /* Sidebar Bottom */
    .fp-sidebar-bottom {
        border-top: 1px solid var(--fp-border);
        padding: 12px 10px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    .fp-user-card {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px;
        background: var(--fp-surface2);
        overflow: hidden;
    }
    .fp-user-card.mini { justify-content: center; }
    .fp-user-avatar {
        width: 36px; height: 36px;
        background: var(--fp-accent);
        color: #fff;
        font-family: 'Teko', sans-serif;
        font-size: 16px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        clip-path: polygon(0 0, 85% 0, 100% 15%, 100% 100%, 15% 100%, 0 85%);
    }
    .fp-user-info {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        transition: opacity 0.3s;
        min-width: 0;
    }
    .fp-user-info.hidden { opacity: 0; width: 0; }
    .fp-user-name {
        font-size: 13px;
        font-weight: 600;
        color: var(--fp-text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .fp-user-role {
        font-size: 11px;
        color: var(--fp-accent);
        text-transform: uppercase;
        letter-spacing: 1px;
    }
    .fp-logout-form { width: 100%; }
    .fp-logout-btn {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px;
        width: 100%;
        background: none;
        border: none;
        color: var(--fp-text-muted);
        font-size: 14px;
        font-family: 'DM Sans', sans-serif;
        cursor: pointer;
        transition: color 0.2s;
        white-space: nowrap;
    }
    .fp-logout-btn i { font-size: 16px; width: 20px; text-align: center; }
    .fp-logout-btn:hover { color: var(--fp-accent); }
    .fp-logout-btn span.hidden { opacity: 0; width: 0; overflow: hidden; }

    /* ── Main ── */
    .fp-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
        overflow-x: hidden;
    }

    /* Top Bar */
    .fp-topbar {
        height: 70px;
        background: var(--fp-surface);
        border-bottom: 1px solid var(--fp-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 24px;
        position: sticky;
        top: 0;
        z-index: 100;
    }
    .fp-topbar-left { display: flex; align-items: center; gap: 20px; }
    .fp-topbar-right { display: flex; align-items: center; gap: 12px; }

    .fp-toggle-sidebar {
        width: 38px; height: 38px;
        background: var(--fp-surface2);
        border: 1px solid var(--fp-border);
        color: var(--fp-text);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        transition: all 0.2s;
    }
    .fp-toggle-sidebar:hover { border-color: var(--fp-accent); color: var(--fp-accent); }

    .fp-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
        color: var(--fp-text-muted);
    }
    .fp-breadcrumb i { font-size: 10px; }
    .fp-breadcrumb span:last-child {
        color: var(--fp-text);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-family: 'Teko', sans-serif;
        font-size: 18px;
    }

    .fp-theme-toggle {
        width: 38px; height: 38px;
        background: var(--fp-surface2);
        border: 1px solid var(--fp-border);
        color: var(--fp-text);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        transition: all 0.2s;
    }
    .fp-theme-toggle:hover { border-color: var(--fp-accent); color: var(--fp-accent); }

    /* ── Content ── */
    .fp-content {
        flex: 1;
        background: var(--fp-bg);
        overflow-y: auto;
        display: flex;
        flex-direction: column;
    }
    .fp-page-body {
        padding: 24px 28px;
        flex: 1;
    }

    /* ── Footer ── */
    .fp-footer {
        padding: 20px 30px !important;
        background: transparent !important;
        border-top: 2px solid rgba(234,33,39,0.4) !important;
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
     
        margin-top: auto !important;
        position: relative !important;
        z-index: 1 !important;
    }
    .fp-footer::before, .fp-footer::after {
        display: none !important;
        content: none !important;
    }
    .fp-footer-left {
        font-size: 15px !important;
        font-weight: 500 !important;
        color: #cccccc !important;
    }
    .fp-logo-text-footer {
        font-family: 'Teko', sans-serif !important;
        font-weight: 700 !important;
        letter-spacing: 1px !important;
        color: #ffffff !important;
        font-size: 18px !important;
    }
    .fp-text-accent {
        color: var(--fp-accent) !important;
    }
    .fp-footer-right {
        display: flex !important;
        gap: 12px !important;
    }
    .fp-social-icon {
        width: 34px !important;
        height: 34px !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        border-radius: 4px !important;
        background: rgba(255,255,255,0.08) !important;
        border: 1px solid rgba(255,255,255,0.18) !important;
        color: rgba(255,255,255,0.8) !important;
        text-decoration: none !important;
        transition: all 0.2s !important;
        font-size: 15px !important;
    }
    .fp-social-icon:hover {
        background: var(--fp-accent);
        border-color: var(--fp-accent);
        color: #fff;
    }

    /* ── Global reusable card ── */
    .fp-card {
        background: var(--fp-surface);
        border: 1px solid var(--fp-border);
        padding: 20px 24px;
        margin-bottom: 20px;
    }
    .fp-card-title {
        font-family: 'Teko', sans-serif;
        font-size: 22px;
        font-weight: 600;
        color: var(--fp-text);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .fp-card-title::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--fp-border);
    }
    .fp-card-sub {
        font-size: 13px;
        color: var(--fp-text-muted);
