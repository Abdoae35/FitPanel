@* Diet Template Modal Editor *@
@if (showDietTemplateModal)
{
    <div class="fp-modal-overlay" @onclick="() => showDietTemplateModal = false">
        <div class="fp-data-modal" style="max-width: 950px; width: 95%; max-height: 90vh; overflow-y: auto;" @onclick:stopPropagation="true">
            <div class="fp-data-modal-header">
                <span class="fp-data-modal-title"><i class="fa fa-folder-open"></i> @(editDietTemplate.Id == 0 ? "CREATE" : "EDIT") DIET TEMPLATE</span>
                <button class="fp-data-modal-close" @onclick="() => showDietTemplateModal = false"><i class="fa fa-times"></i></button>
            </div>
            <div class="fp-data-modal-body">
                <div class="fp-grid-2" style="gap: 16px;">
                    <div class="fp-input-group">
                        <label>Template Name *</label>
                        <input @bind="editDietTemplate.Name" placeholder="e.g. 2000kcal High Protein Plan" />
                    </div>
                    <div class="fp-input-group">
                        <label>Expected Number of Meals</label>
                        <input type="number" readonly value="@editDietTemplateMeals.Count" style="color:var(--fp-text-secondary);" />
                    </div>
                </div>
                
                <div class="fp-input-group">
                    <label>Instructions & Recipe Guidelines</label>
                    <textarea @bind="editDietTemplate.Instructions" rows="3" placeholder="General rules (e.g. Drink 3L water, take multivitamins in the morning)..."></textarea>
                </div>

                <div style="margin-top:28px; border-top: 1px solid var(--fp-border); padding-top:24px;">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 20px;">
                        <h4 class="fp-template-section-title">Meals inside Template</h4>
                        <button type="button" class="fp-data-btn-secondary fp-data-btn" @onclick="AddMealToTemplate">
                            <i class="fa fa-plus"></i> Add Meal
                        </button>
                    </div>

                    @if (!editDietTemplateMeals.Any())
                    {
                        <p style="color:var(--fp-text-muted); font-size:13.5px; font-style:italic; font-family:'Inter',sans-serif;">No meals added to this template yet. Click "Add Meal" above.</p>
                    }
                    else
                    {
                        @for (int i = 0; i < editDietTemplateMeals.Count; i++)
                        {
                            var idx = i;
                            var meal = editDietTemplateMeals[idx];
                            var primaryIng = meal.Ingredients.FirstOrDefault();

                            <div class="fp-data-template-card">
                                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                                    <span style="font-weight:700; color:var(--fp-text); font-size:15px;">Meal #@(idx + 1)</span>
                                    <button type="button" class="fp-data-btn-secondary fp-data-btn" style="color:#ff6b6b; border-color:rgba(255,107,107,0.3);" @onclick="() => editDietTemplateMeals.RemoveAt(idx)">
                                        <i class="fa fa-trash"></i> Remove Meal
                                    </button>
                                </div>

                                <div style="display:flex; gap:16px; margin-bottom:16px; flex-wrap:wrap;">
                                    <div class="fp-input-group" style="flex:1; min-width:260px; margin-bottom:0;">
                                        <label>Import from Dictionary</label>
                                        <select @onchange="(e) => OnDictionaryMealSelected(meal, e.Value?.ToString())">
                                            <option value="">-- Select Saved Meal --</option>
                                            @foreach (var dm in meals)
                                            {
                                                <option value="@dm.Id">@dm.MealName (@dm.Calories kcal)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="fp-input-group" style="flex:1.2; min-width:260px; margin-bottom:0;">
                                        <label>Meal Name *</label>
                                        <input value="@meal.Name" @oninput='(e) => UpdateMealName(meal, e.Value?.ToString() ?? "")' placeholder="e.g. Eggs & Whole Wheat Toast" />
                                    </div>
                                </div>

                                @if (primaryIng != null)
                                {
                                    <div class="fp-grid-4" style="margin-top:16px; gap: 16px;">
                                        <div class="fp-input-group">
                                            <label>Protein (g)</label>
                                            <input type="number" value="@primaryIng.Protein" @onchange='(e) => UpdateMealProtein(meal, int.TryParse(e.Value?.ToString(), out var v) ? v : 0)' />
                                        </div>
                                        <div class="fp-input-group">
                                            <label>Carbs (g)</label>
                                            <input type="number" value="@primaryIng.Carbs" @onchange='(e) => UpdateMealCarbs(meal, int.TryParse(e.Value?.ToString(), out var v) ? v : 0)' />
                                        </div>
                                        <div class="fp-input-group">
                                            <label>Fats (g)</label>
                                            <input type="number" value="@primaryIng.Fats" @onchange='(e) => UpdateMealFats(meal, int.TryParse(e.Value?.ToString(), out var v) ? v : 0)' />
                                        </div>
                                        <div class="fp-input-group">
                                            <label>Calories (kcal) *</label>
                                            <input type="number" value="@primaryIng.Calories" @onchange='(e) => UpdateMealCalories(meal, int.TryParse(e.Value?.ToString(), out var v) ? v : 0)' style="color: var(--fp-accent); font-weight: bold;" />
                                        </div>
                                    </div>
                                }

                                <div class="fp-grid-2" style="margin-top:16px; gap: 16px;">
                                    <div class="fp-input-group">
                                        <label>Recipe / Instructions</label>
                                        <input @bind="meal.Instruction" placeholder="e.g. Scramble egg whites, toast the bread and serve hot" />
                                    </div>
                                    <div class="fp-input-group">
                                        <label>Video Link (optional)</label>
                                        <input @bind="meal.Link" placeholder="e.g. https://youtube.com/..." />
                                    </div>
