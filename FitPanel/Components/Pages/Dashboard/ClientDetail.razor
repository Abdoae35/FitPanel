@page "/dashboard/clients/{ClientId:int}"
@layout DashboardLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using FitPanel.Data
@using FitPanel.Data.Models
@using FitPanel.Services
@using FitPanel.DTOs.Client
@using FitPanel.DTOs.Diet
@using FitPanel.DTOs.Workout
@attribute [Authorize(Roles = "Coach")]
@inject UserManager<PanelUser> UserManager
@inject IClientService ClientService
@inject IDietService DietService
@inject IWorkoutService WorkoutService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Client Profile — FitPanel</PageTitle>

@if (isLoading)
{
    <div class="fp-loading">
        <div class="fp-spinner-lg"></div>
        <span>Loading client...</span>
    </div>
}
else if (client == null)
{
    <div class="fp-empty">
        <i class="fa fa-user-slash"></i>
        <p>Client not found.</p>
        <a href="/dashboard/clients" class="fp-btn-outline">← Back to Clients</a>
    </div>
}
else
{
    @* ── Header ── *@
    <div class="fp-client-header">
        <div class="fp-client-header-left">
            <a href="/dashboard/clients" class="fp-back-btn"><i class="fa fa-arrow-left"></i></a>
            <div class="fp-client-avatar-xl">@client.Name[..1].ToUpper()</div>
            <div>
                <h1 class="fp-client-title">@client.Name</h1>
                <div class="fp-client-meta-row">
                    <span><i class="fa fa-weight"></i> @client.Weight kg</span>
                    <span><i class="fa fa-calendar"></i> @client.SubscriptionDurationPerMonth month subscription</span>
                    <span><i class="fa fa-clock"></i> Joined @client.CreatedAt.ToString("MMM dd, yyyy")</span>
                </div>
            </div>
        </div>
    </div>

    @* ── Subscription Status ── *@
    <div class="fp-sub-status">
        <div class="fp-sub-info">
            <div class="fp-sub-block">
                <span class="fp-sub-label">START DATE</span>
                <span class="fp-sub-value">@client.StartDate.ToString("MMM dd, yyyy")</span>
            </div>
            <div class="fp-sub-divider"></div>
            <div class="fp-sub-block">
                <span class="fp-sub-label">END DATE</span>
                <span class="fp-sub-value @(IsExpired ? "fp-expired" : IsExpiringSoon ? "fp-expiring" : "")">
                    @client.EndDate.ToString("MMM dd, yyyy")
                </span>
            </div>
            <div class="fp-sub-divider"></div>
            <div class="fp-sub-block">
                <span class="fp-sub-label">STATUS</span>
                @if (IsExpired) { <span class="fp-badge fp-badge-danger">EXPIRED</span> }
                else if (IsExpiringSoon) { <span class="fp-badge fp-badge-warning">EXPIRING SOON</span> }
                else { <span class="fp-badge fp-badge-green">ACTIVE</span> }
            </div>
            <div class="fp-sub-divider"></div>
            <div class="fp-sub-block">
                <span class="fp-sub-label">DAYS LEFT</span>
                <span class="fp-sub-value @(IsExpired ? "fp-expired" : "")">@(IsExpired ? "0" : DaysLeft.ToString())</span>
            </div>
        </div>
        <button class="fp-btn-primary" @onclick='() => showRenewModal = true'>
            <i class="fa fa-refresh"></i> Renew
        </button>
    </div>

    @* ── Tabs ── *@
    <div class="fp-tabs">
        <button class="fp-tab @(activeTab == "diet" ? "active" : "")" @onclick='() => activeTab = "diet"'>
            <i class="fa fa-utensils"></i> Diet Plan
        </button>
        <button class="fp-tab @(activeTab == "workout" ? "active" : "")" @onclick='() => activeTab = "workout"'>
            <i class="fa fa-dumbbell"></i> Workout Plan
        </button>
    </div>

    @* ══════════ DIET TAB ══════════ *@
    @if (activeTab == "diet")
    {
        <div class="fp-tab-content">
            <div class="fp-section-header">
                <div>
                    <h2 class="fp-section-title">Diet Plans</h2>
                    <p class="fp-section-sub">@diets.Count plan@(diets.Count != 1 ? "s" : "") created</p>
                </div>
                <button class="fp-btn-primary" @onclick='() => showDietModal = true'>
                    <i class="fa fa-plus"></i> New Diet Plan
                </button>
            </div>

            @if (!diets.Any())
            {
                <div class="fp-empty-card"><i class="fa fa-utensils"></i><p>No diet plans yet.</p></div>
            }
            else
            {
                @foreach (var diet in diets)
                {
                    var mealsLeft = diet.NumberOfMeals - diet.MealItems.Count;
                    <div class="fp-plan-card">
                        <div class="fp-plan-card-header">
                            <div>
                                <span class="fp-plan-badge">Diet Plan</span>
                                <h3>@diet.NumberOfMeals Meals / Day</h3>
                                <span class="fp-plan-date">Created @diet.CreatedAt.ToString("MMM dd, yyyy")</span>
                            </div>
                            <div class="fp-plan-actions">
                                <button class="fp-icon-btn" title="Edit meal count" @onclick="() => OpenEditDietModal(diet)">
                                    <i class="fa fa-edit"></i>
                                </button>
                                <button class="fp-icon-btn @(mealsLeft <= 0 ? "fp-icon-btn-disabled" : "")"
                                        disabled="@(mealsLeft <= 0)"
                                        title="@(mealsLeft <= 0 ? "Meal limit reached" : $"Add Meal ({mealsLeft} left)")"
                                        @onclick="() => OpenAddMealModal(diet.Id)">
                                    <i class="fa fa-plus"></i>
                                    <span>@(mealsLeft <= 0 ? "Full" : $"{mealsLeft} left")</span>
                                </button>
                                <button class="fp-icon-btn fp-icon-btn-danger" title="Delete"
                                        @onclick="() => ConfirmDeleteDiet(diet.Id, diet.NumberOfMeals)">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </div>
                        </div>
                        <div class="fp-progress-row">
                            <span class="fp-progress-label">@diet.MealItems.Count / @diet.NumberOfMeals meals added</span>
                            <div class="fp-progress-bar">
                                <div class="fp-progress-fill"
                                     style="width:@(diet.NumberOfMeals > 0 ? (diet.MealItems.Count * 100 / diet.NumberOfMeals) : 0)%"></div>
                            </div>
                        </div>
                        @if (diet.MealItems.Any())
                        {
                            <div class="fp-meals-grid">
                                @foreach (var meal in diet.MealItems)
                                {
                                    <div class="fp-meal-card">
                                        <div class="fp-meal-card-header">
                                            <div class="fp-meal-name">@meal.MealName</div>
                                            <div class="fp-meal-actions">
                                                <button class="fp-meal-btn" @onclick="() => OpenEditMealModal(diet.Id, meal)"><i class="fa fa-edit"></i></button>
                                                <button class="fp-meal-btn fp-meal-btn-danger" @onclick="() => ConfirmDeleteMeal(meal.Id, meal.MealName, diet.Id)"><i class="fa fa-trash"></i></button>
                                            </div>
                                        </div>
                                        <div class="fp-meal-desc">@meal.Description</div>
                                        <div class="fp-macro-row">
                                          <div class="fp-macro"><span class="fp-macro-val">@Math.Max(0, meal.Protein)<small>g</small></span><span class="fp-macro-label">Protein</span></div>
<div class="fp-macro"><span class="fp-macro-val">@Math.Max(0, meal.Carbs)<small>g</small></span><span class="fp-macro-label">Carbs</span></div>
<div class="fp-macro"><span class="fp-macro-val">@Math.Max(0, meal.Fats)<small>g</small></span><span class="fp-macro-label">Fats</span></div>
<div class="fp-macro fp-macro-cal"><span class="fp-macro-val">@Math.Max(0, meal.Calories)<small>kcal</small></span><span class="fp-macro-label">Calories</span></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p style="color:var(--fp-text-muted);font-size:14px;padding:16px 0;">No meals yet. You can add up to @diet.NumberOfMeals meals.</p>
                        }
                    </div>
                }
            }
        </div>
    }

    @* ══════════ WORKOUT TAB ══════════ *@
    @if (activeTab == "workout")
    {
        <div class="fp-tab-content">
            <div class="fp-section-header">
                <div>
                    <h2 class="fp-section-title">Workout Plans</h2>
                    <p class="fp-section-sub">@workouts.Count plan@(workouts.Count != 1 ? "s" : "") created</p>
                </div>
                <button class="fp-btn-primary" @onclick='() => showWorkoutModal = true'>
                    <i class="fa fa-plus"></i> New Workout Plan
                </button>
            </div>

            @if (!workouts.Any())
            {
                <div class="fp-empty-card"><i class="fa fa-dumbbell"></i><p>No workout plans yet.</p></div>
            }
            else
            {
                @foreach (var workout in workouts)
                {
                    var daysLeft = workout.NumberOfWorkoutDays - workout.WorkoutDays.Count;
                    <div class="fp-plan-card">
                        <div class="fp-plan-card-header">
                            <div>
                                <span class="fp-plan-badge fp-plan-badge-blue">Workout Plan</span>
                                <h3>@workout.SplitName</h3>
                                <span class="fp-plan-date">@workout.NumberOfWorkoutDays days · @workout.CreatedAt.ToString("MMM dd, yyyy")</span>
                            </div>
                            <div class="fp-plan-actions">
                                <button class="fp-icon-btn" title="Edit day count" @onclick="() => OpenEditWorkoutModal(workout)">
                                    <i class="fa fa-edit"></i>
                                </button>
                                <button class="fp-icon-btn @(daysLeft <= 0 ? "fp-icon-btn-disabled" : "")"
                                        disabled="@(daysLeft <= 0)"
                                        title="@(daysLeft <= 0 ? "Day limit reached" : $"Add Day ({daysLeft} left)")"
                                        @onclick="() => OpenAddDayModal(workout.Id)">
                                    <i class="fa fa-plus"></i>
                                    <span>@(daysLeft <= 0 ? "Full" : $"{daysLeft} left")</span>
                                </button>
                                <button class="fp-icon-btn fp-icon-btn-danger" title="Delete"
                                        @onclick="() => ConfirmDeleteWorkout(workout.Id, workout.SplitName)">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </div>
                        </div>
                        <div class="fp-progress-row">
                            <span class="fp-progress-label">@workout.WorkoutDays.Count / @workout.NumberOfWorkoutDays days added</span>
                            <div class="fp-progress-bar">
                                <div class="fp-progress-fill"
                                     style="width:@(workout.NumberOfWorkoutDays > 0 ? (workout.WorkoutDays.Count * 100 / workout.NumberOfWorkoutDays) : 0)%"></div>
                            </div>
                        </div>
                        @if (workout.WorkoutDays.Any())
                        {
                            <div class="fp-days-list">
                                @foreach (var day in workout.WorkoutDays)
                                {
                                    <div class="fp-day-card">
                                        <div class="fp-day-header">
                                            <div class="fp-day-info">
                                                <span class="fp-day-badge">@day.Day.ToString()</span>
                                                <span class="fp-day-name">@day.DayName</span>
                                            </div>
                                            <button class="fp-icon-btn" @onclick="() => OpenAddExerciseModal(workout.Id, day.Id)">
                                                <i class="fa fa-plus"></i> Exercise
                                            </button>
                                        </div>
                                        @if (day.Exercises.Any())
                                        {
                                            <table class="fp-table fp-exercise-table">
                                                <thead><tr><th>Exercise</th><th>Sets</th><th>Reps</th><th>Rest</th><th></th></tr></thead>
                                                <tbody>
                                                    @foreach (var ex in day.Exercises)
                                                    {
                                                        <tr>
                                                            <td>
                                                                @if (!string.IsNullOrEmpty(ex.ExerciseLink))
                                                                {
                                                                    <a href="@ex.ExerciseLink" target="_blank" class="fp-exercise-link">@ex.ExerciseName <i class="fa fa-external-link-alt"></i></a>
                                                                }
                                                                else { @ex.ExerciseName }
                                                            </td>
                                                            <td><span class="fp-badge fp-badge-red">@ex.Sets</span></td>
                                                            <td>@ex.Reps</td>
                                                            <td style="color:var(--fp-text-muted)">@ex.RestTime</td>
                                                            <td>
                                                                <div style="display:flex;gap:6px;">
                                                                    <button class="fp-meal-btn" @onclick="() => OpenEditExerciseModal(workout.Id, day.Id, ex)"><i class="fa fa-edit"></i></button>
                                                                    <button class="fp-meal-btn fp-meal-btn-danger" @onclick="() => ConfirmDeleteExercise(ex.Id, ex.ExerciseName, workout.Id, day.Id)"><i class="fa fa-trash"></i></button>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        }
                                        @if (day.Cardio != null)
                                        {
                                            <div class="fp-cardio-badge">
                                                <i class="fa fa-running"></i>
                                                <span>@day.Cardio.CardioType · @day.Cardio.DurationMinutes min · @day.Cardio.Intensity</span>
                                                @if (!string.IsNullOrEmpty(day.Cardio.Notes)) { <span style="color:var(--fp-text-muted)"> — @day.Cardio.Notes</span> }
                                            </div>
                                        }
                                        else
                                        {
                                            <button class="fp-add-cardio-btn" @onclick="() => OpenAddCardioModal(workout.Id, day.Id)">
                                                <i class="fa fa-plus"></i> Add Cardio
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p style="color:var(--fp-text-muted);font-size:14px;padding:16px 0;">No days yet. You can add up to @workout.NumberOfWorkoutDays days.</p>
                        }
                    </div>
                }
            }
        </div>
    }
}

@* ══════════════════════════════ MODALS ══════════════════════════════ *@

@* New Diet *@
@if (showDietModal)
{
    <div class="fp-modal-overlay" @onclick='() => showDietModal = false'>
        <div class="fp-modal fp-modal-sm" @onclick:stopPropagation="true">
            <div class="fp-modal-header">
                <span class="fp-modal-title"><i class="fa fa-utensils"></i> NEW DIET PLAN</span>
                <button class="fp-modal-close" @onclick='() => showDietModal = false'><i class="fa fa-times"></i></button>
            </div>
            <div class="fp-modal-body">
                <div class="fp-input-group">
                    <label>Number of Meals per Day *</label>
                    <input type="number" @bind="newDiet.NumberOfMeals" min="1" max="10" placeholder="5" />
                </div>
                <p class="fp-hint"><i class="fa fa-info-circle"></i> You won't be able to add more meals than this number.</p>
            </div>
            <div class="fp-modal-footer">
                <button class="fp-btn-outline" @onclick='() => showDietModal = false'>Cancel</button>
                <button class="fp-btn-primary" @onclick="CreateDiet"><i class="fa fa-check"></i> Create</button>
            </div>
        </div>
    </div>
}

@* Edit Diet Meal Count *@
@if (showEditDietModal)
{
    <div class="fp-modal-overlay" @onclick='() => showEditDietModal = false'>
        <div class="fp-modal fp-modal-sm" @onclick:stopPropagation="true">
            <div class="fp-modal-header">
                <span class="fp-modal-title"><i class="fa fa-edit"></i> EDIT MEAL COUNT</span>
                <button class="fp-modal-close" @onclick='() => showEditDietModal = false'><i class="fa fa-times"></i></button>
            </div>
            <div class="fp-modal-body">
                <div class="fp-input-group">
                    <label>Number of Meals per Day *</label>
                    <input type="number" @bind="editDietMealCount" min="@editDietCurrentCount" max="10" />
                </div>
                <p class="fp-hint"><i class="fa fa-info-circle"></i> You already have @editDietCurrentCount meals — cannot set less than this.</p>
            </div>
            <div class="fp-modal-footer">
                <button class="fp-btn-outline" @onclick='() => showEditDietModal = false'>Cancel</button>
                <button class="fp-btn-primary" @onclick="UpdateDietMealCount"><i class="fa fa-check"></i> Update</button>
            </div>
        </div>
    </div>
}

@* Add/Edit Meal *@
@if (showMealModal)
{
    <div class="fp-modal-overlay" @onclick='() => showMealModal = false'>
        <div class="fp-modal" @onclick:stopPropagation="true">
            <div class="fp-modal-header">
                <span class="fp-modal-title"><i class="fa fa-@(editMealId > 0 ? "edit" : "plus")"></i> @(editMealId > 0 ? "EDIT MEAL" : "ADD MEAL")</span>
                <button class="fp-modal-close" @onclick='() => showMealModal = false'><i class="fa fa-times"></i></button>
            </div>
            <div class="fp-modal-body">
                <div class="fp-grid-2">
                    <div class="fp-input-group"><label>Meal Name *</label><input @bind="newMeal.MealName" placeholder="Grilled Chicken" /></div>
                   <div class="fp-input-group"><label>Calories *</label><input type="number" @bind="newMeal.Calories" min="0" placeholder="220" /></div>
                </div>
                <div class="fp-input-group"><label>Description</label><input @bind="newMeal.Description" placeholder="Lean protein source..." /></div>
                <div class="fp-grid-3">
                    <div class="fp-input-group"><label>Protein (g)</label><input type="number" @bind="newMeal.Protein" min="0" placeholder="40" /></div>
<div class="fp-input-group"><label>Carbs (g)</label><input type="number" @bind="newMeal.Carbs" min="0" placeholder="0" /></div>
<div class="fp-input-group"><label>Fats (g)</label><input type="number" @bind="newMeal.Fats" min="0" placeholder="5" /></div>
                </div>
                <div class="fp-input-group"><label>Video Link (optional)</label><input @bind="newMeal.Link" placeholder="https://youtube.com/..." /></div>
            </div>
            <div class="fp-modal-footer">
                <button class="fp-btn-outline" @onclick='() => showMealModal = false'>Cancel</button>
                <button class="fp-btn-primary" @onclick="SaveMeal"><i class="fa fa-check"></i> @(editMealId > 0 ? "Update" : "Add Meal")</button>
            </div>
        </div>
    </div>
}

@* New Workout *@
@if (showWorkoutModal)
{
    <div class="fp-modal-overlay" @onclick='() => showWorkoutModal = false'>
        <div class="fp-modal fp-modal-sm" @onclick:stopPropagation="true">
            <div class="fp-modal-header">
                <span class="fp-modal-title"><i class="fa fa-dumbbell"></i> NEW WORKOUT PLAN</span>
                <button class="fp-modal-close" @onclick='() => showWorkoutModal = false'><i class="fa fa-times"></i></button>
            </div>
            <div class="fp-modal-body">
                <div class="fp-input-group"><label>Split Name *</label><input @bind="newWorkout.SplitName" placeholder="Push Pull Legs / Arnold Split..." /></div>
                <div class="fp-input-group"><label>Number of Days *</label><input type="number" @bind="newWorkout.NumberOfWorkoutDays" min="1" max="7" placeholder="5" /></div>
                <p class="fp-hint"><i class="fa fa-info-circle"></i> You won't be able to add more days than this number.</p>
            </div>
            <div class="fp-modal-footer">
                <button class="fp-btn-outline" @onclick='() => showWorkoutModal = false'>Cancel</button>
                <button class="fp-btn-primary" @onclick="CreateWorkout"><i class="fa fa-check"></i> Create</button>
            </div>
        </div>
    </div>
}

@* Edit Workout Day Count *@
@if (showEditWorkoutModal)
{
    <div class="fp-modal-overlay" @onclick='() => showEditWorkoutModal = false'>
        <div class="fp-modal fp-modal-sm" @onclick:stopPropagation="true">
            <div class="fp-modal-header">
                <span class="fp-modal-title"><i class="fa fa-edit"></i> EDIT DAY COUNT</span>
                <button class="fp-modal-close" @onclick='() => showEditWorkoutModal = false'><i class="fa fa-times"></i></button>
            </div>
            <div class="fp-modal-body">
                <div class="fp-input-group"><label>Number of Workout Days *</label><input type="number" @bind="editWorkoutDayCount" min="@editWorkoutCurrentCount" max="7" /></div>
                <p class="fp-hint"><i class="fa fa-info-circle"></i> You already have @editWorkoutCurrentCount days — cannot set less than this.</p>
            </div>
            <div class="fp-modal-footer">
                <button class="fp-btn-outline" @onclick='() => showEditWorkoutModal = false'>Cancel</button>
                <button class="fp-btn-primary" @onclick="UpdateWorkoutDayCount"><i class="fa fa-check"></i> Update</button>
            </div>
        </div>
    </div>
}

@* Add Workout Day *@
@if (showDayModal)
{
    <div class="fp-modal-overlay" @onclick='() => showDayModal = false'>
        <div class="fp-modal fp-modal-sm" @onclick:stopPropagation="true">
            <div class="fp-modal-header">
                <span class="fp-modal-title"><i class="fa fa-calendar-plus"></i> ADD WORKOUT DAY</span>
                <button class="fp-modal-close" @onclick='() => showDayModal = false'><i class="fa fa-times"></i></button>
            </div>
            <div class="fp-modal-body">
                <div class="fp-input-group"><label>Day Name *</label><input @bind="newDay.DayName" placeholder="Push Day / Chest Day..." /></div>
                <div class="fp-input-group">
                    <label>Day of Week *</label>
                    <select @bind="newDayEnum">
                        <option value="0">@Days.Day1.ToString()</option>
                        <option value="1">@Days.Day2.ToString()</option>
                        <option value="2">@Days.Day3.ToString()</option>
                        <option value="3">@Days.Day4.ToString()</option>
                        <option value="4">@Days.Day5.ToString()</option>
                        <option value="5">@Days.Day6.ToString()</option>
                        <option value="6">@Days.Day7.ToString()</option>
                    </select>
                </div>
            </div>
            <div class="fp-modal-footer">
                <button class="fp-btn-outline" @onclick='() => showDayModal = false'>Cancel</button>
                <button class="fp-btn-primary" @onclick="AddWorkoutDay"><i class="fa fa-check"></i> Add Day</button>
            </div>
        </div>
    </div>
}

@* Add/Edit Exercise *@
@if (showExerciseModal)
{
    <div class="fp-modal-overlay" @onclick='() => showExerciseModal = false'>
        <div class="fp-modal" @onclick:stopPropagation="true">
            <div class="fp-modal-header">
                <span class="fp-modal-title"><i class="fa fa-dumbbell"></i> @(editExerciseId > 0 ? "EDIT EXERCISE" : "ADD EXERCISE")</span>
                <button class="fp-modal-close" @onclick='() => showExerciseModal = false'><i class="fa fa-times"></i></button>
            </div>
            <div class="fp-modal-body">
                <div class="fp-input-group"><label>Exercise Name *</label><input @bind="newExercise.ExerciseName" placeholder="Bench Press" /></div>
                <div class="fp-grid-3">
                    <div class="fp-input-group"><label>Sets *</label><input @bind="newExercise.Sets" placeholder="4" /></div>
                    <div class="fp-input-group"><label>Reps *</label><input @bind="newExercise.Reps" placeholder="8-10" /></div>
                    <div class="fp-input-group"><label>Rest Time *</label><input @bind="newExercise.RestTime" placeholder="90s" /></div>
                </div>
                <div class="fp-input-group"><label>Video Link (optional)</label><input @bind="newExercise.ExerciseLink" placeholder="https://youtube.com/..." /></div>
            </div>
            <div class="fp-modal-footer">
                <button class="fp-btn-outline" @onclick='() => showExerciseModal = false'>Cancel</button>
                <button class="fp-btn-primary" @onclick="SaveExercise"><i class="fa fa-check"></i> @(editExerciseId > 0 ? "Update" : "Add Exercise")</button>
            </div>
        </div>
    </div>
}

@* Add Cardio *@
@if (showCardioModal)
{
    <div class="fp-modal-overlay" @onclick='() => showCardioModal = false'>
        <div class="fp-modal fp-modal-sm" @onclick:stopPropagation="true">
            <div class="fp-modal-header">
                <span class="fp-modal-title"><i class="fa fa-running"></i> ADD CARDIO</span>
                <button class="fp-modal-close" @onclick='() => showCardioModal = false'><i class="fa fa-times"></i></button>
            </div>
            <div class="fp-modal-body">
                <div class="fp-input-group"><label>Cardio Type *</label><input @bind="newCardio.CardioType" placeholder="Treadmill / Bike / Rowing..." /></div>
                <div class="fp-grid-2">
                    <div class="fp-input-group"><label>Duration (minutes) *</label><input type="number" @bind="newCardio.DurationMinutes" placeholder="20" /></div>
                    <div class="fp-input-group">
                        <label>Intensity *</label>
                        <select @bind="newCardioIntensity">
                            <option value="0">Low</option>
                            <option value="1">Medium</option>
                            <option value="2">High</option>
                        </select>
                    </div>
                </div>
                <div class="fp-input-group"><label>Notes (optional)</label><input @bind="newCardio.Notes" placeholder="After session, fasted..." /></div>
            </div>
            <div class="fp-modal-footer">
                <button class="fp-btn-outline" @onclick='() => showCardioModal = false'>Cancel</button>
                <button class="fp-btn-primary" @onclick="AddCardio"><i class="fa fa-check"></i> Add Cardio</button>
            </div>
        </div>
    </div>
}

@* Renew Subscription *@
@if (showRenewModal)
{
    <div class="fp-modal-overlay" @onclick='() => showRenewModal = false'>
        <div class="fp-modal fp-modal-sm" @onclick:stopPropagation="true">
            <div class="fp-modal-header">
                <span class="fp-modal-title"><i class="fa fa-refresh"></i> RENEW SUBSCRIPTION</span>
                <button class="fp-modal-close" @onclick='() => showRenewModal = false'><i class="fa fa-times"></i></button>
            </div>
            <div class="fp-modal-body">
                <p style="color:var(--fp-text-muted);font-size:14px;margin-bottom:20px;">
                    Ends on <strong style="color:var(--fp-text);">@client!.EndDate.ToString("MMM dd, yyyy")</strong>. New subscription starts today.
                </p>
                <div class="fp-input-group">
                    <label>Number of Months *</label>
                    <select @bind="renewMonths">
                        <option value="1">1 Month</option>
                        <option value="2">2 Months</option>
                        <option value="3">3 Months</option>
                        <option value="6">6 Months</option>
                        <option value="12">12 Months</option>
                    </select>
                </div>
                @if (!string.IsNullOrEmpty(renewMessage))
                {
                    <div class="fp-alert @(renewSuccess ? "fp-alert-success" : "fp-alert-danger")">@renewMessage</div>
                }
            </div>
            <div class="fp-modal-footer">
                <button class="fp-btn-outline" @onclick='() => showRenewModal = false'>Cancel</button>
                <button class="fp-btn-primary" @onclick="RenewSubscription" disabled="@isRenewing">
                    @if (isRenewing) { <span class="fp-spinner-sm"></span><span>Renewing...</span> }
                    else { <i class="fa fa-check"></i><span>Confirm</span> }
                </button>
            </div>
        </div>
    </div>
}

@* ── Delete Confirm (shared) ── *@
@if (showDeleteConfirm)
{
    <div class="fp-modal-overlay" @onclick='() => showDeleteConfirm = false'>
        <div class="fp-modal fp-modal-sm" @onclick:stopPropagation="true">
            <div class="fp-modal-header">
                <span class="fp-modal-title" style="color:#ef4444;">
                    <i class="fa fa-exclamation-triangle"></i> DELETE @deleteConfirmType.ToUpper()
                </span>
            </div>
            <div class="fp-modal-body">
                <p style="color:var(--fp-text);font-size:15px;line-height:1.6;">
                    Are you sure you want to delete <strong>@deleteConfirmName</strong>?<br/>
                    <span style="color:var(--fp-text-muted);font-size:13px;">@deleteConfirmMessage</span>
                </p>
            </div>
            <div class="fp-modal-footer">
                <button class="fp-btn-outline" @onclick='() => showDeleteConfirm = false'>Cancel</button>
                <button class="fp-btn-primary" style="background:#c41920;border-color:#c41920;" @onclick="ExecuteDelete">
                    <i class="fa fa-trash"></i> Delete
                </button>
            </div>
        </div>
    </div>
}

