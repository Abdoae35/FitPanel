@page "/dashboard"
@namespace FitPanel.Components.Pages.Dashboard
@layout DashboardLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using FitPanel.Components.Layout
@using FitPanel.Data
@using FitPanel.Services
@using FitPanel.DTOs.Client
@attribute [Authorize]
@inject UserManager<PanelUser> UserManager
@inject IClientService ClientService
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Dashboard — FitPanel</PageTitle>
<head>
    <link href="/lib/bootstrap/dist/css/style.css" rel="stylesheet">
    
</head>


@* ── Stats Row ── *@
<div class="fp-grid-4" style="margin-bottom: 28px;">
    <div class="fp-stat-card">
        <span class="fp-stat-card-label">Total Clients</span>
        <span class="fp-stat-card-value">@clients.Count</span>
    </div>
    <div class="fp-stat-card">
        <span class="fp-stat-card-label">Active This Month</span>
        <span class="fp-stat-card-value">@activeClients</span>
    </div>
    <div class="fp-stat-card">
        <span class="fp-stat-card-label">Avg. Subscription</span>
        <span class="fp-stat-card-value">
            @avgSub<span class="fp-stat-unit">mo</span>
        </span>
    </div>
    <div class="fp-stat-card">
        <span class="fp-stat-card-label">New This Month</span>
        <span class="fp-stat-card-value">@newThisMonth</span>
    </div>
</div>

@* ── Recent Clients ── *@
<div class="fp-card">
    <div class="fp-card-title">
        <i class="fa fa-users" style="color:var(--fp-accent);font-size:22px;"></i>
        Recent Clients
    </div>
    <p class="fp-card-sub">Your most recently added clients</p>

    @if (isLoading)
    {
        <div class="fp-loading">
            <div class="fp-spinner-lg"></div>
            <span>Loading clients...</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="fp-empty">
            <i class="fa fa-exclamation-triangle" style="color:var(--fp-accent);"></i>
            <p>@errorMessage</p>
        </div>
    }
    else if (!clients.Any())
    {
        <div class="fp-empty">
            <i class="fa fa-user-plus"></i>
            <p>No clients yet. <a href="/dashboard/clients" class="fp-link">Add your first client →</a></p>
        </div>
    }
    else
    {
        @* ── Desktop table ── *@
        <div class="fp-table-wrap">
            <table class="fp-table">
                <thead>
                    <tr>
                        <th>Client</th>
                        <th>Weight</th>
                        <th>Subscription</th>
                        <th>Joined</th>
                        <th>Expiration Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var client in clients.Take(5))
                    {
                        <tr>
                            <td>
                                <div class="fp-client-name-cell">
                                    <div class="fp-client-avatar">@client.Name[..1].ToUpper()</div>
                                    <span style="font-weight:600;">@client.Name</span>
                                </div>
                            </td>
                            <td>
                                @client.Weight
                                <span class="fp-unit">kg</span>
                            </td>
                            <td>
                                <span class="fp-badge fp-badge-red">@client.SubscriptionDurationPerMonth mo</span>
                            </td>
                            <td class="fp-muted-cell">
                                @client.CreatedAt.ToString("MMM dd, yyyy")
                            </td>
                            <td class="fp-muted-cell">
                                @(client.CreatedAt.AddMonths(client.SubscriptionDurationPerMonth).ToString("MMM dd, yyyy"))
                            </td>
                            <td>
                                <a href="/dashboard/clients/@client.Id" class="fp-btn-outline fp-btn-sm">
                                    <i class="fa fa-eye"></i> View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* ── Mobile cards ── *@
        <div class="fp-mobile-cards">
            @foreach (var client in clients.Take(5))
            {
                <div class="fp-mobile-client-card">
                    <div class="fp-mobile-client-card-header">
                        <div class="fp-client-name-cell">
                            <div class="fp-client-avatar">@client.Name[..1].ToUpper()</div>
                            <span style="font-weight:600;font-size:15px;">@client.Name</span>
                        </div>
                        <span class="fp-badge fp-badge-red">@client.SubscriptionDurationPerMonth mo</span>
                    </div>
                    <div class="fp-mobile-client-card-meta">
                        <div class="fp-meta-item">
                            <span class="fp-meta-label">Weight</span>
                            <span class="fp-meta-value">@client.Weight kg</span>
                        </div>
                        <div class="fp-meta-item">
                            <span class="fp-meta-label">Joined</span>
                            <span class="fp-meta-value">@client.CreatedAt.ToString("MMM dd, yyyy")</span>
                        </div>
                        <div class="fp-meta-item">
                            <span class="fp-meta-label">Expires</span>
                            <span class="fp-meta-value">@(client.CreatedAt.AddMonths(client.SubscriptionDurationPerMonth).ToString("MMM dd, yyyy"))</span>
                        </div>
                    </div>
                    <a href="/dashboard/clients/@client.Id" class="fp-btn-outline fp-btn-sm fp-btn-block">
                        <i class="fa fa-eye"></i> View Client
                    </a>
                </div>
            }
        </div>

        @if (clients.Count > 5)
        {
            <div class="fp-view-all-wrap">
                <a href="/dashboard/clients" class="fp-btn-outline">
                    View all @clients.Count clients <i class="fa fa-arrow-right"></i>
                </a>
            </div>
        }
    }
</div>

<style>
    /* ───────────────────────────────────────────
       Stats grid
    ─────────────────────────────────────────── */
    .fp-grid-4 {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
    }

    .fp-stat-unit {
        font-size: 24px;
        color: var(--fp-text-muted);
    }

    /* ───────────────────────────────────────────
       Loading state
    ─────────────────────────────────────────── */
    .fp-loading {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 40px 0;
        color: var(--fp-text-muted);
        font-size: 15px;
    }

    .fp-spinner-lg {
        width: 28px;
        height: 28px;
        border: 3px solid var(--fp-border);
        border-top-color: var(--fp-accent);
        border-radius: 50%;
        animation: fp-spin 0.8s linear infinite;
        flex-shrink: 0;
    }

    @@keyframes fp-spin {
        to { transform: rotate(360deg); }
    }

    /* ───────────────────────────────────────────
       Empty state
    ─────────────────────────────────────────── */
    .fp-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        padding: 60px 0;
        color: var(--fp-text-muted);
    }

    .fp-empty i {
        font-size: 40px;
        opacity: 0.3;
    }

    .fp-empty p {
        font-size: 15px;
        text-align: center;
    }

    .fp-link {
        color: var(--fp-accent);
        text-decoration: none;
    }

    .fp-link:hover {
        text-decoration: underline;
    }

    /* ───────────────────────────────────────────
       Table helpers
    ─────────────────────────────────────────── */
    .fp-unit {
        color: var(--fp-text-muted);
        font-size: 12px;
    }

    .fp-muted-cell {
        color: var(--fp-text-muted);
        font-size: 13px;
    }

    .fp-btn-sm {
        padding: 6px 14px;
        font-size: 12px;
    }

    .fp-client-name-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    /* ───────────────────────────────────────────
       Client avatar
    ─────────────────────────────────────────── */
    .fp-client-avatar {
        width: 34px;
        height: 34px;
        background: rgba(234, 33, 39, 0.15);
        color: var(--fp-accent);
        font-family: 'Teko', sans-serif;
        font-size: 16px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 4px;
    }

    /* ───────────────────────────────────────────
       Desktop table / Mobile cards toggle
    ─────────────────────────────────────────── */
    .fp-table-wrap   { display: block; overflow-x: auto; }
    .fp-mobile-cards { display: none; }

    /* ───────────────────────────────────────────
       Mobile client card
    ─────────────────────────────────────────── */
    .fp-mobile-client-card {
        border: 1px solid var(--fp-border);
        border-radius: 8px;
        padding: 14px;
        margin-bottom: 12px;
    }

    .fp-mobile-client-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 12px;
        gap: 8px;
        flex-wrap: wrap;
    }

    .fp-mobile-client-card-meta {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px 12px;
        margin-bottom: 12px;
    }

    .fp-meta-item {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .fp-meta-label {
        font-size: 11px;
        color: var(--fp-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .fp-meta-value {
        font-size: 13px;
        font-weight: 500;
    }

    /* Full-width button on mobile cards */
    .fp-btn-block {
        display: flex !important;
        justify-content: center;
        width: 100%;
        box-sizing: border-box;
    }

    /* ───────────────────────────────────────────
       View-all link
    ─────────────────────────────────────────── */
    .fp-view-all-wrap {
        margin-top: 20px;
        text-align: center;
    }

    /* ───────────────────────────────────────────
       Breakpoints
    ─────────────────────────────────────────── */

    /* Tablet – 2-column stat grid, keep table */
    @@media (max-width: 900px) {
        .fp-grid-4 {
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
        }
    }

    /* Mobile – switch to card layout */
    @@media (max-width: 640px) {
        .fp-grid-4 {
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }

        .fp-stat-card {
            padding: 14px;
        }

        .fp-stat-card-value {
            font-size: 28px;
        }

        .fp-stat-unit {
            font-size: 16px;
        }

        .fp-stat-card-label {
            font-size: 11px;
        }

        .fp-card {
            padding: 16px;
        }

        .fp-card-title {
            font-size: 16px;
        }

        .fp-card-sub {
            font-size: 13px;
        }

        /* Swap table ↔ cards */
        .fp-table-wrap   { display: none; }
        .fp-mobile-cards { display: block; }
    }

    /* Very small screens – stack meta to 2 columns */
    @@media (max-width: 380px) {
        .fp-mobile-client-card-meta {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>

@code {
    private List<ClientResponseDto> clients = new();
    private bool isLoading = true;
    private string errorMessage = "";
    private int activeClients = 0;
    private int avgSub = 0;
    private int newThisMonth = 0;

    protected override async Task OnInitializedAsync()
    {
        try 
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            if (auth.User.Identity?.IsAuthenticated != true)
            {
                errorMessage = "User is not authenticated.";
                isLoading = false;
                return;
            }

            var user = await UserManager.GetUserAsync(auth.User);
            if (user == null) 
            {
                errorMessage = "Could not load user profile. User may be invalid or session expired.";
                isLoading = false;
                return;
            }

            clients = await ClientService.GetMyClientsAsync(user.Id);
            isLoading = false;

            activeClients = clients.Count(c => c.SubscriptionDurationPerMonth > 0);

            avgSub = clients.Any()
                ? (int)clients.Average(c => c.SubscriptionDurationPerMonth)
                : 0;

            newThisMonth = clients.Count(c =>
                c.CreatedAt.Month == DateTime.UtcNow.Month &&
                c.CreatedAt.Year  == DateTime.UtcNow.Year);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading dashboard: {ex.Message}";
            isLoading = false;
        }
    }
}