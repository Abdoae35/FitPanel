    // --- Workout Templates Direct CRUD ---
    private void OpenAddWorkoutTemplateModal()
    {
        editWorkoutTemplate = new WorkoutTemplate { Name = "New Workout Split Template", SplitName = "Push / Pull / Legs", NumberOfWorkoutDays = 3 };
        editWorkoutTemplateDays.Clear();
        // default 3 days to make editing fast
        for (int i = 0; i < 3; i++)
        {
            AddWorkoutDayToTemplate();
        }
        showWorkoutTemplateModal = true;
    }

    private void OpenEditWorkoutTemplateModal(WorkoutTemplate temp)
    {
        editWorkoutTemplate = new WorkoutTemplate
        {
            Id = temp.Id,
            Name = temp.Name,
            CoachId = temp.CoachId,
            SplitName = temp.SplitName,
            Instructions = temp.Instructions,
            NumberOfWorkoutDays = temp.NumberOfWorkoutDays
        };

        editWorkoutTemplateDays.Clear();
        try
        {
            var days = JsonSerializer.Deserialize<List<WorkoutDayResponseDto>>(temp.WorkoutJson);
            if (days != null)
            {
                foreach (var d in days)
                {
                    var holder = new WorkoutDayResponseDtoHolder
                    {
                        Id = d.Id,
                        DayName = d.DayName,
                        Day = d.Day,
                        IncludeCardio = d.Cardio != null,
                        CardioType = d.Cardio?.CardioType ?? "Treadmill",
                        CardioDuration = d.Cardio?.DurationMinutes ?? 20,
                        CardioIntensity = d.Cardio?.Intensity ?? CardioIntensity.Medium,
                        CardioNotes = d.Cardio?.Notes
                    };
                    foreach (var e in d.Exercises)
                    {
                        holder.Exercises.Add(new ExerciseResponseDtoHolder
                        {
                            Id = e.Id,
                            ExerciseName = e.ExerciseName,
                            Sets = e.Sets,
                            Reps = e.Reps,
                            RestTime = e.RestTime,
                            ExerciseLink = e.ExerciseLink
                        });
                    }
                    editWorkoutTemplateDays.Add(holder);
                }
            }
        }
        catch { }

        showWorkoutTemplateModal = true;
    }

    private void AddWorkoutDayToTemplate()
    {
        var num = editWorkoutTemplateDays.Count + 1;
        var dayEnum = (Days)Math.Min(num - 1, 6);
        editWorkoutTemplateDays.Add(new WorkoutDayResponseDtoHolder
        {
            DayName = $"Day {num}",
            Day = dayEnum,
            Exercises = new List<ExerciseResponseDtoHolder>()
        });
    }

    private void AddExerciseToDay(WorkoutDayResponseDtoHolder day)
    {
        day.Exercises.Add(new ExerciseResponseDtoHolder
        {
            ExerciseName = "",
            Sets = "4",
            Reps = "10-12",
            RestTime = "90s"
        });
    }

    private void OnDictionaryExerciseSelected(ExerciseResponseDtoHolder exHolder, string exIdStr)
    {
        if (int.TryParse(exIdStr, out var id) && id > 0)
        {
            var dex = exercises.FirstOrDefault(x => x.Id == id);
            if (dex != null)
            {
                exHolder.ExerciseName = dex.ExerciseName;
                exHolder.ExerciseLink = dex.ExcerciseLink;
            }
        }
    }

    private async Task SaveWorkoutTemplate()
    {
        if (isSaving) return;
        if (string.IsNullOrWhiteSpace(editWorkoutTemplate.Name)) return;

        isSaving = true;
        try
        {
            editWorkoutTemplate.NumberOfWorkoutDays = editWorkoutTemplateDays.Count;
            editWorkoutTemplate.CoachId = coachId;

            var finalDays = editWorkoutTemplateDays.Select(d => new WorkoutDayResponseDto(
                d.Id,
                d.DayName,
                d.Day,
                d.Exercises.Select(e => new ExerciseResponseDto(
                    e.Id,
                    e.ExerciseName,
                    e.Sets,
                    e.Reps,
                    e.RestTime,
                    e.ExerciseLink
                )).ToList(),
                d.IncludeCardio ? new CardioResponseDto(0, d.CardioType, d.CardioDuration, d.CardioIntensity, d.CardioNotes) : null
            )).ToList();

            editWorkoutTemplate.WorkoutJson = JsonSerializer.Serialize(finalDays);

            if (editWorkoutTemplate.Id == 0)
            {
                await TemplateService.CreateWorkoutTemplateAsync(editWorkoutTemplate);
            }
            else
            {
                await TemplateService.UpdateWorkoutTemplateAsync(editWorkoutTemplate);
            }

            await LoadData();
            showWorkoutTemplateModal = false;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ConfirmDeleteWorkoutTemplate(WorkoutTemplate temp)
    {
        deleteConfirmMessage = $"Are you sure you want to delete the Workout Template '{temp.Name}'?";
        deleteAction = async () =>
        {
            await TemplateService.DeleteWorkoutTemplateAsync(temp.Id, coachId);
            await LoadData();
        };
        showDeleteConfirm = true;
    }

    // --- Deletion Core ---
    private async Task PerformDelete()
    {
        if (deleteAction != null) await deleteAction();
        showDeleteConfirm = false;
    }

    // --- Mutable Wrapper Classes for Blazor Double Binding ---
    public class WorkoutDayResponseDtoHolder
    {
        public int Id { get; set; }
        public string DayName { get; set; } = string.Empty;
        public Days Day { get; set; } = Days.Day1;
        public List<ExerciseResponseDtoHolder> Exercises { get; set; } = new();
        public bool IncludeCardio { get; set; }
        public string CardioType { get; set; } = "Treadmill";
        public int CardioDuration { get; set; } = 20;
        public CardioIntensity CardioIntensity { get; set; } = CardioIntensity.Medium;
        public string? CardioNotes { get; set; }
        public string? Notes { get; set; }
    }

    public class ExerciseResponseDtoHolder
    {
        public int Id { get; set; }
        public string ExerciseName { get; set; } = string.Empty;
        public string Sets { get; set; } = "4";
        public string Reps { get; set; } = "10-12";
        public string RestTime { get; set; } = "90s";
        public string? ExerciseLink { get; set; }
    }
}
