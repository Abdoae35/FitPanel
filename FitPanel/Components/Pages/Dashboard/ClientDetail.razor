@page "/dashboard/clients/{ClientId:int}"
@layout DashboardLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using FitPanel.Data
@using FitPanel.Data.Models
@using FitPanel.Services
@using FitPanel.DTOs.Client
@using FitPanel.DTOs.Diet
@using FitPanel.DTOs.Workout
@attribute [Authorize(Roles = "Coach")]
@inject UserManager<PanelUser> UserManager
@inject IClientService ClientService
@inject IDietService DietService
@inject IWorkoutService WorkoutService
@inject IAlternativeService AlternativeService
@inject IPdfService PdfService
@inject ITemplateService TemplateService
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject ICoachDictionaryService DictionaryService
@rendermode InteractiveServer
<PageTitle>Client Profile — FitPanel</PageTitle>

   <head>
    <link href="/lib/clientDetalis.css" rel="stylesheet" />
    <link href="/lib/fitpanel-accordion-fix.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>


@if (isLoading)
{
    <div class="fp-loading">
        <div class="fp-spinner-lg"></div>
        <span>Loading client...</span>
    </div>
}
else if (client == null)
{
    <div class="fp-empty">
        <i class="fa fa-user-slash"></i>
        <p>Client not found.</p>
        <a href="/dashboard/clients" class="fp-btn-outline">← Back to Clients</a>
    </div>
}
else
{
    <div class="fp-client-page">
    @* ── Header ── *@
    <div class="fp-client-header">
        <div class="fp-client-header-left">
            <a href="/dashboard/clients" class="fp-back-btn"><i class="fa fa-arrow-left"></i></a>
            <div class="fp-client-avatar-xl">@client.Name[..1].ToUpper()</div>
            <div>
                <h1 class="fp-client-title">@client.Name</h1>
                <div class="fp-client-meta-row">
                    <span><i class="fa fa-weight"></i> @client.Weight kg</span>
                    <span><i class="fa fa-fire"></i> @client.Bmr kcal BMR</span>
                    @if (!string.IsNullOrEmpty(client.Goal))
                    {
                        <span><i class="fa fa-bullseye"></i> @client.Goal</span>
                    }
                    <span><i class="fa fa-calendar"></i> @client.SubscriptionDurationPerMonth month subscription</span>
                    <span><i class="fa fa-clock"></i> Joined @client.CreatedAt.ToString("MMM dd, yyyy")</span>
                </div>
            </div>
        </div>
        <button class="fp-btn-outline" @onclick="OpenEditClientModal">
            <i class="fa fa-edit"></i> Edit Client
        </button>
    </div>

    @* ── Links Row ── *@
    @if (!string.IsNullOrEmpty(client.InbodyLink) || !string.IsNullOrEmpty(client.FromPicLink) || !string.IsNullOrEmpty(client.ToPicLink))
    {
        <div class="fp-links-row">
            @if (!string.IsNullOrEmpty(client.InbodyLink))
            {
                <a href="@client.InbodyLink" target="_blank" class="fp-link-btn fp-link-inbody">
                    <i class="fa fa-chart-bar"></i> Inbody Result
                </a>
            }
            @if (!string.IsNullOrEmpty(client.FromPicLink))
            {
                <a href="@client.FromPicLink" target="_blank" class="fp-link-btn fp-link-before">
                    <i class="fa fa-image"></i> Before Photo
                </a>
            }
            @if (!string.IsNullOrEmpty(client.ToPicLink))
            {
                <a href="@client.ToPicLink" target="_blank" class="fp-link-btn fp-link-after">
                    <i class="fa fa-image"></i> After Photo
                </a>
            }
        </div>
    }

    @* ── Subscription Status ── *@
    <div class="fp-sub-status">
        <div class="fp-sub-info">
            <div class="fp-sub-block">
                <span class="fp-sub-label">START DATE</span>
                <span class="fp-sub-value">@client.StartDate.ToString("MMM dd, yyyy")</span>
            </div>
            <div class="fp-sub-divider"></div>
            <div class="fp-sub-block">
                <span class="fp-sub-label">END DATE</span>
                <span class="fp-sub-value @(IsExpired ? "fp-expired" : IsExpiringSoon ? "fp-expiring" : "")">
                    @client.EndDate.ToString("MMM dd, yyyy")
                </span>
            </div>
            <div class="fp-sub-divider"></div>
            <div class="fp-sub-block">
                <span class="fp-sub-label">STATUS</span>
                @if (IsExpired) { <span class="fp-badge fp-badge-danger">EXPIRED</span> }
                else if (IsExpiringSoon) { <span class="fp-badge fp-badge-warning">EXPIRING SOON</span> }
                else { <span class="fp-badge fp-badge-green">ACTIVE</span> }
            </div>
            <div class="fp-sub-divider"></div>
            <div class="fp-sub-block">
                <span class="fp-sub-label">DAYS LEFT</span>
                <span class="fp-sub-value @(IsExpired ? "fp-expired" : "")">
                    @(IsExpired ? "0" : DaysLeft.ToString())
                </span>
            </div>
        </div>
        <div class="fp-sub-actions">
            @if (IsExpired)
            {
                <button class="fp-btn-primary" @onclick='() => showRenewModal = true'>
                    <i class="fa fa-arrows-rotate"></i> Renew
                </button>
            }
            @if (!string.IsNullOrEmpty(client.PhoneNumber) && (IsExpired || IsExpiringSoon))
            {
                <button class="fp-btn-whatsapp" @onclick="SendWhatsAppReminder">
                    <i class="fa-brands fa-whatsapp"></i> WhatsApp Reminder
                </button>
            }
        </div>
    </div>

    @* ── Tabs ── *@
    <div class="fp-tabs">
        <button class="fp-tab @(activeTab == "diet" ? "active" : "")" @onclick='() => activeTab = "diet"'>
            <i class="fa fa-utensils"></i> Diet Plan
        </button>
        <button class="fp-tab @(activeTab == "workout" ? "active" : "")" @onclick='() => activeTab = "workout"'>
            <i class="fa fa-dumbbell"></i> Workout Plan
        </button>
    </div>

    @* ══════════ DIET TAB ══════════ *@
    @if (activeTab == "diet")
    {
        <div class="fp-tab-content">
            <div class="fp-section-header">
                <div>
                    <h2 class="fp-section-title">Diet Plans</h2>
                    <p class="fp-section-sub">@diets.Count plan@(diets.Count != 1 ? "s" : "") created</p>
                </div>
                <button class="fp-btn-primary" @onclick='() => showDietModal = true'>
                    <i class="fa fa-plus"></i> New Diet Plan
                </button>
            </div>

            @if (!diets.Any())
            {
                <div class="fp-empty-card" style="display:flex; flex-direction:column; align-items:center; gap:16px; padding: 40px 20px;">
                    <i class="fa fa-utensils" style="font-size:48px; opacity:0.15; color:var(--fp-accent);"></i>
                    <p style="margin:0; color:var(--fp-text-muted);">No diet plans yet.</p>
                    <div style="display:flex; gap:12px; margin-top:8px;">
                        <button class="fp-btn-primary" @onclick='() => showDietModal = true'>
                            <i class="fa fa-plus"></i> New Diet Plan
                        </button>
                        @if (dietTemplates.Any())
                        {
                            <button class="fp-btn-outline fp-btn-import" @onclick="OpenApplyDietTemplateModal">
                                <i class="fa fa-folder-open"></i> Start from Template
                            </button>
                        }
                    </div>
                </div>
            }
            else
            {
                @for (int i = 0; i < diets.Count; i++)
                {
                    var diet = diets[i];
                    var monthNum = i + 1;
                    var isOpen = expandedDietMonths.Contains(monthNum);
                    var mealsLeft = diet.NumberOfMeals - diet.DietMeals.Count;

                    <div class="fp-month-accordion @(isOpen ? "fp-month-open" : "")">
                        <button class="fp-month-header" @onclick="() => ToggleDietMonth(monthNum)">
                            <div class="fp-month-header-left">
                                <span class="fp-month-number">Month @monthNum</span>
                                <div class="fp-month-pills">
                                    <span class="fp-pill fp-pill-green">
                                        <i class="fa fa-utensils"></i> @diet.NumberOfMeals meals/day
                                    </span>
                                    <span class="fp-pill fp-pill-muted">
                                        @diet.DietMeals.Count / @diet.NumberOfMeals meals added
                                    </span>
                                </div>
                            </div>
                            <i class="fa fa-chevron-@(isOpen ? "up" : "down") fp-month-chevron"></i>
                        </button>

                        @if (isOpen)
                        {
                            <div class="fp-month-body">
                                <div class="fp-plan-card">
                                    <div class="fp-plan-card-header">
                                        <div>
                                            <span class="fp-plan-badge">Diet Plan</span>
                                            <h3>@diet.NumberOfMeals Meals / Day</h3>
                                            <span class="fp-plan-date">Created @diet.CreatedAt.ToString("MMM dd, yyyy")</span>
                                        </div>
                                        <div class="fp-plan-actions">
                                            <button class="fp-icon-btn fp-icon-btn-pdf"
                                                    title="Download Diet PDF"
                                                    disabled="@(generatingPdfDietId == diet.Id)"
                                                    @onclick="() => DownloadDietPdf(diet.Id)">
                                                @if (generatingPdfDietId == diet.Id)
                                                {
                                                    <span class="fp-spinner-sm fp-spinner-green"></span>
                                                    <span>Generating...</span>
                                                }
                                                else
                                                {
                                                    <i class="fa fa-file-pdf"></i>
                                                    <span>PDF</span>
                                                }
                                            </button>
                                            <button class="fp-icon-btn" title="Edit meal count"
                                                    @onclick="() => OpenEditDietModal(diet)">
                                                <i class="fa fa-edit"></i>
                                            </button>
                                            <button class="fp-icon-btn" style="background: rgba(59,130,246,0.1); color: #3b82f6; border-color: rgba(59,130,246,0.2);"
                                                    title="Save as Template"
                                                    @onclick="() => OpenSaveDietTemplateModal(diet.Id)">
                                                <i class="fa fa-save"></i>
                                                <span>Save Template</span>
                                            </button>
                                            <button class="fp-icon-btn" style="background: rgba(168,85,247,0.1); color: #a855f7; border-color: rgba(168,85,247,0.2);"
                                                    title="Edit Coaching Notes"
                                                    @onclick="() => OpenEditDietNotesModal(diet)">
                                                <i class="fa fa-sticky-note"></i>
                                                <span>Notes</span>
                                            </button>
                                            <button class="fp-icon-btn @(mealsLeft <= 0 ? "fp-icon-btn-disabled" : "")"
                                                    disabled="@(mealsLeft <= 0)"
                                                    title="@(mealsLeft <= 0 ? "Meal limit reached" : $"Add Meal ({mealsLeft} left)")"
                                                    @onclick="() => OpenAddDietMealModal(diet.Id)">
                                                <i class="fa fa-plus"></i>
                                                <span>@(mealsLeft <= 0 ? "Full" : $"{mealsLeft} left")</span>
                                            </button>
                                            <button class="fp-icon-btn fp-icon-btn-danger" title="Delete Diet"
                                                    @onclick="() => ConfirmDeleteDiet(diet.Id, diet.NumberOfMeals)">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="fp-progress-row">
                                        <span class="fp-progress-label">@diet.DietMeals.Count / @diet.NumberOfMeals meals added</span>
                                        <div class="fp-progress-bar">
                                            <div class="fp-progress-fill"
                                                 style="width:@(diet.NumberOfMeals > 0 ? (diet.DietMeals.Count * 100 / diet.NumberOfMeals) : 0)%">
                                            </div>
                                        </div>
                                    </div>
                                    @if (diet.DietMeals.Any())
                                    {
                                        @foreach (var dietMeal in diet.DietMeals)
                                        {
                                            <div class="fp-day-card" style="margin-bottom:16px;">
                                                <div class="fp-day-header" style="flex-wrap:wrap;">
                                                    <div class="fp-day-info">
                                                        <span class="fp-day-name">@dietMeal.Name</span>
                                                        <span class="fp-pill fp-pill-muted">@dietMeal.Ingredients.Sum(i => i.Calories) kcal total</span>
                                                    </div>
                                                    <div style="display:flex;gap:8px;align-items:center;">
                                                        <button class="fp-icon-btn fp-icon-btn-danger" title="Delete Meal Category" @onclick="() => ConfirmDeleteDietMeal(diet.Id, dietMeal.Id, dietMeal.Name)"><i class="fa fa-trash"></i></button> <button class="fp-icon-btn" title="Edit Meal Settings"
                                                                @onclick="() => OpenEditDietMealModal(diet.Id, dietMeal)">
                                                            <i class="fa fa-edit"></i> Edit Info
                                                        </button>
                                                        <button class="fp-icon-btn" title="Add Food"
                                                                @onclick="() => OpenAddIngredientModal(diet.Id, dietMeal.Id)">
                                                            <i class="fa fa-plus"></i> Add Food
                                                        </button>
                                                        <button class="fp-icon-btn" title="Add Alternative Meal Option"
                                                                @onclick="() => OpenAlternativeDietMealModal(diet.Id, dietMeal.Id)">
                                                            <i class="fa fa-exchange-alt"></i> Add Meal Alternative
                                                        </button>
                                                    </div>
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(dietMeal.Instruction) || !string.IsNullOrWhiteSpace(dietMeal.Link))
                                                {
                                                    <div class="fp-instruction-box">
                                                        @if (!string.IsNullOrWhiteSpace(dietMeal.Instruction))
                                                        {
                                                            <div class="fp-instruction-label"><i class="fa fa-book-open"></i> Recipe / Instructions</div>
                                                            <p class="fp-instruction-text">@dietMeal.Instruction</p>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(dietMeal.Instruction) && !string.IsNullOrWhiteSpace(dietMeal.Link))
                                                        {
                                                            <div class="fp-instruction-divider"></div>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(dietMeal.Link))
                                                        {
                                                            <div class="fp-instruction-label"><i class="fa fa-video"></i> Video Tutorial</div>
                                                            <a href="@dietMeal.Link" target="_blank" class="fp-meal-link">
                                                                <i class="fa fa-play-circle"></i> Watch Video
                                                            </a>
                                                        }
                                                    </div>
                                                }
                                                
                                                @if (dietMeal.Ingredients.Any())
                                                {
                                                    <div class="fp-meals-grid">
                                                        @foreach (var meal in dietMeal.Ingredients)
                                                        {
                                                            <div class="fp-meal-card">
                                                                <div class="fp-meal-card-header">
                                                                    <div class="fp-meal-name">@meal.Quantity @meal.Unit @meal.MealName</div>
                                                                    <div class="fp-meal-actions">
                                                                        <button class="fp-meal-btn" title="Add Alternative"
                                                                                @onclick="() => OpenAddAlternativeModal(meal.Id, dietMeal.Id, diet.Id)">
                                                                            <i class="fa fa-exchange-alt"></i>
                                                                        </button>
                                                                        <button class="fp-meal-btn" title="Edit"
                                                                                @onclick="() => OpenEditMealModal(diet.Id, dietMeal.Id, meal)">
                                                                            <i class="fa fa-edit"></i>
                                                                        </button>
                                                                        <button class="fp-meal-btn fp-meal-btn-danger" title="Delete"
                                                                                @onclick="() => ConfirmDeleteMeal(meal.Id, meal.MealName, diet.Id, dietMeal.Id)">
                                                                            <i class="fa fa-trash"></i>
                                                                        </button>
                                                                    </div>
                                                                </div>
                                                                <div class="fp-macro-row">
                                                                    <div class="fp-macro">
                                                                        <span class="fp-macro-val">@meal.Protein<small>g</small></span>
                                                                        <span class="fp-macro-label">Protein</span>
                                                                    </div>
                                                                    <div class="fp-macro">
                                                                        <span class="fp-macro-val">@meal.Carbs<small>g</small></span>
                                                                        <span class="fp-macro-label">Carbs</span>
                                                                    </div>
                                                                    <div class="fp-macro">
                                                                        <span class="fp-macro-val">@meal.Fats<small>g</small></span>
                                                                        <span class="fp-macro-label">Fats</span>
                                                                    </div>
                                                                    <div class="fp-macro fp-macro-cal">
                                                                        <span class="fp-macro-val">@meal.Calories<small>kcal</small></span>
                                                                        <span class="fp-macro-label">Calories</span>
                                                                    </div>
                                                                </div>
                                                                @if (meal.Alternatives.Any())
                                                                {
                                                                    <div class="fp-alt-section">
                                                                        <div class="fp-alt-header">
                                                                            <i class="fa fa-exchange-alt"></i>
                                                                            <span>@meal.Alternatives.Count Alternative@(meal.Alternatives.Count != 1 ? "s" : "")</span>
                                                                        </div>
                                                                        @foreach (var alt in meal.Alternatives)
                                                                        {
                                                                            <div class="fp-alt-card">
                                                                                <div class="fp-alt-card-header">
                                                                                    <span class="fp-alt-name">@alt.MealName</span>
                                                                                    <div class="fp-meal-actions">
                                                                                        <button class="fp-meal-btn" title="Edit Alternative"
                                                                                                @onclick="() => OpenEditAlternativeModal(meal.Id, dietMeal.Id, diet.Id, alt)">
                                                                                            <i class="fa fa-edit"></i>
                                                                                        </button>
                                                                                        <button class="fp-meal-btn fp-meal-btn-danger" title="Delete Alternative"
                                                                                                @onclick="() => ConfirmDeleteAlternative(alt.Id, alt.MealName, meal.Id, dietMeal.Id, diet.Id)">
                                                                                            <i class="fa fa-trash"></i>
                                                                                        </button>
                                                                                    </div>
                                                                                </div>
                                                                                @if (!string.IsNullOrEmpty(alt.Description))
                                                                                {
                                                                                    <div class="fp-alt-desc">@alt.Description</div>
                                                                                }
                                                                                <div class="fp-alt-macros">
                                                                                    <span class="fp-alt-macro"><strong>@alt.Protein</strong>g P</span>
                                                                                    <span class="fp-alt-macro"><strong>@alt.Carbs</strong>g C</span>
                                                                                    <span class="fp-alt-macro"><strong>@alt.Fats</strong>g F</span>
                                                                                    <span class="fp-alt-macro fp-alt-cal"><strong>@alt.Calories</strong> kcal</span>
                                                                                </div>
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <button class="fp-add-alt-btn"
                                                                            @onclick="() => OpenAddAlternativeModal(meal.Id, dietMeal.Id, diet.Id)">
                                                                        <i class="fa fa-exchange-alt"></i> Add Alternative
                                                                    </button>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                            
                                            @* Render Alternative Meals *@
                                            @if (dietMeal.AlternativeMeals != null && dietMeal.AlternativeMeals.Any())
                                            {
                                                <div style="margin-left: 24px; border-left: 2px dashed rgba(255,255,255,0.1); padding-left: 16px;">
                                                    @foreach (var altDietMeal in dietMeal.AlternativeMeals)
                                                    {
                                                        <div class="fp-day-card" style="margin-bottom:16px; background: rgba(255,255,255,0.02);">
                                                            <div class="fp-day-header" style="flex-wrap:wrap;">
                                                                <div class="fp-day-info">
                                                                    <span class="fp-day-name" style="color:var(--fp-primary);"><i class="fa fa-exchange-alt"></i> Option 2: @altDietMeal.Name</span>
                                                                    <span class="fp-pill fp-pill-muted">@altDietMeal.Ingredients.Sum(i => i.Calories) kcal total</span>
                                                                </div>
                                                                <div style="display:flex;gap:8px;align-items:center;">
                                                                    <button class="fp-icon-btn fp-icon-btn-danger" title="Delete Alternative Meal Option" @onclick="() => ConfirmDeleteDietMeal(diet.Id, altDietMeal.Id, altDietMeal.Name)"><i class="fa fa-trash"></i></button> <button class="fp-icon-btn" title="Edit Meal Settings"
                                                                            @onclick="() => OpenEditDietMealModal(diet.Id, altDietMeal)">
                                                                        <i class="fa fa-edit"></i> Edit Info
                                                                    </button>
                                                                    <button class="fp-icon-btn" title="Add Food"
                                                                            @onclick="() => OpenAddIngredientModal(diet.Id, altDietMeal.Id)">
                                                                        <i class="fa fa-plus"></i> Add Food
                                                                    </button>
                                                                </div>
                                                            </div>
                                                            @if (!string.IsNullOrWhiteSpace(altDietMeal.Instruction) || !string.IsNullOrWhiteSpace(altDietMeal.Link))
                                                            {
                                                                <div class="fp-instruction-box">
                                                                    @if (!string.IsNullOrWhiteSpace(altDietMeal.Instruction))
                                                                    {
                                                                        <div class="fp-instruction-label"><i class="fa fa-book-open"></i> Recipe / Instructions</div>
                                                                        <p class="fp-instruction-text">@altDietMeal.Instruction</p>
                                                                    }
                                                                    @if (!string.IsNullOrWhiteSpace(altDietMeal.Instruction) && !string.IsNullOrWhiteSpace(altDietMeal.Link))
                                                                    {
                                                                        <div class="fp-instruction-divider"></div>
                                                                    }
                                                                    @if (!string.IsNullOrWhiteSpace(altDietMeal.Link))
                                                                    {
                                                                        <div class="fp-instruction-label"><i class="fa fa-video"></i> Video Tutorial</div>
                                                                        <a href="@altDietMeal.Link" target="_blank" class="fp-meal-link">
                                                                            <i class="fa fa-play-circle"></i> Watch Video
                                                                        </a>
                                                                    }
                                                                </div>
                                                            }
                                                            
                                                            @if (altDietMeal.Ingredients.Any())
                                                            {
                                                                <div class="fp-meals-grid">
                                                                    @foreach (var meal in altDietMeal.Ingredients)
                                                                    {
                                                                        <div class="fp-meal-card">
                                                                            <div class="fp-meal-card-header">
                                                                                <div class="fp-meal-name">@meal.Quantity @meal.Unit @meal.MealName</div>
                                                                                <div class="fp-meal-actions">
                                                                                    <button class="fp-meal-btn" title="Edit"
                                                                                            @onclick="() => OpenEditMealModal(diet.Id, altDietMeal.Id, meal)">
                                                                                        <i class="fa fa-edit"></i>
                                                                                    </button>
                                                                                    <button class="fp-meal-btn fp-meal-btn-danger" title="Delete"
                                                                                            @onclick="() => ConfirmDeleteMeal(meal.Id, meal.MealName, diet.Id, altDietMeal.Id)">
                                                                                        <i class="fa fa-trash"></i>
                                                                                    </button>
                                                                                </div>
                                                                            </div>
                                                                            <div class="fp-macro-row">
                                                                                <div class="fp-macro">
                                                                                    <span class="fp-macro-val">@meal.Protein<small>g</small></span>
                                                                                    <span class="fp-macro-label">Protein</span>
                                                                                </div>
                                                                                <div class="fp-macro">
                                                                                    <span class="fp-macro-val">@meal.Carbs<small>g</small></span>
                                                                                    <span class="fp-macro-label">Carbs</span>
                                                                                </div>
                                                                                <div class="fp-macro">
                                                                                    <span class="fp-macro-val">@meal.Fats<small>g</small></span>
                                                                                    <span class="fp-macro-label">Fats</span>
                                                                                </div>
                                                                                <div class="fp-macro fp-macro-cal">
                                                                                    <span class="fp-macro-val">@meal.Calories<small>kcal</small></span>
                                                                                    <span class="fp-macro-label">Calories</span>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <p style="color:var(--fp-text-muted);font-size:15px;padding:16px 0;">
                                            No meals yet. You can add up to @diet.NumberOfMeals meals.
                                        </p>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    }

    @* ══════════ WORKOUT TAB ══════════ *@
    @if (activeTab == "workout")
    {
        <div class="fp-tab-content">
            <div class="fp-section-header">
                <div>
                    <h2 class="fp-section-title">Workout Plans</h2>
                    <p class="fp-section-sub">@workouts.Count plan@(workouts.Count != 1 ? "s" : "") created</p>
                </div>
                <button class="fp-btn-primary" @onclick='() => showWorkoutModal = true'>
                    <i class="fa fa-plus"></i> New Workout Plan
                </button>
            </div>

            @if (!workouts.Any())
            {
                <div class="fp-empty-card" style="display:flex; flex-direction:column; align-items:center; gap:16px; padding: 40px 20px;">
                    <i class="fa fa-dumbbell" style="font-size:48px; opacity:0.15; color:var(--fp-accent);"></i>
                    <p style="margin:0; color:var(--fp-text-muted);">No workout plans yet.</p>
                    <div style="display:flex; gap:12px; margin-top:8px;">
                        <button class="fp-btn-primary" @onclick='() => showWorkoutModal = true'>
                            <i class="fa fa-plus"></i> New Workout Plan
                        </button>
                        @if (workoutTemplates.Any())
                        {
                            <button class="fp-btn-outline fp-btn-import" @onclick="OpenApplyWorkoutTemplateModal">
                                <i class="fa fa-folder-open"></i> Start from Template
                            </button>
                        }
                    </div>
                </div>
            }
            else
            {
                @for (int i = 0; i < workouts.Count; i++)
                {
                    var workout = workouts[i];
                    var monthNum = i + 1;
                    var isOpen = expandedWorkoutMonths.Contains(monthNum);
                    var daysLeft = workout.NumberOfWorkoutDays - workout.WorkoutDays.Count;

                    <div class="fp-month-accordion @(isOpen ? "fp-month-open" : "")">
                        <button class="fp-month-header" @onclick="() => ToggleWorkoutMonth(monthNum)">
                            <div class="fp-month-header-left">
                                <span class="fp-month-number">Month @monthNum</span>
                                <div class="fp-month-pills">
                                    <span class="fp-pill fp-pill-blue">
                                        <i class="fa fa-dumbbell"></i> @workout.SplitName
                                    </span>
                                    <span class="fp-pill fp-pill-muted">
                                        @workout.WorkoutDays.Count / @workout.NumberOfWorkoutDays days
                                    </span>
                                </div>
                            </div>
                            <i class="fa fa-chevron-@(isOpen ? "up" : "down") fp-month-chevron"></i>
                        </button>

                        @if (isOpen)
                        {
                            <div class="fp-month-body">
                                <div class="fp-plan-card">
                                    <div class="fp-plan-card-header">
                                        <div>
                                            <span class="fp-plan-badge fp-plan-badge-blue">Workout Plan</span>
                                            <h3>@workout.SplitName</h3>
                                            <span class="fp-plan-date">@workout.NumberOfWorkoutDays days · @workout.CreatedAt.ToString("MMM dd, yyyy")</span>
                                        </div>
                                        <div class="fp-plan-actions">
                                            <button class="fp-icon-btn fp-icon-btn-pdf fp-icon-btn-pdf-blue"
                                                    title="Download Workout PDF"
                                                    disabled="@(generatingPdfWorkoutId == workout.Id)"
                                                    @onclick="() => DownloadWorkoutPdf(workout.Id)">
                                                @if (generatingPdfWorkoutId == workout.Id)
                                                {
                                                    <span class="fp-spinner-sm fp-spinner-blue"></span>
                                                    <span>Generating...</span>
                                                }
                                                else
                                                {
                                                    <i class="fa fa-file-pdf"></i>
                                                    <span>PDF</span>
                                                }
                                            </button>
                                            <button class="fp-icon-btn" title="Edit day count"
                                                    @onclick="() => OpenEditWorkoutModal(workout)">
                                                <i class="fa fa-edit"></i>
                                            </button>
                                            <button class="fp-icon-btn" style="background: rgba(59,130,246,0.1); color: #3b82f6; border-color: rgba(59,130,246,0.2);"
                                                    title="Save as Template"
                                                    @onclick="() => OpenSaveWorkoutTemplateModal(workout.Id)">
                                                <i class="fa fa-save"></i>
                                                <span>Save Template</span>
                                            </button>
                                            <button class="fp-icon-btn @(daysLeft <= 0 ? "fp-icon-btn-disabled" : "")"
                                                    disabled="@(daysLeft <= 0)"
                                                    title="@(daysLeft <= 0 ? "Day limit reached" : $"Add Day ({daysLeft} left)")"
                                                    @onclick="() => OpenAddDayModal(workout.Id)">
                                                <i class="fa fa-plus"></i>
                                                <span>@(daysLeft <= 0 ? "Full" : $"{daysLeft} left")</span>
                                            </button>
                                            <button class="fp-icon-btn fp-icon-btn-danger" title="Delete Workout"
                                                    @onclick="() => ConfirmDeleteWorkout(workout.Id, workout.SplitName)">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="fp-progress-row">
                                        <span class="fp-progress-label">@workout.WorkoutDays.Count / @workout.NumberOfWorkoutDays days added</span>
                                        <div class="fp-progress-bar">
                                            <div class="fp-progress-fill"
                                                 style="width:@(workout.NumberOfWorkoutDays > 0 ? (workout.WorkoutDays.Count * 100 / workout.NumberOfWorkoutDays) : 0)%">
                                            </div>
                                        </div>
                                    </div>
                                    @if (workout.WorkoutDays.Any())
                                    {
                                        <div class="fp-days-list">
                                            @foreach (var day in workout.WorkoutDays)
                                            {
                                                <div class="fp-day-card">
                                                    <div class="fp-day-header">
                                                        <div class="fp-day-info">
                                                            <span class="fp-day-badge">@day.Day.ToString()</span>
                                                            <span class="fp-day-name">@day.DayName</span>
                                                        </div>
                                                        <div style="display:flex; gap:8px; align-items:center;">
                                                            <button class="fp-icon-btn" title="Add Exercise"
                                                                    @onclick="() => OpenAddExerciseModal(workout.Id, day.Id)">
                                                                <i class="fa fa-plus"></i> <span>Exercise</span>
                                                            </button>
                                                            <button class="fp-icon-btn" title="Edit Day Name"
                                                                    @onclick="() => OpenEditDayModal(workout.Id, day)">
                                                                <i class="fa fa-edit"></i> <span>Edit Name</span>
                                                            </button>
                                                            <button class="fp-icon-btn fp-icon-btn-danger" title="Delete Day"
                                                                    @onclick="() => ConfirmDeleteDay(workout.Id, day)">
                                                                <i class="fa fa-trash"></i> <span>Delete Day</span>
                                                            </button>
                                                        </div>
                                                    </div>
                                                    @* Warm Up Set UI *@
                                                    <div style="margin: 12px; display: flex; align-items: center; justify-content: flex-start; gap: 8px;">
                                                        @if (!string.IsNullOrEmpty(day.WarmUpName))
                                                        {
                                                            <span style="font-weight: 600; display: inline-flex; align-items: center; gap: 6px; color: var(--fp-text);">
                                                                 Warm Up Set: 
                                                                @if (!string.IsNullOrEmpty(day.WarmUpLink))
                                                                {
                                                                    <a href="@day.WarmUpLink" target="_blank" class="fp-exercise-link">
                                                                        @day.WarmUpName <i class="fa fa-external-link-alt" style="font-size: 11px;"></i>
                                                                    </a>
                                                                }
                                                                else
                                                                {
                                                                    <span style="color: var(--fp-text-muted);">@day.WarmUpName</span>
                                                                }
                                                            </span>
                                                            <div style="display: inline-flex; gap: 4px;">
                                                                <button class="fp-meal-btn" style="padding: 2px 6px; font-size: 12px; margin: 0;" title="Edit Warm Up"
                                                                        @onclick="() => OpenEditWarmUpModal(workout.Id, day)">
                                                                    <i class="fa fa-edit"></i>
                                                                </button>
                                                                <button class="fp-meal-btn fp-meal-btn-danger" style="padding: 2px 6px; font-size: 12px; margin: 0;" title="Remove Warm Up"
                                                                        @onclick="() => RemoveWarmUp(workout.Id, day.Id)">
                                                                    <i class="fa fa-trash"></i>
                                                                </button>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <button class="fp-add-cardio-btn" style="border-color: rgba(249,115,22,0.3); color: #f97316; margin: 0; padding: 4px 10px; display: inline-flex; font-size: 12px; border-radius: 6px;"
                                                                    @onclick="() => OpenEditWarmUpModal(workout.Id, day)">
                                                                <i class="fa fa-plus"></i> Add Warm Up Set
                                                            </button>
                                                        }
                                                    </div>
                                                    @if (day.Exercises.Any())
                                                    {
                                                        <table class="fp-table fp-exercise-table">
                                                            <thead>
                                                                <tr>
                                                                    <th>Exercise</th>
                                                                    <th>Sets</th>
                                                                    <th>Reps</th>
                                                                    <th>Rest</th>
                                                                    <th></th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var ex in day.Exercises)
                                                                {
                                                                    <tr>
                                                                        <td>
                                                                            @if (!string.IsNullOrEmpty(ex.ExerciseLink))
                                                                            {
                                                                                <a href="@ex.ExerciseLink" target="_blank" class="fp-exercise-link">
                                                                                    @ex.ExerciseName <i class="fa fa-external-link-alt"></i>
                                                                                </a>
                                                                            }
                                                                            else { @ex.ExerciseName }
                                                                        </td>
                                                                        <td><span class="fp-badge fp-badge-red">@ex.Sets</span></td>
                                                                        <td>@ex.Reps</td>
                                                                        <td style="color:var(--fp-text-muted)">@ex.RestTime</td>
                                                                        <td>
                                                                            <div style="display:flex;gap:6px;">
                                                                                <button class="fp-meal-btn" title="Edit"
                                                                                        @onclick="() => OpenEditExerciseModal(workout.Id, day.Id, ex)">
                                                                                    <i class="fa fa-edit"></i>
                                                                                </button>
                                                                                <button class="fp-meal-btn fp-meal-btn-danger" title="Delete"
                                                                                        @onclick="() => ConfirmDeleteExercise(ex.Id, ex.ExerciseName, workout.Id, day.Id)">
                                                                                    <i class="fa fa-trash"></i>
                                                                                </button>
                                                                            </div>
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    }

                                                    @* Workout Day Notes UI Display & Actions *@
                                                    @if (!string.IsNullOrWhiteSpace(day.Notes))
                                                    {
                                                        <div class="fp-cardio-badge" style="background: rgba(168,85,247,0.06); border: 1px solid rgba(168,85,247,0.15); color: #a855f7; display: flex; flex-direction: column; align-items: flex-start; gap: 8px; padding: 12px; margin-bottom: 8px; border-radius: 4px; box-sizing: border-box; width: 100%;">
                                                            <div style="display:flex; width:100%; align-items:center;">
                                                                <span style="font-weight:700; display:flex; align-items:center; gap:6px;">
                                                                    <i class="fa fa-sticky-note"></i> Day Notes
                                                                </span>
                                                                <div style="margin-left:auto; display:flex; gap:6px;">
                                                                    <button class="fp-meal-btn" style="background: rgba(168,85,247,0.15); color: #a855f7; border-color: rgba(168,85,247,0.2);" title="Edit Day Notes"
                                                                            @onclick="() => OpenEditWorkoutDayNotesModal(workout.Id, day)">
                                                                        <i class="fa fa-edit"></i>
                                                                    </button>
                                                                    <button class="fp-meal-btn fp-meal-btn-danger" title="Delete Day Notes"
                                                                            @onclick="() => ConfirmDeleteWorkoutDayNotes(workout.Id, day.Id)">
                                                                        <i class="fa fa-trash"></i>
                                                                    </button>
                                                                </div>
                                                            </div>
                                                            <div style="color: var(--fp-text-muted); font-size: 16px; white-space: pre-wrap; width: 100%; text-align: left;">@day.Notes</div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <button class="fp-add-cardio-btn" style="border-color: rgba(168,85,247,0.3); color: #a855f7; margin-bottom: 8px; margin-right: 6px; display: inline-flex;"
                                                                @onclick="() => OpenEditWorkoutDayNotesModal(workout.Id, day)">
                                                            <i class="fa fa-plus"></i> Add Day Notes
                                                        </button>
                                                    }

                                                    @if (day.Cardio != null)
                                                    {
                                                        <div class="fp-cardio-badge">
                                                            <i class="fa fa-running"></i>
                                                            <span>@day.Cardio.CardioType · @day.Cardio.DurationMinutes min · @day.Cardio.Intensity</span>
                                                            @if (!string.IsNullOrEmpty(day.Cardio.Notes))
                                                            {
                                                                <span style="color:var(--fp-text-muted)"> — @day.Cardio.Notes</span>
                                                            }
                                                            <div style="margin-left:auto;display:flex;gap:6px;flex-shrink:0;">
                                                                <button class="fp-meal-btn" title="Edit Cardio"
                                                                        @onclick="() => OpenEditCardioModal(workout.Id, day.Id, day.Cardio)">
                                                                    <i class="fa fa-edit"></i>
                                                                </button>
                                                                <button class="fp-meal-btn fp-meal-btn-danger" title="Delete Cardio"
                                                                        @onclick="() => ConfirmDeleteCardio(workout.Id, day.Id, day.Cardio.CardioType)">
                                                                    <i class="fa fa-trash"></i>
                                                                </button>
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <button class="fp-add-cardio-btn"
                                                                @onclick="() => OpenAddCardioModal(workout.Id, day.Id)">
                                                            <i class="fa fa-plus"></i> Add Cardio
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <p style="color:var(--fp-text-muted);font-size:14px;padding:16px 0;">
                                            No days yet. You can add up to @workout.NumberOfWorkoutDays days.
                                        </p>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    }
    </div>
}

@* ══════════════════════════════ MODALS ══════════════════════════════ *@

@* Edit Client *@
@if (showEditClientModal)
{
    <div class="fp-modal-overlay" @onclick='() => showEditClientModal = false'>
        <div class="fp-modal" @onclick:stopPropagation="true">
            <div class="fp-modal-header">
                <span class="fp-modal-title"><i class="fa fa-edit"></i> EDIT CLIENT</span>
                <button class="fp-modal-close" @onclick='() => showEditClientModal = false'><i class="fa fa-times"></i></button>
            </div>
            @if (!string.IsNullOrEmpty(editClientMessage))
            {
                <div class="fp-alert @(editClientSuccess ? "fp-alert-success" : "fp-alert-danger")" style="margin:16px 24px 0;">
                    @editClientMessage
                </div>
            }
            <div class="fp-modal-body">
                <div class="fp-grid-2">
                    <div class="fp-input-group"><label>Full Name</label><input @bind="editClient.Name" placeholder="Full name" /></div>
                    <div class="fp-input-group"><label>Phone Number</label><input @bind="editClient.PhoneNumber" placeholder="e.g. +966500000000" /></div>
                </div>
                <div class="fp-grid-2">
                    <div class="fp-input-group"><label>Weight (kg)</label><input type="number" @bind="editClient.Weight" placeholder="80" /></div>
                    <div class="fp-input-group"><label>BMR (kcal)</label><input type="number" @bind="editClient.Bmr" placeholder="1800" /></div>
                </div>
                <div class="fp-input-group"><label>Inbody Link</label><input @bind="editClient.InbodyLink" placeholder="https://drive.google.com/..." /></div>
                <div class="fp-grid-2">
                    <div class="fp-input-group"><label>Before Photo Link</label><input @bind="editClient.FromPicLink" placeholder="https://drive.google.com/..." /></div>
                    <div class="fp-input-group"><label>After Photo Link</label><input @bind="editClient.ToPicLink" placeholder="https://drive.google.com/..." /></div>
                </div>
                <div class="fp-input-group"><label>Client Fitness Goal</label><input @bind="editClient.Goal" placeholder="Loss Weight / Gain Muscle / Recomposition" /></div>
            </div>
            <div class="fp-modal-footer">
                <button class="fp-btn-outline" @onclick='() => showEditClientModal = false'>Cancel</button>
                <button class="fp-btn-primary" @onclick="SaveClient" disabled="@isSavingClient">
                    @if (isSavingClient) { <span class="fp-spinner-sm"></span><span>Saving...</span> }
                    else { <i class="fa fa-check"></i><span>Save Changes</span> }
                </button>
            </div>
        </div>
    </div>
}

@* New Diet *@
@if (showDietModal)
{
    <div class="fp-modal-overlay" @onclick='() => showDietModal = false'>
        <div class="fp-modal fp-modal-sm" @onclick:stopPropagation="true">
            <div class="fp-modal-header">
                <span class="fp-modal-title"><i class="fa fa-utensils"></i> NEW DIET PLAN</span>
                <button class="fp-modal-close" @onclick='() => showDietModal = false'><i class="fa fa-times"></i></button>
            </div>
            <div class="fp-modal-body">
                <div class="fp-input-group">
                    <label>Number of Meals per Day *</label>
                    <input type="number" @bind="newDiet.NumberOfMeals" min="1" max="10" placeholder="5" />
                </div>
                <div class="fp-input-group">
                    <label>Coaching Notes / Instructions (optional — will appear as a dedicated page in the PDF)</label>
                    <textarea @bind="newDiet.Instructions" rows="4" placeholder="e.g. Drink 3L of water daily. Take your vitamins with breakfast. Avoid processed sugars..."></textarea>
                </div>
                <p class="fp-hint"><i class="fa fa-info-circle"></i> You won't be able to add more meals than this number.</p>
            </div>
            <div class="fp-modal-footer">
                <button class="fp-btn-outline" @onclick='() => showDietModal = false'>Cancel</button>
                <button class="fp-btn-primary" @onclick="CreateDiet"><i class="fa fa-check"></i> Create</button>
            </div>
        </div>
    </div>
}

@* Edit Diet Notes Modal *@
@if (showEditDietNotesModal)
{
    <div class="fp-modal-overlay" @onclick='() => showEditDietNotesModal = false'>
        <div class="fp-modal fp-modal-sm" @onclick:stopPropagation="true">
            <div class="fp-modal-header">
                <span class="fp-modal-title"><i class="fa fa-sticky-note"></i> COACHING NOTES</span>
                <button class="fp-modal-close" @onclick='() => showEditDietNotesModal = false'><i class="fa fa-times"></i></button>
            </div>
            <div class="fp-modal-body">
                <div class="fp-input-group">
                    <label>Diet Notes &amp; Instructions</label>
                    <textarea @bind="editDietInstructions" rows="8"
                              placeholder="e.g. Drink at least 3 liters of water daily.&#10;Take your multivitamin with breakfast.&#10;Avoid processed sugar and soft drinks.&#10;Do not skip meals — spacing matters."></textarea>
                </div>
                <p class="fp-hint"><i class="fa fa-info-circle"></i> These notes will appear as a dedicated page in the PDF after the cover page.</p>
            </div>
            <div class="fp-modal-footer">
                <button class="fp-btn-outline" @onclick='() => showEditDietNotesModal = false'>Cancel</button>
                <button class="fp-btn-primary" @onclick="SaveDietNotes"><i class="fa fa-check"></i> Save Notes</button>
            </div>
        </div>
    </div>
}

@* Save Diet Template Modal *@
@if (showSaveDietTemplateModal)
{
    <div class="fp-modal-overlay" @onclick='() => showSaveDietTemplateModal = false'>
        <div class="fp-modal fp-modal-sm" @onclick:stopPropagation="true">
            <div class="fp-modal-header">
                <span class="fp-modal-title"><i class="fa fa-save"></i> SAVE DIET TEMPLATE</span>
                <button class="fp-modal-close" @onclick='() => showSaveDietTemplateModal = false'><i class="fa fa-times"></i></button>
            </div>
            <div class="fp-modal-body">
                <div class="fp-input-group">
                    <label>Template Name *</label>
                    <input @bind="dietTemplateName" placeholder="e.g. 2000kcal High Protein Fat Loss" />
                </div>
            </div>
            <div class="fp-modal-footer">
                <button class="fp-btn-outline" @onclick='() => showSaveDietTemplateModal = false'>Cancel</button>
                <button class="fp-btn-primary" @onclick="SaveDietAsTemplate"><i class="fa fa-check"></i> Save Template</button>
            </div>
        </div>
    </div>
}

@* Save Workout Template Modal *@
@if (showSaveWorkoutTemplateModal)
{
    <div class="fp-modal-overlay" @onclick='() => showSaveWorkoutTemplateModal = false'>
        <div class="fp-modal fp-modal-sm" @onclick:stopPropagation="true">
            <div class="fp-modal-header">
                <span class="fp-modal-title"><i class="fa fa-save"></i> SAVE WORKOUT TEMPLATE</span>
                <button class="fp-modal-close" @onclick='() => showSaveWorkoutTemplateModal = false'><i class="fa fa-times"></i></button>
            </div>
            <div class="fp-modal-body">
                <div class="fp-input-group">
                    <label>Template Name *</label>
                    <input @bind="workoutTemplateName" placeholder="e.g. 4-Day Push/Pull/Legs Split" />
                </div>
            </div>
            <div class="fp-modal-footer">
                <button class="fp-btn-outline" @onclick='() => showSaveWorkoutTemplateModal = false'>Cancel</button>
                <button class="fp-btn-primary" @onclick="SaveWorkoutAsTemplate"><i class="fa fa-check"></i> Save Template</button>
            </div>
        </div>
    </div>
}

@* Apply Diet Template Modal *@
@if (showApplyDietTemplateModal)
{
    <div class="fp-modal-overlay" @onclick='() => showApplyDietTemplateModal = false'>
        <div class="fp-modal fp-modal-sm" @onclick:stopPropagation="true">
            <div class="fp-modal-header">
                <span class="fp-modal-title"><i class="fa fa-folder-open"></i> START FROM DIET TEMPLATE</span>
                <button class="fp-modal-close" @onclick='() => showApplyDietTemplateModal = false'><i class="fa fa-times"></i></button>
            </div>
            <div class="fp-modal-body">
                <div class="fp-input-group">
                    <label>Select Diet Template *</label>
                    <select @bind="selectedDietTemplateId">
                        <option value="0">-- Choose Template --</option>
                        @foreach (var temp in dietTemplates)
                        {
                            <option value="@temp.Id">@temp.Name (@temp.NumberOfMeals meals)</option>
                        }
                    </select>
                </div>
            </div>
            <div class="fp-modal-footer">
                <button class="fp-btn-outline" @onclick='() => showApplyDietTemplateModal = false'>Cancel</button>
                <button class="fp-btn-primary" @onclick="ApplyDietTemplate" disabled="@(selectedDietTemplateId == 0)"><i class="fa fa-copy"></i> Clone Plan</button>
            </div>
        </div>
    </div>
}

@* Apply Workout Template Modal *@
@if (showApplyWorkoutTemplateModal)
{
    <div class="fp-modal-overlay" @onclick='() => showApplyWorkoutTemplateModal = false'>
        <div class="fp-modal fp-modal-sm" @onclick:stopPropagation="true">
            <div class="fp-modal-header">
                <span class="fp-modal-title"><i class="fa fa-folder-open"></i> START FROM WORKOUT TEMPLATE</span>
                <button class="fp-modal-close" @onclick='() => showApplyWorkoutTemplateModal = false'><i class="fa fa-times"></i></button>
            </div>
            <div class="fp-modal-body">
                <div class="fp-input-group">
                    <label>Select Workout Template *</label>
                    <select @bind="selectedWorkoutTemplateId">
                        <option value="0">-- Choose Template --</option>
                        @foreach (var temp in workoutTemplates)
                        {
                            <option value="@temp.Id">@temp.Name (@temp.SplitName)</option>
                        }
                    </select>
                </div>
            </div>
            <div class="fp-modal-footer">
                <button class="fp-btn-outline" @onclick='() => showApplyWorkoutTemplateModal = false'>Cancel</button>
                <button class="fp-btn-primary" @onclick="ApplyWorkoutTemplate" disabled="@(selectedWorkoutTemplateId == 0)"><i class="fa fa-copy"></i> Clone Plan</button>
            </div>
