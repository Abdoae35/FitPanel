@page "/dashboard"
@namespace FitPanel.Components.Pages.Dashboard
@layout DashboardLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using FitPanel.Components.Layout
@using FitPanel.Data
@using FitPanel.Services
@using FitPanel.DTOs.Client
@attribute [Authorize]
@inject UserManager<PanelUser> UserManager
@inject IClientService ClientService
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Dashboard — FitPanel</PageTitle>

@* ── Stats Row ── *@
<div class="fp-grid-4" style="margin-bottom: 28px;">
    <div class="fp-stat-card">
        <span class="fp-stat-card-label">Total Clients</span>
        <span class="fp-stat-card-value">@clients.Count</span>
    </div>
    <div class="fp-stat-card">
        <span class="fp-stat-card-label">Active This Month</span>
        <span class="fp-stat-card-value">@activeClients</span>
    </div>
    <div class="fp-stat-card">
        <span class="fp-stat-card-label">Avg. Subscription</span>
        <span class="fp-stat-card-value">@avgSub<span style="font-size:24px;color:var(--fp-text-muted)">mo</span></span>
    </div>
    <div class="fp-stat-card">
        <span class="fp-stat-card-label">New This Month</span>
        <span class="fp-stat-card-value">@newThisMonth</span>
    </div>
</div>

@* ── Recent Clients ── *@
<div class="fp-card">
    <div class="fp-card-title">
        <i class="fa fa-users" style="color:var(--fp-accent);font-size:22px;"></i>
        Recent Clients
    </div>
    <p class="fp-card-sub">Your most recently added clients</p>

    @if (isLoading)
    {
        <div class="fp-loading">
            <div class="fp-spinner-lg"></div>
            <span>Loading clients...</span>
        </div>
    }
    else if (!clients.Any())
    {
        <div class="fp-empty">
            <i class="fa fa-user-plus"></i>
            <p>No clients yet. <a href="/dashboard/clients" class="fp-link">Add your first client →</a></p>
        </div>
    }
    else
    {
        @* Desktop table — hidden on mobile *@
        <div class="fp-table-wrap">
            <table class="fp-table">
                <thead>
                    <tr>
                        <th>Client</th>
                        <th>Weight</th>
                        <th>Subscription</th>
                        <th>Joined</th>
                        <th>Expiration Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var client in clients.Take(5))
                    {
                        <tr>
                            <td>
                                <div style="display:flex;align-items:center;gap:12px;">
                                    <div class="fp-client-avatar">@client.Name[..1].ToUpper()</div>
                                    <span style="font-weight:600;">@client.Name</span>
                                </div>
                            </td>
                            <td>@client.Weight <span style="color:var(--fp-text-muted);font-size:12px;">kg</span></td>
                            <td>
                                <span class="fp-badge fp-badge-red">@client.SubscriptionDurationPerMonth mo</span>
                            </td>
                            <td style="color:var(--fp-text-muted);font-size:13px;">
                                @client.CreatedAt.ToString("MMM dd, yyyy")
                            </td>
                            <td style="color:var(--fp-text-muted);font-size:13px;">
                                @(client.CreatedAt.AddMonths(client.SubscriptionDurationPerMonth).ToString("MMM dd, yyyy"))
                            </td>
                            <td>
                                <a href="/dashboard/clients/@client.Id" class="fp-btn-outline" style="padding:6px 14px;font-size:12px;">
                                    <i class="fa fa-eye"></i> View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Mobile cards — hidden on desktop *@
        <div class="fp-mobile-cards">
            @foreach (var client in clients.Take(5))
            {
                <div class="fp-mobile-client-card">
                    <div class="fp-mobile-client-card-header">
                        <div style="display:flex;align-items:center;gap:10px;">
                            <div class="fp-client-avatar">@client.Name[..1].ToUpper()</div>
                            <span style="font-weight:600;font-size:15px;">@client.Name</span>
                        </div>
                        <span class="fp-badge fp-badge-red">@client.SubscriptionDurationPerMonth mo</span>
                    </div>
                    <div class="fp-mobile-client-card-meta">
                        <div>
                            <span class="fp-meta-label">Weight</span>
                            <span class="fp-meta-value">@client.Weight kg</span>
                        </div>
                        <div>
                            <span class="fp-meta-label">Joined</span>
                            <span class="fp-meta-value">@client.CreatedAt.ToString("MMM dd, yyyy")</span>
                        </div>
                        <div>
                            <span class="fp-meta-label">Expires</span>
                            <span class="fp-meta-value">@(client.CreatedAt.AddMonths(client.SubscriptionDurationPerMonth).ToString("MMM dd, yyyy"))</span>
                        </div>
                    </div>
                    <a href="/dashboard/clients/@client.Id" class="fp-btn-outline" style="display:inline-block;margin-top:10px;padding:6px 14px;font-size:12px;">
                        <i class="fa fa-eye"></i> View
                    </a>
                </div>
            }
        </div>

        @if (clients.Count > 5)
        {
            <div style="margin-top:20px;text-align:center;">
                <a href="/dashboard/clients" class="fp-btn-outline">
                    View all @clients.Count clients <i class="fa fa-arrow-right"></i>
                </a>
            </div>
        }
    }
</div>

<style>
    /* ── Stats grid ── */
    .fp-grid-4 {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
    }

    /* ── Loading ── */
    .fp-loading {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 40px 0;
        color: var(--fp-text-muted);
        font-size: 15px;
    }
    .fp-spinner-lg {
        width: 28px; height: 28px;
        border: 3px solid var(--fp-border);
        border-top-color: var(--fp-accent);
        border-radius: 50%;
        animation: fp-spin 0.8s linear infinite;
        flex-shrink: 0;
    }
    @@keyframes fp-spin { to { transform: rotate(360deg); } }

    /* ── Empty state ── */
    .fp-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        padding: 60px 0;
        color: var(--fp-text-muted);
    }
    .fp-empty i { font-size: 40px; opacity: 0.3; }
    .fp-empty p { font-size: 15px; }
    .fp-link { color: var(--fp-accent); text-decoration: none; }
    .fp-link:hover { text-decoration: underline; }

    /* ── Client avatar ── */
    .fp-client-avatar {
        width: 34px; height: 34px;
        background: rgba(234,33,39,0.15);
        color: var(--fp-accent);
        font-family: 'Teko', sans-serif;
        font-size: 16px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    /* ── Responsive: table vs cards ── */
    .fp-table-wrap  { display: block; overflow-x: auto; }
    .fp-mobile-cards { display: none; }

    /* ── Mobile client card ── */
    .fp-mobile-client-card {
        border: 1px solid var(--fp-border);
        border-radius: 8px;
        padding: 14px;
        margin-bottom: 12px;
    }
    .fp-mobile-client-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 10px;
    }
    .fp-mobile-client-card-meta {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px 12px;
    }
    .fp-meta-label {
        display: block;
        font-size: 11px;
        color: var(--fp-text-muted);
    }
    .fp-meta-value {
        font-size: 13px;
        color: var(--fp-text-primary, inherit);
        font-weight: 500;
    }

    /* ── Mobile breakpoint ── */
    @@media (max-width: 640px) {
        .fp-grid-4 {
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
        }

        .fp-table-wrap  { display: none; }
        .fp-mobile-cards { display: block; }

        .fp-card { padding: 16px; }
        .fp-stat-card { padding: 14px; }
        .fp-stat-card-value { font-size: 28px; }

        .fp-card-title { font-size: 16px; }
        .fp-card-sub   { font-size: 13px; }
    }
</style>

@code {
    private List<ClientResponseDto> clients = new();
    private bool isLoading = true;
    private int activeClients = 0;
    private int avgSub = 0;
    private int newThisMonth = 0;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(auth.User);
        if (user == null) return;

        clients = await ClientService.GetMyClientsAsync(user.Id);
        isLoading = false;

        activeClients = clients.Count(c => c.SubscriptionDurationPerMonth > 0);
        avgSub = clients.Any()
            ? (int)clients.Average(c => c.SubscriptionDurationPerMonth)
            : 0;
        newThisMonth = clients.Count(c =>
            c.CreatedAt.Month == DateTime.UtcNow.Month &&
            c.CreatedAt.Year == DateTime.UtcNow.Year);
    }
}