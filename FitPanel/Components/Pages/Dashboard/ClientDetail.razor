                        @for (int i = 0; i < 7; i++)
                        {
                            var day = (Days)i;
                            var isUsed = UsedDaysForActiveWorkout.Contains(day);
                            var isCurrent = day == workouts.FirstOrDefault(w => w.Id == activeWorkoutId)?.WorkoutDays.FirstOrDefault(d => d.Id == editingDayId)?.Day;
