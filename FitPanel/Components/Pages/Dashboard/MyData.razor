                                    <button type="button" class="fp-btn-outline fp-btn-sm" style="color:#ff6b6b; border-color:#ff6b6b;" @onclick="() => editDietTemplateMeals.RemoveAt(idx)">
                                        <i class="fa fa-trash"></i> Remove Meal
                                    </button>
                                </div>

                                <div style="display:flex; gap:12px; margin-bottom:12px;">
                                    <div class="fp-input-group" style="flex:0 0 45%; min-width:0; margin-bottom:0;">
                                        <label>Import from Dictionary</label>
                                        <select class="fp-select" style="height: 48px; border-radius: 6px; font-size: 13px;" @onchange="(e) => OnDictionaryMealSelected(meal, e.Value?.ToString())">
                                            <option value="">-- Select Saved Meal --</option>
                                            @foreach (var dm in meals)
                                            {
                                                <option value="@dm.Id">@dm.MealName (@dm.Calories kcal)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="fp-input-group" style="flex:1; min-width:0; margin-bottom:0;">
                                        <label>Meal Name *</label>
                                        <input value="@meal.Name" @oninput='(e) => UpdateMealName(meal, e.Value?.ToString() ?? "")' placeholder="e.g. Eggs & Whole Wheat Toast" style="height: 48px; border-radius: 6px;" />
                                    </div>
                                </div>

                                @if (primaryIng != null)
                                {
                                    <div class="fp-grid-4" style="margin-top:12px;">
                                        <div class="fp-input-group">
                                            <label>Protein (g)</label>
                                            <input type="number" value="@primaryIng.Protein" @onchange='(e) => UpdateMealProtein(meal, int.TryParse(e.Value?.ToString(), out var v) ? v : 0)' />
                                        </div>
                                        <div class="fp-input-group">
                                            <label>Carbs (g)</label>
                                            <input type="number" value="@primaryIng.Carbs" @onchange='(e) => UpdateMealCarbs(meal, int.TryParse(e.Value?.ToString(), out var v) ? v : 0)' />
                                        </div>
                                        <div class="fp-input-group">
                                            <label>Fats (g)</label>
                                            <input type="number" value="@primaryIng.Fats" @onchange='(e) => UpdateMealFats(meal, int.TryParse(e.Value?.ToString(), out var v) ? v : 0)' />
                                        </div>
                                        <div class="fp-input-group">
                                            <label>Calories (kcal) *</label>
                                            <input type="number" value="@primaryIng.Calories" @onchange='(e) => UpdateMealCalories(meal, int.TryParse(e.Value?.ToString(), out var v) ? v : 0)' />
                                        </div>
                                    </div>
                                }

                                <div class="fp-grid-2" style="margin-top:12px;">
                                    <div class="fp-input-group">
                                        <label>Recipe / Instructions</label>
                                        <input @bind="meal.Instruction" placeholder="e.g. Scramble egg whites, toast the bread and serve hot" />
                                    </div>
                                    <div class="fp-input-group">
                                        <label>Video Link (optional)</label>
                                        <input @bind="meal.Link" placeholder="e.g. https://youtube.com/..." />
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
            <div class="fp-modal-footer">
                <button class="fp-btn-outline" @onclick="() => showDietTemplateModal = false" disabled="@isSaving">Cancel</button>
                <button class="fp-btn-primary" @onclick="SaveDietTemplate" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span style="width: 12px; height: 12px; border: 2px solid #fff; border-right-color: transparent; border-radius: 50%; display: inline-block; animation: spin 0.75s linear infinite; margin-right: 6px; vertical-align: middle;"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <i class="fa fa-save"></i> <span>Save Template</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

