@code {
    private bool isDark = true;
    private bool sidebarOpen = true;
    private string currentPage = "Dashboard";

    // Notifications state
    private List<Notification> notifications = new();
    private bool showNotificationDropdown = false;
    private string currentUserId = "";
    private PanelUser? currentUser;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Check auth on first load
            if (AuthState != null)
            {
                var auth = await AuthState;
                if (!(auth.User.Identity?.IsAuthenticated ?? false))
                {
                    Nav.NavigateTo("/login", forceLoad: true);
                    return;
                }

                var userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                if (!string.IsNullOrEmpty(userId))
                {
                    currentUserId = userId;
                    currentUser = await UserManager.FindByIdAsync(currentUserId);
                }
            }
        }
        catch (Exception)
        {
            // Fail silently during pre-render to guarantee interactive state
        }

        // Set initial page name and subscribe to future changes
        UpdateCurrentPage(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;
    }

    private async Task ToggleNotificationDropdown()
    {
        showNotificationDropdown = !showNotificationDropdown;
        if (showNotificationDropdown)
        {
            try
            {
                notifications = await NotificationService.GetNotificationsForUserAsync(currentUserId);
            }
            catch (Exception) {}
        }
        StateHasChanged();
    }

    private async Task MarkAsRead(Notification notif)
    {
        try
        {
            await NotificationService.MarkAsReadAsync(notif.Id, currentUserId);
            notifications = await NotificationService.GetNotificationsForUserAsync(currentUserId);
        }
        catch (Exception) {}
        StateHasChanged();
    }

    private async Task DeleteNotification(Notification notif)
    {
        try
        {
            await NotificationService.DeleteNotificationAsync(notif.Id, currentUserId);
            notifications = await NotificationService.GetNotificationsForUserAsync(currentUserId);
        }
        catch (Exception) {}
        StateHasChanged();
    }

    private async Task MarkAllAsRead()
    {
        try
        {
            await NotificationService.MarkAllAsReadAsync(currentUserId);
            notifications = await NotificationService.GetNotificationsForUserAsync(currentUserId);
        }
        catch (Exception) {}
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (AuthState != null)
            {
                var auth = await AuthState;
                if (auth.User.Identity?.IsAuthenticated == true)
                {
                    var user = await SignInManager.UserManager.GetUserAsync(auth.User);
                    if (user != null)
                    {
                        try
                        {
                            notifications = await NotificationService.GetNotificationsForUserAsync(user.Id);
                            StateHasChanged();
                        }
                        catch (Exception) {}

                        if (!user.IsActive)
                        {
                            await JS.InvokeVoidAsync("eval", "document.querySelector('.fp-logout-form').action = '/logout?inactive=true'; document.querySelector('.fp-logout-form').submit();");
                            return;
                        }
                        
                        if (await SignInManager.UserManager.IsInRoleAsync(user, "Coach") && user.SubscriptionEndDate < DateTime.UtcNow)
                        {
                            await JS.InvokeVoidAsync("eval", "document.querySelector('.fp-logout-form').action = '/logout?expired=true'; document.querySelector('.fp-logout-form').submit();");
                            return;
                        }
                    }
                }
            }

            // On mobile, sidebar should start closed
            var width = await JS.InvokeAsync<int>("eval", "window.innerWidth");
            if (width <= 768)
            {
                sidebarOpen = false;
                StateHasChanged();
            }
        }
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateCurrentPage(e.Location);
        if (!string.IsNullOrEmpty(currentUserId))
        {
            try
            {
                currentUser = await UserManager.FindByIdAsync(currentUserId);
            }
            catch (Exception) {}
        }
        await InvokeAsync(StateHasChanged);
    }

    private void UpdateCurrentPage(string uri)
    {
        if (uri.Contains("coaches"))       currentPage = "Coaches";
        else if (uri.Contains("clients"))  currentPage = "Clients";
        else                               currentPage = "Dashboard";
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }

    private void ToggleSidebar() => sidebarOpen = !sidebarOpen;
    private void ToggleTheme() => isDark = !isDark;
    private void CloseSidebarOnMobile() { sidebarOpen = false; StateHasChanged(); }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrEmpty(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}".ToUpper()
            : name[..1].ToUpper();
    }
}