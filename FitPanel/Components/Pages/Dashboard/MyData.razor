                    {
                        <span style="width: 12px; height: 12px; border: 2px solid #fff; border-right-color: transparent; border-radius: 50%; display: inline-block; animation: fp-spin 0.75s linear infinite; margin-right: 6px; vertical-align: middle;"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <i class="fa fa-save"></i> <span>Save Template</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@* Workout Template Modal Editor *@
@if (showWorkoutTemplateModal)
{
    <div class="fp-modal-overlay" @onclick="() => showWorkoutTemplateModal = false">
        <div class="fp-data-modal" style="max-width: 950px; width: 95%; max-height: 90vh; overflow-y: auto;" @onclick:stopPropagation="true">
            <div class="fp-data-modal-header">
                <span class="fp-data-modal-title"><i class="fa fa-folder-open"></i> @(editWorkoutTemplate.Id == 0 ? "CREATE" : "EDIT") WORKOUT TEMPLATE</span>
                <button class="fp-data-modal-close" @onclick="() => showWorkoutTemplateModal = false"><i class="fa fa-times"></i></button>
            </div>
            <div class="fp-data-modal-body">
                <div class="fp-grid-2" style="gap: 16px;">
                    <div class="fp-input-group">
                        <label>Template Name *</label>
                        <input @bind="editWorkoutTemplate.Name" placeholder="e.g. Push/Pull/Legs Split Month 1" />
                    </div>
                    <div class="fp-input-group">
                        <label>Split Name *</label>
                        <input @bind="editWorkoutTemplate.SplitName" placeholder="e.g. 3-Day PPL split" />
                    </div>
                </div>
                
                <div class="fp-input-group">
                    <label>Instructions & Tips</label>
                    <textarea @bind="editWorkoutTemplate.Instructions" rows="3" placeholder="General rules (e.g. Target RPE 8, rest 2 minutes on compound movements)..."></textarea>
                </div>

                <div style="margin-top:28px; border-top: 1px solid var(--fp-border); padding-top:24px;">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 20px;">
                        <h4 class="fp-template-section-title">Workout Days</h4>
                        <button type="button" class="fp-data-btn-secondary fp-data-btn" @onclick="AddWorkoutDayToTemplate">
                            <i class="fa fa-plus"></i> Add Workout Day
                        </button>
                    </div>

                    @if (!editWorkoutTemplateDays.Any())
                    {
                        <p style="color:var(--fp-text-muted); font-size:13.5px; font-style:italic; font-family:'Inter',sans-serif;">No days added to this split template yet. Click "Add Workout Day" above.</p>
                    }
                    else
                    {
                        @for (int dIdx = 0; dIdx < editWorkoutTemplateDays.Count; dIdx++)
                        {
                            var currentDayIdx = dIdx;
                            var dayHolder = editWorkoutTemplateDays[currentDayIdx];

                            <div class="fp-data-template-day-card">
                                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                                    <span style="font-weight:700; color:var(--fp-text); font-size:15px;">Workout Day #@(currentDayIdx + 1)</span>
                                    <button type="button" class="fp-data-btn-secondary fp-data-btn" style="color:#ff6b6b; border-color:rgba(255,107,107,0.3);" @onclick="() => editWorkoutTemplateDays.RemoveAt(currentDayIdx)">
                                        <i class="fa fa-trash"></i> Remove Day
                                    </button>
                                </div>

                                <div class="fp-grid-2" style="gap: 16px;">
                                    <div class="fp-input-group">
                                        <label>Day Title *</label>
                                        <input @bind="dayHolder.DayName" placeholder="e.g. Day 1 - Chest & Shoulders" />
                                    </div>
                                    <div class="fp-input-group">
                                        <label>Calendar Day Assignment *</label>
                                        <select @bind="dayHolder.Day">
                                            @foreach (var dVal in Enum.GetValues<Days>())
                                            {
                                                <option value="@dVal">@dVal.ToString()</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                @* Exercises *@
                                <div class="fp-template-nested-section">
                                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
                                        <span style="font-weight:700; font-size:13px; color:var(--fp-text-secondary); text-transform:uppercase; letter-spacing:0.5px;">Exercises on this Day</span>
                                        <button type="button" class="fp-data-btn-secondary fp-data-btn" style="padding: 6px 12px; font-size:12px; border-radius:8px;" @onclick="() => AddExerciseToDay(dayHolder)">
                                            <i class="fa fa-plus"></i> Add Exercise
                                        </button>
                                    </div>

                                    @if (!dayHolder.Exercises.Any())
                                    {
                                        <p style="color:var(--fp-text-muted); font-size:13px; font-style:italic; font-family:'Inter',sans-serif; margin:0;">No exercises added to this day yet.</p>
                                    }
                                    else
                                    {
                                        @for (int eIdx = 0; eIdx < dayHolder.Exercises.Count; eIdx++)
                                        {
                                            var currentExIdx = eIdx;
                                            var exHolder = dayHolder.Exercises[currentExIdx];

                                            <div class="fp-template-exercise-card">
                                                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                                                    <span style="font-weight: 700; font-size: 12px; color: var(--fp-text);">Exercise #@(currentExIdx + 1)</span>
                                                    <button type="button" class="fp-action-btn btn-delete" style="width:24px; height:24px; border-radius:6px;" @onclick="() => dayHolder.Exercises.RemoveAt(currentExIdx)">
                                                        <i class="fa fa-times"></i>
                                                    </button>
                                                </div>

                                                <div style="display:flex; gap:12px; margin-bottom:12px; flex-wrap:wrap;">
                                                    <div class="fp-input-group" style="flex:1.5; min-width:240px; margin-bottom:0;">
                                                        <label>Import from Dictionary</label>
                                                        <select style="border-radius:10px; height:44px;" @onchange="(e) => OnDictionaryExerciseSelected(exHolder, e.Value?.ToString())">
                                                            <option value="">-- Select Saved Exercise --</option>
                                                            @foreach (var dex in exercises)
                                                            {
                                                                <option value="@dex.Id">@dex.ExerciseName</option>
                                                            }
                                                        </select>
                                                    </div>
                                                    <div class="fp-input-group" style="flex:2; min-width:240px; margin-bottom:0;">
                                                        <label>Exercise Name *</label>
                                                        <input @bind="exHolder.ExerciseName" placeholder="e.g. Incline Bench Press" />
                                                    </div>
                                                </div>

                                                <div class="fp-grid-4" style="margin-top:12px; gap:12px;">
                                                    <div class="fp-input-group" style="margin-bottom:0;">
                                                        <label>Sets</label>
                                                        <input @bind="exHolder.Sets" placeholder="e.g. 4" />
                                                    </div>
                                                    <div class="fp-input-group" style="margin-bottom:0;">
                                                        <label>Reps</label>
                                                        <input @bind="exHolder.Reps" placeholder="e.g. 8-12" />
                                                    </div>
                                                    <div class="fp-input-group" style="margin-bottom:0;">
                                                        <label>Rest</label>
                                                        <input @bind="exHolder.RestTime" placeholder="e.g. 90s" />
                                                    </div>
                                                    <div class="fp-input-group" style="margin-bottom:0;">
                                                        <label>Video Link</label>
                                                        <input @bind="exHolder.ExerciseLink" placeholder="e.g. https://..." />
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>

                                @* Cardio *@
                                <div class="fp-template-cardio-section">
                                    <div style="display:flex; align-items:center; gap:10px; margin-bottom:12px;">
                                        <input type="checkbox" id="chkCardioTab_@(currentDayIdx)" @bind="dayHolder.IncludeCardio" style="width:16px; height:16px; cursor:pointer;" />
                                        <label for="chkCardioTab_@(currentDayIdx)" style="margin:0; font-family:'Inter',sans-serif; font-size:13.5px; font-weight:700; color:var(--fp-text); cursor:pointer; text-transform:uppercase; letter-spacing:0.5px;">Include Cardio on this Day</label>
                                    </div>

                                    @if (dayHolder.IncludeCardio)
                                    {
                                        <div class="fp-grid-3" style="gap: 12px;">
                                            <div class="fp-input-group" style="margin-bottom:0;">
                                                <label>Cardio Type</label>
                                                <input @bind="dayHolder.CardioType" placeholder="e.g. Elliptical" />
                                            </div>
                                            <div class="fp-input-group" style="margin-bottom:0;">
                                                <label>Duration (minutes)</label>
                                                <input type="number" @bind="dayHolder.CardioDuration" />
                                            </div>
                                            <div class="fp-input-group" style="margin-bottom:0;">
                                                <label>Intensity</label>
                                                <select @bind="dayHolder.CardioIntensity">
                                                    @foreach (var ciVal in Enum.GetValues<CardioIntensity>())
                                                    {
                                                        <option value="@ciVal">@ciVal.ToString()</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                        <div class="fp-input-group" style="margin-top:12px; margin-bottom:0;">
                                            <label>Cardio Guidelines & Notes</label>
                                            <input @bind="dayHolder.CardioNotes" placeholder="e.g. Steady state at 65% max heart rate" />
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
            <div class="fp-data-modal-footer">
                <button class="fp-data-btn-secondary fp-data-btn" @onclick="() => showWorkoutTemplateModal = false" disabled="@isSaving">Cancel</button>
                <button class="fp-btn-primary fp-data-btn" @onclick="SaveWorkoutTemplate" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span style="width: 12px; height: 12px; border: 2px solid #fff; border-right-color: transparent; border-radius: 50%; display: inline-block; animation: fp-spin 0.75s linear infinite; margin-right: 6px; vertical-align: middle;"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <i class="fa fa-save"></i> <span>Save Template</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@* Unified Deletion Confirmation Modal *@
@if (showDeleteConfirm)
{
    <div class="fp-modal-overlay" @onclick="() => showDeleteConfirm = false">
        <div class="fp-data-modal" style="max-width: 420px;" @onclick:stopPropagation="true">
            <div class="fp-data-modal-header" style="background:rgba(234,33,39,0.04);border-bottom:1px solid rgba(234,33,39,0.15);">
                <span class="fp-data-modal-title" style="color:var(--fp-accent);"><i class="fa fa-exclamation-triangle"></i> CONFIRM DELETION</span>
                <button class="fp-data-modal-close" @onclick="() => showDeleteConfirm = false"><i class="fa fa-times"></i></button>
            </div>
            <div class="fp-data-modal-body">
                <p style="font-family:'Inter',sans-serif; font-size:14px; color:var(--fp-text); margin:0; line-height:1.5;">@deleteConfirmMessage</p>
                <p class="fp-hint" style="color:#ff6b6b; margin-top: 12px; font-weight:500;">This action cannot be undone.</p>
            </div>
            <div class="fp-data-modal-footer">
                <button class="fp-data-btn-secondary fp-data-btn" @onclick="() => showDeleteConfirm = false">Cancel</button>
                <button class="fp-btn-primary fp-data-btn" style="background:#e31c1c; border-color:#e31c1c;" @onclick="PerformDelete"><i class="fa fa-trash"></i> Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private string errorMessage = "";
    private string coachId = "";
    private string activeTab = "meals";

    private List<CoachMealDictionary> meals = new();
    private List<CoachExerciseDictionary> exercises = new();
    private List<DietTemplate> dietTemplates = new();
    private List<WorkoutTemplate> workoutTemplates = new();

    // Dictionary Modals
    private bool showMealModal = false;
    private CoachMealDictionary editMeal = new();
    private List<CreateMealItemDto> editMealIngredients = new();

    private bool showExerciseModal = false;
    private CoachExerciseDictionary editExercise = new();
    private bool isSaving = false;

    private List<CoachWarmUpDictionary> warmups = new();
    private bool showWarmUpModal = false;
    private CoachWarmUpDictionary editWarmUp = new();

    // Template Modals & Editors
    private bool showDietTemplateModal = false;
    private DietTemplate editDietTemplate = new();
    private List<DietMealResponseDto> editDietTemplateMeals = new();

    private bool showWorkoutTemplateModal = false;
    private WorkoutTemplate editWorkoutTemplate = new();
    private List<WorkoutDayResponseDtoHolder> editWorkoutTemplateDays = new();

    // Deletion confirmation
    private bool showDeleteConfirm = false;
    private string deleteConfirmMessage = "";
    private Func<Task> deleteAction;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            if (auth.User.Identity?.IsAuthenticated != true)
            {
                errorMessage = "Not authenticated.";
                return;
            }
            var user = await UserManager.GetUserAsync(auth.User);
            if (user == null) { errorMessage = "User not found."; return; }
            
            coachId = user.Id;
            await LoadData();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadData()
    {
        meals = await DictionaryService.GetMealsAsync(coachId);
        exercises = await DictionaryService.GetExercisesAsync(coachId);
        warmups = await DictionaryService.GetWarmUpsAsync(coachId);
        dietTemplates = await TemplateService.GetDietTemplatesAsync(coachId);
        workoutTemplates = await TemplateService.GetWorkoutTemplatesAsync(coachId);
    }

    // --- Dictionary: Meals ---
    private void OpenAddMealModal() 
    { 
        editMeal = new CoachMealDictionary(); 
        editMealIngredients = new();
        showMealModal = true; 
    }

    private void OpenEditMealModal(CoachMealDictionary m) 
    { 
        editMeal = new CoachMealDictionary { 
            Id = m.Id, 
            MealName = m.MealName, 
            Calories = m.Calories, 
            Protein = m.Protein, 
            Carbs = m.Carbs, 
            Fats = m.Fats, 
            Link = m.Link, 
            Instruction = m.Instruction,
            IngredientsJson = m.IngredientsJson
        }; 

        if (!string.IsNullOrEmpty(m.IngredientsJson))
        {
            try 
            {
                editMealIngredients = System.Text.Json.JsonSerializer.Deserialize<List<CreateMealItemDto>>(
                    m.IngredientsJson, 
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
            } 
            catch 
            {
                editMealIngredients = new();
            }
        }
        else 
        {
            editMealIngredients = new();
        }

        showMealModal = true; 
    }
    
    private void AddIngredientToDictMeal()
    {
        editMealIngredients.Add(new CreateMealItemDto { MealName = "", Quantity = 1, Unit = "g", Protein = 0, Carbs = 0, Fats = 0, Calories = 0 });
    }

    private void RemoveIngredientFromDictMeal(int index)
    {
        editMealIngredients.RemoveAt(index);
        RecalculateDictionaryMealMacros();
    }

    private async Task FetchIngredientMacrosFromNinja(CreateMealItemDto ing)
    {
        if (string.IsNullOrWhiteSpace(ing.MealName)) return;

        try
        {
            var query = $"{ing.Quantity} {ing.Unit} {ing.MealName}";
            var result = await NutritionApiService.GetNutritionAsync(query);
            if (result != null)
            {
                ing.Protein = (int)Math.Round(result.Protein);
                ing.Carbs = (int)Math.Round(result.Carbs);
                ing.Fats = (int)Math.Round(result.Fats);
                ing.Calories = (int)Math.Round(result.Calories);

                RecalculateDictionaryMealMacros();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("CalorieNinjas failed: " + ex.Message);
        }
    }

    private void RecalculateDictionaryMealMacros()
    {
        // Auto-calculate individual ingredient calories using the standard Atwater fitness equation
        foreach (var ing in editMealIngredients)
        {
            ing.Calories = (ing.Protein * 4) + (ing.Carbs * 4) + (ing.Fats * 9);
        }

        editMeal.Protein = editMealIngredients.Sum(x => x.Protein);
        editMeal.Carbs = editMealIngredients.Sum(x => x.Carbs);
        editMeal.Fats = editMealIngredients.Sum(x => x.Fats);
        editMeal.Calories = editMealIngredients.Sum(x => x.Calories);
    }
    
    private async Task SaveMeal()
    {
        if (isSaving) return;
        if (string.IsNullOrWhiteSpace(editMeal.MealName)) return;

        isSaving = true;
        try
        {
            // Recalculate one last time to be absolute certain
            RecalculateDictionaryMealMacros();

            // Serialize ingredients list to JSON
            editMeal.IngredientsJson = System.Text.Json.JsonSerializer.Serialize(editMealIngredients);

            if (editMeal.Id == 0) await DictionaryService.AddMealAsync(coachId, editMeal);
            else await DictionaryService.UpdateMealAsync(coachId, editMeal);

            await LoadData();
            showMealModal = false;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ConfirmDeleteMeal(CoachMealDictionary m)
    {
        deleteConfirmMessage = $"Are you sure you want to delete the meal '{m.MealName}' from your dictionary?";
        deleteAction = async () =>
        {
            await DictionaryService.DeleteMealAsync(coachId, m.Id);
            await LoadData();
        };
        showDeleteConfirm = true;
    }

    // --- Dictionary: Exercises ---
    private void OpenAddExerciseModal() { editExercise = new CoachExerciseDictionary(); showExerciseModal = true; }
    private void OpenEditExerciseModal(CoachExerciseDictionary e) { 
        editExercise = new CoachExerciseDictionary { Id = e.Id, ExerciseName = e.ExerciseName, ExcerciseLink = e.ExcerciseLink }; 
        showExerciseModal = true; 
    }

    private async Task SaveExercise()
    {
        if (isSaving) return;
        if (string.IsNullOrWhiteSpace(editExercise.ExerciseName)) return;

        isSaving = true;
        try
        {
            if (editExercise.Id == 0) await DictionaryService.AddExerciseAsync(coachId, editExercise);
            else await DictionaryService.UpdateExerciseAsync(coachId, editExercise);

            await LoadData();
            showExerciseModal = false;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ConfirmDeleteExercise(CoachExerciseDictionary e)
    {
        deleteConfirmMessage = $"Are you sure you want to delete the exercise '{e.ExerciseName}' from your dictionary?";
        deleteAction = async () =>
        {
            await DictionaryService.DeleteExerciseAsync(coachId, e.Id);
            await LoadData();
        };
        showDeleteConfirm = true;
    }

    // --- Dictionary: Warm Ups ---
    private void OpenAddWarmUpModal()
    {
        editWarmUp = new CoachWarmUpDictionary();
        showWarmUpModal = true;
    }

    private void OpenEditWarmUpModal(CoachWarmUpDictionary wu)
    {
        editWarmUp = new CoachWarmUpDictionary { Id = wu.Id, WarmUpName = wu.WarmUpName, WarmUpLink = wu.WarmUpLink };
        showWarmUpModal = true;
    }

    private async Task SaveWarmUp()
    {
        if (isSaving) return;
        if (string.IsNullOrWhiteSpace(editWarmUp.WarmUpName)) return;

        isSaving = true;
        try
        {
            if (editWarmUp.Id == 0) await DictionaryService.AddWarmUpAsync(coachId, editWarmUp);
            else await DictionaryService.UpdateWarmUpAsync(coachId, editWarmUp);

            await LoadData();
            showWarmUpModal = false;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ConfirmDeleteWarmUp(CoachWarmUpDictionary wu)
    {
        deleteConfirmMessage = $"Are you sure you want to delete the warm-up '{wu.WarmUpName}' from your dictionary?";
        deleteAction = async () =>
        {
            await DictionaryService.DeleteWarmUpAsync(coachId, wu.Id);
            await LoadData();
        };
        showDeleteConfirm = true;
    }

    // --- Diet Templates Direct CRUD ---
    private void OpenAddDietTemplateModal()
    {
        editDietTemplate = new DietTemplate { Name = "New Diet Plan Template", NumberOfMeals = 3 };
        editDietTemplateMeals.Clear();
        // default 3 meals to make editing fast
        for (int i = 0; i < 3; i++)
        {
            AddMealToTemplate();
        }
        showDietTemplateModal = true;
    }

    private void OpenEditDietTemplateModal(DietTemplate temp)
    {
        editDietTemplate = new DietTemplate
        {
            Id = temp.Id,
            Name = temp.Name,
            CoachId = temp.CoachId,
            Instructions = temp.Instructions,
            NumberOfMeals = temp.NumberOfMeals
        };

        editDietTemplateMeals.Clear();
        try
        {
            var list = JsonSerializer.Deserialize<List<DietMealResponseDto>>(temp.DietJson);
            if (list != null)
            {
                editDietTemplateMeals.AddRange(list);
            }
        }
        catch { }

        showDietTemplateModal = true;
    }

    private void AddMealToTemplate()
    {
        editDietTemplateMeals.Add(new DietMealResponseDto
        {
            Id = 0,
            Name = $"Meal {editDietTemplateMeals.Count + 1}",
            Ingredients = new List<MealItemResponseDto> {
                new MealItemResponseDto(0, "Primary Ingredient", 1, "servings", 0, 0, 0, 0, new List<AlternativeResponeDto>())
            },
            AlternativeMeals = new List<DietMealResponseDto>()
        });
    }

    private void OnDictionaryMealSelected(DietMealResponseDto meal, string mealIdStr)
    {
        if (int.TryParse(mealIdStr, out var id) && id > 0)
        {
            var dm = meals.FirstOrDefault(x => x.Id == id);
            if (dm != null)
            {
                meal.Name = dm.MealName;
                meal.Link = dm.Link;
                if (meal.Ingredients.Any())
                {
                    meal.Ingredients[0] = meal.Ingredients[0] with {
                        MealName = dm.MealName,
                        Protein = dm.Protein,
                        Carbs = dm.Carbs,
                        Fats = dm.Fats,
                        Calories = dm.Calories
                    };
                }
            }
        }
    }

    private void UpdateMealName(DietMealResponseDto meal, string val)
    {
        meal.Name = val;
        if (meal.Ingredients.Any())
        {
            meal.Ingredients[0] = meal.Ingredients[0] with { MealName = val };
        }
    }

    private void UpdateMealProtein(DietMealResponseDto meal, int val)
    {
        if (meal.Ingredients.Any()) meal.Ingredients[0] = meal.Ingredients[0] with { Protein = val };
    }

    private void UpdateMealCarbs(DietMealResponseDto meal, int val)
    {
        if (meal.Ingredients.Any()) meal.Ingredients[0] = meal.Ingredients[0] with { Carbs = val };
    }

    private void UpdateMealFats(DietMealResponseDto meal, int val)
    {
        if (meal.Ingredients.Any()) meal.Ingredients[0] = meal.Ingredients[0] with { Fats = val };
    }

    private void UpdateMealCalories(DietMealResponseDto meal, int val)
    {
        if (meal.Ingredients.Any()) meal.Ingredients[0] = meal.Ingredients[0] with { Calories = val };
    }

    private async Task SaveDietTemplate()
    {
        if (isSaving) return;
        if (string.IsNullOrWhiteSpace(editDietTemplate.Name)) return;

        isSaving = true;
        try
        {
            editDietTemplate.NumberOfMeals = editDietTemplateMeals.Count;
            editDietTemplate.DietJson = JsonSerializer.Serialize(editDietTemplateMeals);
            editDietTemplate.CoachId = coachId;

