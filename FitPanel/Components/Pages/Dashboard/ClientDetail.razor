@page "/dashboard/clients/{ClientId:int}"
@layout DashboardLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using FitPanel.Data
@using FitPanel.Data.Models
@using FitPanel.Services
@using FitPanel.DTOs.Client
@using FitPanel.DTOs.Diet
@using FitPanel.DTOs.Workout
@attribute [Authorize(Roles = "Coach")]
@inject UserManager<PanelUser> UserManager
@inject IClientService ClientService
@inject IDietService DietService
@inject IWorkoutService WorkoutService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Client Profile — FitPanel</PageTitle>

@if (isLoading)
{
    <div class="fp-loading">
        <div class="fp-spinner-lg"></div>
        <span>Loading client...</span>
    </div>
}
else if (client == null)
{
    <div class="fp-empty">
        <i class="fa fa-user-slash"></i>
        <p>Client not found.</p>
        <a href="/dashboard/clients" class="fp-btn-outline">← Back to Clients</a>
    </div>
}
else
{
    @* ── Header ── *@
    <div class="fp-client-header">
        <div class="fp-client-header-left">
            <a href="/dashboard/clients" class="fp-back-btn">
                <i class="fa fa-arrow-left"></i>
            </a>
            <div class="fp-client-avatar-xl">@client.Name[..1].ToUpper()</div>
            <div>
                <h1 class="fp-client-title">@client.Name</h1>
                <div class="fp-client-meta-row">
                    <span><i class="fa fa-weight"></i> @client.Weight kg</span>
                    <span><i class="fa fa-calendar"></i> @client.SubscriptionDurationPerMonth month subscription</span>
                    <span><i class="fa fa-clock"></i> Joined @client.CreatedAt.ToString("MMM dd, yyyy")</span>
                </div>
            </div>
        </div>
    </div>

    @* ── Tabs ── *@
    <div class="fp-tabs">
        <button class="fp-tab @(activeTab == "diet" ? "active" : "")" @onclick='() => activeTab = "diet"'>
            <i class="fa fa-utensils"></i> Diet Plan
        </button>
        <button class="fp-tab @(activeTab == "workout" ? "active" : "")" @onclick='() => activeTab = "workout"'>
            <i class="fa fa-dumbbell"></i> Workout Plan
        </button>
    </div>

    @* ══════════════════════════════════════════════ *@
    @* ── DIET TAB ── *@
    @* ══════════════════════════════════════════════ *@
    @if (activeTab == "diet")
    {
        <div class="fp-tab-content">
            <div class="fp-section-header">
                <div>
                    <h2 class="fp-section-title">Diet Plans</h2>
                    <p class="fp-section-sub">@diets.Count plan@(diets.Count != 1 ? "s" : "") created</p>
                </div>
                <button class="fp-btn-primary" @onclick='() => showDietModal = true'>
                    <i class="fa fa-plus"></i> New Diet Plan
                </button>
            </div>

            @if (!diets.Any())
            {
                <div class="fp-empty-card">
                    <i class="fa fa-utensils"></i>
                    <p>No diet plans yet.</p>
                </div>
            }
            else
            {
                @foreach (var diet in diets)
                {
                    <div class="fp-plan-card">
                        <div class="fp-plan-card-header">
                            <div>
                                <span class="fp-plan-badge">Diet Plan</span>
                                <h3>@diet.NumberOfMeals Meals / Day</h3>
                                <span class="fp-plan-date">Created @diet.CreatedAt.ToString("MMM dd, yyyy")</span>
                            </div>
                            <div class="fp-plan-actions">
                                <button class="fp-icon-btn" title="Add Meal"
                                        @onclick="() => OpenAddMealModal(diet.Id)">
                                    <i class="fa fa-plus"></i>
                                </button>
                                <button class="fp-icon-btn fp-icon-btn-danger" title="Delete Diet"
                                        @onclick="() => DeleteDiet(diet.Id)">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </div>
                        </div>

                        @if (diet.MealItems.Any())
                        {
                            <div class="fp-meals-grid">
                                @foreach (var meal in diet.MealItems)
                                {
                                    <div class="fp-meal-card">
                                        <div class="fp-meal-name">@meal.MealName</div>
                                        <div class="fp-meal-desc">@meal.Description</div>
                                        <div class="fp-macro-row">
                                            <div class="fp-macro">
                                                <span class="fp-macro-val">@meal.Protein<small>g</small></span>
                                                <span class="fp-macro-label">Protein</span>
                                            </div>
                                            <div class="fp-macro">
                                                <span class="fp-macro-val">@meal.Carbs<small>g</small></span>
                                                <span class="fp-macro-label">Carbs</span>
                                            </div>
                                            <div class="fp-macro">
                                                <span class="fp-macro-val">@meal.Fats<small>g</small></span>
                                                <span class="fp-macro-label">Fats</span>
                                            </div>
                                            <div class="fp-macro fp-macro-cal">
                                                <span class="fp-macro-val">@meal.Calories<small>kcal</small></span>
                                                <span class="fp-macro-label">Calories</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p style="color:var(--fp-text-muted);font-size:14px;padding:16px 0;">
                                No meals added yet. Click + to add meals.
                            </p>
                        }
                    </div>
                }
            }
        </div>
    }

    @* ══════════════════════════════════════════════ *@
    @* ── WORKOUT TAB ── *@
    @* ══════════════════════════════════════════════ *@
    @if (activeTab == "workout")
    {
        <div class="fp-tab-content">
            <div class="fp-section-header">
                <div>
                    <h2 class="fp-section-title">Workout Plans</h2>
                    <p class="fp-section-sub">@workouts.Count plan@(workouts.Count != 1 ? "s" : "") created</p>
                </div>
                <button class="fp-btn-primary" @onclick='() => showWorkoutModal = true'>
                    <i class="fa fa-plus"></i> New Workout Plan
                </button>
            </div>

            @if (!workouts.Any())
            {
                <div class="fp-empty-card">
                    <i class="fa fa-dumbbell"></i>
                    <p>No workout plans yet.</p>
                </div>
            }
            else
            {
                @foreach (var workout in workouts)
                {
                    <div class="fp-plan-card">
                        <div class="fp-plan-card-header">
                            <div>
                                <span class="fp-plan-badge fp-plan-badge-blue">Workout Plan</span>
                                <h3>@workout.SplitName</h3>
                                <span class="fp-plan-date">@workout.NumberOfWorkoutDays days · Created @workout.CreatedAt.ToString("MMM dd, yyyy")</span>
                            </div>
                            <div class="fp-plan-actions">
                                <button class="fp-icon-btn" title="Add Day"
                                        @onclick="() => OpenAddDayModal(workout.Id)">
                                    <i class="fa fa-plus"></i>
                                </button>
                                <button class="fp-icon-btn fp-icon-btn-danger" title="Delete Workout"
                                        @onclick="() => DeleteWorkout(workout.Id)">
                                    <i class="fa fa-trash"></i>
                                </button>
                            </div>
                        </div>

                        @if (workout.WorkoutDays.Any())
                        {
                            <div class="fp-days-list">
                                @foreach (var day in workout.WorkoutDays)
                                {
                                    <div class="fp-day-card">
                                        <div class="fp-day-header">
                                            <div class="fp-day-info">
                                                <span class="fp-day-badge">@day.Day.ToString()</span>
                                                <span class="fp-day-name">@day.DayName</span>
                                            </div>
                                            <button class="fp-icon-btn" title="Add Exercise"
                                                    @onclick="() => OpenAddExerciseModal(workout.Id, day.Id)">
                                                <i class="fa fa-plus"></i> Exercise
                                            </button>
                                        </div>

                                        @if (day.Exercises.Any())
                                        {
                                            <table class="fp-table fp-exercise-table">
                                                <thead>
                                                    <tr>
                                                        <th>Exercise</th>
                                                        <th>Sets</th>
                                                        <th>Reps</th>
                                                        <th>Rest</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var ex in day.Exercises)
                                                    {
                                                        <tr>
                                                            <td>
                                                                @if (!string.IsNullOrEmpty(ex.ExerciseLink))
                                                                {
                                                                    <a href="@ex.ExerciseLink" target="_blank" class="fp-exercise-link">
                                                                        @ex.ExerciseName <i class="fa fa-external-link-alt"></i>
                                                                    </a>
                                                                }
                                                                else
                                                                {
                                                                    @ex.ExerciseName
                                                                }
                                                            </td>
                                                            <td><span class="fp-badge fp-badge-red">@ex.Sets</span></td>
                                                            <td>@ex.Reps</td>
                                                            <td style="color:var(--fp-text-muted)">@ex.RestTime</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        }

                                        @* Cardio *@
                                        @if (day.Cardio != null)
                                        {
                                            <div class="fp-cardio-badge">
                                                <i class="fa fa-running"></i>
                                                <span>@day.Cardio.CardioType · @day.Cardio.DurationMinutes min · @day.Cardio.Intensity</span>
                                                @if (!string.IsNullOrEmpty(day.Cardio.Notes))
                                                {
                                                    <span style="color:var(--fp-text-muted)"> — @day.Cardio.Notes</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <button class="fp-add-cardio-btn"
                                                    @onclick="() => OpenAddCardioModal(workout.Id, day.Id)">
                                                <i class="fa fa-plus"></i> Add Cardio
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p style="color:var(--fp-text-muted);font-size:14px;padding:16px 0;">
                                No days added yet. Click + to add workout days.
                            </p>
                        }
                    </div>
                }
            }
        </div>
    }
}

@* ══════════════════════════════════════════════════════ *@
@* ── MODALS ── *@
@* ══════════════════════════════════════════════════════ *@

@* New Diet Modal *@
@if (showDietModal)
{
    <div class="fp-modal-overlay" @onclick='() => showDietModal = false'>
        <div class="fp-modal" @onclick:stopPropagation="true">
            <div class="fp-modal-header">
                <span class="fp-modal-title"><i class="fa fa-utensils"></i> NEW DIET PLAN</span>
                <button class="fp-modal-close" @onclick='() => showDietModal = false'><i class="fa fa-times"></i></button>
            </div>
            <div class="fp-modal-body">
                <div class="fp-input-group">
                    <label>Number of Meals per Day *</label>
                    <input type="number" @bind="newDiet.NumberOfMeals" min="1" max="10" placeholder="5" />
                </div>
            </div>
            <div class="fp-modal-footer">
                <button class="fp-btn-outline" @onclick='() => showDietModal = false'>Cancel</button>
                <button class="fp-btn-primary" @onclick="CreateDiet">
                    <i class="fa fa-check"></i> Create Diet Plan
                </button>
            </div>
        </div>
    </div>
}

@* Add Meal Modal *@
@if (showMealModal)
{
    <div class="fp-modal-overlay" @onclick='() => showMealModal = false'>
        <div class="fp-modal" @onclick:stopPropagation="true">
            <div class="fp-modal-header">
                <span class="fp-modal-title"><i class="fa fa-plus"></i> ADD MEAL</span>
                <button class="fp-modal-close" @onclick='() => showMealModal = false'><i class="fa fa-times"></i></button>
            </div>
            <div class="fp-modal-body">
                <div class="fp-grid-2">
                    <div class="fp-input-group">
                        <label>Meal Name *</label>
                        <input @bind="newMeal.MealName" placeholder="Grilled Chicken" />
                    </div>
                    <div class="fp-input-group">
                        <label>Calories *</label>
                        <input type="number" @bind="newMeal.Calories" placeholder="220" />
                    </div>
                </div>
                <div class="fp-input-group">
                    <label>Description</label>
                    <input @bind="newMeal.Description" placeholder="Lean protein source..." />
                </div>
                <div class="fp-grid-3">
                    <div class="fp-input-group">
                        <label>Protein (g)</label>
                        <input type="number" @bind="newMeal.Protein" placeholder="40" />
                    </div>
                    <div class="fp-input-group">
                        <label>Carbs (g)</label>
                        <input type="number" @bind="newMeal.Carbs" placeholder="0" />
                    </div>
                    <div class="fp-input-group">
                        <label>Fats (g)</label>
                        <input type="number" @bind="newMeal.Fats" placeholder="5" />
                    </div>
                </div>
                <div class="fp-input-group">
                    <label>Video Link (optional)</label>
                    <input @bind="newMeal.Link" placeholder="https://youtube.com/..." />
                </div>
            </div>
            <div class="fp-modal-footer">
                <button class="fp-btn-outline" @onclick='() => showMealModal = false'>Cancel</button>
                <button class="fp-btn-primary" @onclick="AddMeal">
                    <i class="fa fa-check"></i> Add Meal
                </button>
            </div>
        </div>
    </div>
}

@* New Workout Modal *@
@if (showWorkoutModal)
{
    <div class="fp-modal-overlay" @onclick='() => showWorkoutModal = false'>
        <div class="fp-modal" @onclick:stopPropagation="true">
            <div class="fp-modal-header">
                <span class="fp-modal-title"><i class="fa fa-dumbbell"></i> NEW WORKOUT PLAN</span>
                <button class="fp-modal-close" @onclick='() => showWorkoutModal = false'><i class="fa fa-times"></i></button>
            </div>
            <div class="fp-modal-body">
                <div class="fp-input-group">
                    <label>Split Name *</label>
                    <input @bind="newWorkout.SplitName" placeholder="Push Pull Legs / Arnold Split..." />
                </div>
                <div class="fp-input-group">
                    <label>Number of Days *</label>
                    <input type="number" @bind="newWorkout.NumberOfWorkoutDays" min="1" max="7" placeholder="5" />
                </div>
            </div>
            <div class="fp-modal-footer">
                <button class="fp-btn-outline" @onclick='() => showWorkoutModal = false'>Cancel</button>
                <button class="fp-btn-primary" @onclick="CreateWorkout">
                    <i class="fa fa-check"></i> Create Workout Plan
                </button>
            </div>
        </div>
    </div>
}

@* Add Workout Day Modal *@
@if (showDayModal)
{
    <div class="fp-modal-overlay" @onclick='() => showDayModal = false'>
        <div class="fp-modal" @onclick:stopPropagation="true">
            <div class="fp-modal-header">
                <span class="fp-modal-title"><i class="fa fa-calendar-plus"></i> ADD WORKOUT DAY</span>
                <button class="fp-modal-close" @onclick='() => showDayModal = false'><i class="fa fa-times"></i></button>
            </div>
            <div class="fp-modal-body">
                <div class="fp-input-group">
                    <label>Day Name *</label>
                    <input @bind="newDay.DayName" placeholder="Push Day / Chest Day..." />
                </div>
                <div class="fp-input-group">
                    <label>Day of Week *</label>
                    <select @bind="newDayEnum">
                        <option value="0">@Days.Day1.ToString()</option>
                        <option value="1">@Days.Day2.ToString()</option>
                        <option value="2">@Days.Day3.ToString()</option>
                        <option value="3">@Days.Day4.ToString()</option>
                        <option value="4">@Days.Day5.ToString()</option>
                        <option value="5">@Days.Day6.ToString()</option>
                        <option value="6">@Days.Day7.ToString()</option>
                    </select>
                </div>
            </div>
            <div class="fp-modal-footer">
                <button class="fp-btn-outline" @onclick='() => showDayModal = false'>Cancel</button>
                <button class="fp-btn-primary" @onclick="AddWorkoutDay">
                    <i class="fa fa-check"></i> Add Day
                </button>
            </div>
        </div>
    </div>
}

@* Add Exercise Modal *@
@if (showExerciseModal)
{
    <div class="fp-modal-overlay" @onclick='() => showExerciseModal = false'>
        <div class="fp-modal" @onclick:stopPropagation="true">
            <div class="fp-modal-header">
                <span class="fp-modal-title"><i class="fa fa-dumbbell"></i> ADD EXERCISE</span>
                <button class="fp-modal-close" @onclick='() => showExerciseModal = false'><i class="fa fa-times"></i></button>
            </div>
            <div class="fp-modal-body">
                <div class="fp-input-group">
                    <label>Exercise Name *</label>
                    <input @bind="newExercise.ExerciseName" placeholder="Bench Press" />
                </div>
                <div class="fp-grid-3">
                    <div class="fp-input-group">
                        <label>Sets *</label>
                        <input @bind="newExercise.Sets" placeholder="4" />
                    </div>
                    <div class="fp-input-group">
                        <label>Reps *</label>
                        <input @bind="newExercise.Reps" placeholder="8-10" />
                    </div>
                    <div class="fp-input-group">
                        <label>Rest Time *</label>
                        <input @bind="newExercise.RestTime" placeholder="90s" />
                    </div>
                </div>
                <div class="fp-input-group">
                    <label>Video Link (optional)</label>
                    <input @bind="newExercise.ExerciseLink" placeholder="https://youtube.com/..." />
                </div>
            </div>
            <div class="fp-modal-footer">
                <button class="fp-btn-outline" @onclick='() => showExerciseModal = false'>Cancel</button>
                <button class="fp-btn-primary" @onclick="AddExercise">
                    <i class="fa fa-check"></i> Add Exercise
                </button>
            </div>
        </div>
    </div>
}

@* Add Cardio Modal *@
@if (showCardioModal)
{
    <div class="fp-modal-overlay" @onclick='() => showCardioModal = false'>
        <div class="fp-modal" @onclick:stopPropagation="true">
            <div class="fp-modal-header">
                <span class="fp-modal-title"><i class="fa fa-running"></i> ADD CARDIO</span>
                <button class="fp-modal-close" @onclick='() => showCardioModal = false'><i class="fa fa-times"></i></button>
            </div>
            <div class="fp-modal-body">
                <div class="fp-input-group">
                    <label>Cardio Type *</label>
                    <input @bind="newCardio.CardioType" placeholder="Treadmill / Bike / Rowing..." />
                </div>
                <div class="fp-grid-2">
                    <div class="fp-input-group">
                        <label>Duration (minutes) *</label>
                        <input type="number" @bind="newCardio.DurationMinutes" placeholder="20" />
                    </div>
                    <div class="fp-input-group">
                        <label>Intensity *</label>
                        <select @bind="newCardioIntensity">
                            <option value="0">Low</option>
                            <option value="1">Medium</option>
                            <option value="2">High</option>
                        </select>
                    </div>
                </div>
                <div class="fp-input-group">
                    <label>Notes (optional)</label>
                    <input @bind="newCardio.Notes" placeholder="After session, fasted..." />
                </div>
            </div>
            <div class="fp-modal-footer">
                <button class="fp-btn-outline" @onclick='() => showCardioModal = false'>Cancel</button>
                <button class="fp-btn-primary" @onclick="AddCardio">
                    <i class="fa fa-check"></i> Add Cardio
                </button>
            </div>
        </div>
    </div>
}

<style>
    .fp-loading { display:flex; align-items:center; gap:16px; padding:60px 0; color:var(--fp-text-muted); }
    .fp-spinner-lg { width:28px; height:28px; border:3px solid var(--fp-border); border-top-color:var(--fp-accent); border-radius:50%; animation:fp-spin 0.8s linear infinite; }
    @@keyframes fp-spin { to { transform:rotate(360deg); } }
    .fp-empty { display:flex; flex-direction:column; align-items:center; gap:16px; padding:80px 0; color:var(--fp-text-muted); }
    .fp-empty i { font-size:48px; opacity:0.2; }

    /* Header */
    .fp-client-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:28px; }
    .fp-client-header-left { display:flex; align-items:center; gap:20px; }
    .fp-back-btn { width:40px; height:40px; background:var(--fp-surface); border:1px solid var(--fp-border); color:var(--fp-text-muted); display:flex; align-items:center; justify-content:center; text-decoration:none; transition:all 0.2s; flex-shrink:0; }
    .fp-back-btn:hover { border-color:var(--fp-accent); color:var(--fp-accent); }
    .fp-client-avatar-xl { width:64px; height:64px; background:rgba(234,33,39,0.15); color:var(--fp-accent); font-family:'Teko',sans-serif; font-size:32px; font-weight:700; display:flex; align-items:center; justify-content:center; flex-shrink:0; clip-path:polygon(0 0,88% 0,100% 12%,100% 100%,12% 100%,0 88%); }
    .fp-client-title { font-family:'Teko',sans-serif; font-size:36px; font-weight:700; color:var(--fp-text); text-transform:uppercase; margin:0; line-height:1; }
    .fp-client-meta-row { display:flex; gap:20px; margin-top:6px; }
    .fp-client-meta-row span { font-size:13px; color:var(--fp-text-muted); display:flex; align-items:center; gap:6px; }
    .fp-client-meta-row i { color:var(--fp-accent); font-size:11px; }

    /* Tabs */
    .fp-tabs { display:flex; gap:4px; margin-bottom:24px; border-bottom:2px solid var(--fp-border); }
    .fp-tab { padding:12px 24px; background:transparent; border:none; color:var(--fp-text-muted); font-family:'DM Sans',sans-serif; font-size:14px; font-weight:600; cursor:pointer; transition:all 0.2s; display:flex; align-items:center; gap:8px; border-bottom:2px solid transparent; margin-bottom:-2px; }
    .fp-tab:hover { color:var(--fp-text); }
    .fp-tab.active { color:var(--fp-accent); border-bottom-color:var(--fp-accent); }
    .fp-tab i { font-size:14px; }

    /* Tab Content */
    .fp-tab-content { animation: fadeIn 0.2s ease; }
    @@keyframes fadeIn { from { opacity:0; transform:translateY(4px); } to { opacity:1; transform:translateY(0); } }

    /* Section Header */
    .fp-section-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:20px; }
    .fp-section-title { font-family:'Teko',sans-serif; font-size:28px; font-weight:700; color:var(--fp-text); text-transform:uppercase; margin:0; }
    .fp-section-sub { font-size:13px; color:var(--fp-text-muted); margin:4px 0 0; }

    /* Empty Card */
    .fp-empty-card { background:var(--fp-surface); border:1px dashed var(--fp-border); padding:60px; display:flex; flex-direction:column; align-items:center; gap:12px; color:var(--fp-text-muted); margin-bottom:20px; }
    .fp-empty-card i { font-size:36px; opacity:0.2; }
    .fp-empty-card p { font-size:15px; margin:0; }

    /* Plan Card */
    .fp-plan-card { background:var(--fp-surface); border:1px solid var(--fp-border); padding:24px; margin-bottom:20px; }
    .fp-plan-card-header { display:flex; align-items:flex-start; justify-content:space-between; margin-bottom:20px; }
    .fp-plan-card-header h3 { font-family:'Teko',sans-serif; font-size:28px; font-weight:700; color:var(--fp-text); text-transform:uppercase; margin:4px 0; line-height:1; }
