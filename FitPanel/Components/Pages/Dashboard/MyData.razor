@page "/dashboard/my-data"
@namespace FitPanel.Components.Pages.Dashboard
@layout FitPanel.Components.Layout.DashboardLayout

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using FitPanel.Data
@using FitPanel.Data.Models
@using FitPanel.Services
@using FitPanel.DTOs.Diet
@using FitPanel.DTOs.Workout
@using FitPanel.Data.Enums
@using System.Text.Json

@attribute [Authorize(Roles = "Coach")]
@inject UserManager<PanelUser> UserManager
@inject ICoachDictionaryService DictionaryService
@inject ITemplateService TemplateService
@inject AuthenticationStateProvider AuthStateProvider
@inject INutritionApiService NutritionApiService
@rendermode InteractiveServer

<PageTitle>My Data — FitPanel</PageTitle>

<head>
    <link href="/lib/clientDetalis.css" rel="stylesheet" />
</head>

<div class="fp-page-header">
    <div>
        <h1 style="font-family:'Teko',sans-serif;font-size:42px;font-weight:700;color:var(--fp-text);text-transform:uppercase;margin:0;line-height:1;">
            My Data & Templates
        </h1>
        <p style="color:var(--fp-text-muted);font-size:14px;margin-top:4px;">
            Manage your auto-saved dictionary data and plan templates
        </p>
    </div>
</div>

@if (isLoading)
{
    <div class="fp-loading">
        <div class="fp-spinner-lg"></div>
        <span>Loading your data...</span>
    </div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="fp-empty">
        <i class="fa fa-exclamation-triangle" style="color:var(--fp-accent);"></i>
        <p>@errorMessage</p>
    </div>
}
else
{
    <div class="fp-tabs" style="margin-bottom: 24px;">
        <button class="fp-tab @(activeTab == "meals" ? "active" : "")" @onclick='() => activeTab = "meals"'>
            <i class="fa fa-utensils"></i> Meals Dictionary (@meals.Count)
        </button>
        <button class="fp-tab @(activeTab == "exercises" ? "active" : "")" @onclick='() => activeTab = "exercises"'>
            <i class="fa fa-dumbbell"></i> Exercises Dictionary (@exercises.Count)
        </button>
        <button class="fp-tab @(activeTab == "diet-templates" ? "active" : "")" @onclick='() => activeTab = "diet-templates"'>
            <i class="fa fa-folder-open"></i> Diet Templates (@dietTemplates.Count)
        </button>
        <button class="fp-tab @(activeTab == "workout-templates" ? "active" : "")" @onclick='() => activeTab = "workout-templates"'>
            <i class="fa fa-dumbbell"></i> Workout Templates (@workoutTemplates.Count)
        </button>
    </div>

    @* ── MEALS DICTIONARY TAB ── *@
    @if (activeTab == "meals")
    {
        <div class="fp-card">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 20px;">
                <h3 class="fp-card-title" style="margin:0;">Meals Dictionary</h3>
                <button class="fp-btn-primary" @onclick="OpenAddMealModal">
                    <i class="fa fa-plus"></i> Add Meal
                </button>
            </div>

            @if (!meals.Any())
            {
                <div class="fp-empty">
                    <i class="fa fa-utensils"></i>
                    <p>No meals saved yet.</p>
                </div>
            }
            else
            {
                <div style="overflow-x:auto;">
                    <table class="fp-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Macros (P/C/F)</th>
                                <th>Calories</th>
                                <th>Link</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in meals)
                            {
                                <tr>
                                    <td style="font-weight:600;">@m.MealName</td>
                                    <td>@(m.Protein)g / @(m.Carbs)g / @(m.Fats)g</td>
                                    <td style="color:var(--fp-accent);font-weight:bold;">@m.Calories kcal</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(m.Link))
                                        {
                                            <a href="@m.Link" target="_blank" style="color:var(--fp-accent);"><i class="fa fa-link"></i></a>
                                        }
                                    </td>
                                    <td>
                                        <button class="fp-icon-btn" title="Edit" @onclick="() => OpenEditMealModal(m)" style="display:inline-flex;margin-right:8px;">
                                            <i class="fa fa-edit"></i>
                                        </button>
                                        <button class="fp-icon-btn" title="Delete" @onclick="() => ConfirmDeleteMeal(m)" style="display:inline-flex;color:#ff6b6b;border-color:#ff6b6b;">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    @* ── EXERCISES DICTIONARY TAB ── *@
    @if (activeTab == "exercises")
    {
        <div class="fp-card">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 20px;">
                <h3 class="fp-card-title" style="margin:0;">Exercises Dictionary</h3>
                <button class="fp-btn-primary" @onclick="OpenAddExerciseModal">
                    <i class="fa fa-plus"></i> Add Exercise
                </button>
            </div>

            @if (!exercises.Any())
            {
                <div class="fp-empty">
                    <i class="fa fa-dumbbell"></i>
                    <p>No exercises saved yet.</p>
                </div>
            }
            else
            {
                <div style="overflow-x:auto;">
                    <table class="fp-table">
                        <thead>
                            <tr>
                                <th>Exercise Name</th>
                                <th>Video Link</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ex in exercises)
                            {
                                <tr>
                                    <td style="font-weight:600;">@ex.ExerciseName</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(ex.ExcerciseLink))
                                        {
                                            <a href="@ex.ExcerciseLink" target="_blank" style="color:var(--fp-accent);"><i class="fa fa-external-link-alt"></i> Watch</a>
                                        }
                                    </td>
                                    <td>
                                        <button class="fp-icon-btn" title="Edit" @onclick="() => OpenEditExerciseModal(ex)" style="display:inline-flex;margin-right:8px;">
                                            <i class="fa fa-edit"></i>
                                        </button>
                                        <button class="fp-icon-btn" title="Delete" @onclick="() => ConfirmDeleteExercise(ex)" style="display:inline-flex;color:#ff6b6b;border-color:#ff6b6b;">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    @* ── DIET TEMPLATES TAB ── *@
    @if (activeTab == "diet-templates")
    {
        <div class="fp-card">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 20px;">
                <h3 class="fp-card-title" style="margin:0;">Diet Plan Templates</h3>
                <button class="fp-btn-primary" @onclick="OpenAddDietTemplateModal">
                    <i class="fa fa-plus"></i> Create Diet Template
                </button>
            </div>

            @if (!dietTemplates.Any())
            {
                <div class="fp-empty">
                    <i class="fa fa-folder-open"></i>
                    <p>No diet templates saved yet. Create one directly or save from any client's plan!</p>
                </div>
            }
            else
            {
                <div style="overflow-x:auto;">
                    <table class="fp-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Meals Count</th>
                                <th>Created</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var temp in dietTemplates)
                            {
                                <tr>
                                    <td style="font-weight:600;">@temp.Name</td>
                                    <td><span class="fp-badge fp-badge-red">@temp.NumberOfMeals Meals</span></td>
                                    <td style="color:var(--fp-text-muted);">@temp.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <button class="fp-icon-btn" title="Edit Template" @onclick="() => OpenEditDietTemplateModal(temp)" style="display:inline-flex;margin-right:8px;">
                                            <i class="fa fa-edit"></i>
                                        </button>
                                        <button class="fp-icon-btn" title="Delete Template" @onclick="() => ConfirmDeleteDietTemplate(temp)" style="display:inline-flex;color:#ff6b6b;border-color:#ff6b6b;">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    @* ── WORKOUT TEMPLATES TAB ── *@
    @if (activeTab == "workout-templates")
    {
        <div class="fp-card">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 20px;">
                <h3 class="fp-card-title" style="margin:0;">Workout Split Templates</h3>
                <button class="fp-btn-primary" @onclick="OpenAddWorkoutTemplateModal">
                    <i class="fa fa-plus"></i> Create Workout Template
                </button>
            </div>

            @if (!workoutTemplates.Any())
            {
                <div class="fp-empty">
                    <i class="fa fa-dumbbell"></i>
                    <p>No workout split templates saved yet. Create one directly or save from any client's plan!</p>
                </div>
            }
            else
            {
                <div style="overflow-x:auto;">
                    <table class="fp-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Split Name</th>
                                <th>Days</th>
                                <th>Created</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var temp in workoutTemplates)
                            {
                                <tr>
                                    <td style="font-weight:600;">@temp.Name</td>
                                    <td><span class="fp-badge fp-badge-blue">@temp.SplitName</span></td>
                                    <td><span class="fp-badge fp-badge-muted">@temp.NumberOfWorkoutDays Days</span></td>
                                    <td style="color:var(--fp-text-muted);">@temp.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <button class="fp-icon-btn" title="Edit Template" @onclick="() => OpenEditWorkoutTemplateModal(temp)" style="display:inline-flex;margin-right:8px;">
                                            <i class="fa fa-edit"></i>
                                        </button>
                                        <button class="fp-icon-btn" title="Delete Template" @onclick="() => ConfirmDeleteWorkoutTemplate(temp)" style="display:inline-flex;color:#ff6b6b;border-color:#ff6b6b;">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
}

@* ── MODALS ── *@

@* Meal Dictionary Modal *@
@if (showMealModal)
{
    <div class="fp-modal-overlay" @onclick="() => showMealModal = false">
        <div class="fp-modal" style="max-width: 950px; width: 95%; max-height: 90vh; overflow-y: auto;" @onclick:stopPropagation="true">
            <div class="fp-modal-header">
                <span class="fp-modal-title"><i class="fa fa-utensils"></i> @(editMeal.Id == 0 ? "ADD" : "EDIT") DICTIONARY MEAL</span>
                <button class="fp-modal-close" @onclick="() => showMealModal = false"><i class="fa fa-times"></i></button>
            </div>
            <div class="fp-modal-body">
                <div style="display: grid; grid-template-columns: 1fr 1.5fr; gap: 24px; align-items: start;">
                    
                    <!-- Left Column: Meal General Details -->
                    <div style="display: flex; flex-direction: column; gap: 16px;">
                        <div class="fp-input-group" style="margin-bottom: 0;">
                            <label>Meal Name *</label>
                            <input @bind="editMeal.MealName" placeholder="e.g. Chicken Pasta, Beef Rice..." />
                        </div>
                        <div class="fp-input-group" style="margin-bottom: 0;">
                            <label>Recipe / Instructions</label>
                            <textarea @bind="editMeal.Instruction" rows="6" placeholder="e.g. Cook the chicken with garlic, add rice and serve hot..." style="height: 140px;"></textarea>
                        </div>
                        <div class="fp-input-group" style="margin-bottom: 0;">
                            <label>Video or Recipe Link (optional)</label>
                            <input @bind="editMeal.Link" placeholder="https://youtube.com/..." />
                        </div>
                        
                        <!-- Manual Override Panel (allows editing if no ingredients added, or shows calculated sum) -->
                        <div style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06); padding: 12px; border-radius: 6px;">
                            <span style="font-size: 11px; font-weight: bold; text-transform: uppercase; color: var(--fp-text-muted); display: block; margin-bottom: 10px;">
                                <i class="fa fa-sliders-h"></i> Manual Macro Override
                            </span>
                            <div class="fp-grid-2" style="gap: 10px;">
                                <div class="fp-input-group" style="margin-bottom:0;"><label style="font-size:11px;">Calories *</label><input type="number" @bind="editMeal.Calories" disabled="@editMealIngredients.Any()" /></div>
                                <div class="fp-input-group" style="margin-bottom:0;"><label style="font-size:11px;">Protein (g)</label><input type="number" @bind="editMeal.Protein" disabled="@editMealIngredients.Any()" /></div>
                            </div>
                            <div class="fp-grid-2" style="gap: 10px; margin-top: 10px;">
                                <div class="fp-input-group" style="margin-bottom:0;"><label style="font-size:11px;">Carbs (g)</label><input type="number" @bind="editMeal.Carbs" disabled="@editMealIngredients.Any()" /></div>
                                <div class="fp-input-group" style="margin-bottom:0;"><label style="font-size:11px;">Fats (g)</label><input type="number" @bind="editMeal.Fats" disabled="@editMealIngredients.Any()" /></div>
                            </div>
                            @if (editMealIngredients.Any())
                            {
                                <span style="font-size: 10px; color: var(--fp-accent); display: block; margin-top: 8px;">
                                    * Macros are calculated automatically from ingredients list.
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Right Column: Ingredients & Macros -->
                    <div>
                        <!-- Macro Summary Badges -->
                        <span style="font-family: 'Teko', sans-serif; font-size: 18px; color: #888; display: block; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 1px;">Calculated Macro Totals</span>
                        <div style="display: flex; gap: 10px; margin-bottom: 16px; flex-wrap: wrap;">
                            <div style="flex: 1; min-width: 80px; background: rgba(59,130,246,0.1); border: 1px solid rgba(59,130,246,0.2); padding: 8px; border-radius: 6px; text-align: center;">
                                <span style="display: block; font-size: 11px; text-transform: uppercase; color: #93c5fd; font-weight: 600;">Protein</span>
                                <span style="font-size: 18px; font-weight: bold; color: #fff;">@editMeal.Protein<small style="font-size: 11px; font-weight: normal; margin-left: 2px;">g</small></span>
                            </div>
                            <div style="flex: 1; min-width: 80px; background: rgba(245,158,11,0.1); border: 1px solid rgba(245,158,11,0.2); padding: 8px; border-radius: 6px; text-align: center;">
                                <span style="display: block; font-size: 11px; text-transform: uppercase; color: #fde047; font-weight: 600;">Carbs</span>
                                <span style="font-size: 18px; font-weight: bold; color: #fff;">@editMeal.Carbs<small style="font-size: 11px; font-weight: normal; margin-left: 2px;">g</small></span>
                            </div>
                            <div style="flex: 1; min-width: 80px; background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.2); padding: 8px; border-radius: 6px; text-align: center;">
                                <span style="display: block; font-size: 11px; text-transform: uppercase; color: #6ee7b7; font-weight: 600;">Fats</span>
                                <span style="font-size: 18px; font-weight: bold; color: #fff;">@editMeal.Fats<small style="font-size: 11px; font-weight: normal; margin-left: 2px;">g</small></span>
                            </div>
                            <div style="flex: 1.2; min-width: 100px; background: rgba(234,33,39,0.1); border: 1px solid rgba(234,33,39,0.2); padding: 8px; border-radius: 6px; text-align: center;">
                                <span style="display: block; font-size: 11px; text-transform: uppercase; color: #fca5a5; font-weight: 600;">Calories</span>
                                <span style="font-size: 18px; font-weight: bold; color: var(--fp-accent);">@editMeal.Calories<small style="font-size: 11px; font-weight: normal; margin-left: 2px;">kcal</small></span>
                            </div>
                        </div>

                        <!-- Ingredients block -->
                        <div style="background: rgba(0,0,0,0.15); border: 1px solid rgba(255,255,255,0.05); padding: 16px; border-radius: 8px; max-height: 480px; overflow-y: auto;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; position: sticky; top: 0; background: #1e1e1e; padding: 13px; z-index: 10;">
                                <span style="font-family: 'Teko', sans-serif; font-size: 22px; color: #fff; text-transform: uppercase;">Ingredients List</span>
                                <button type="button" class="fp-btn-primary fp-btn-sm" style="padding: 6px 12px;" @onclick="AddIngredientToDictMeal">
                                    <i class="fa fa-plus"></i> Add Food Item
                                </button>
                            </div>
                            
                            @if (!editMealIngredients.Any())
                            {
                                <div style="text-align: center; padding: 40px 20px; opacity: 0.4;">
                                    <i class="fa fa-info-circle" style="font-size: 32px; margin-bottom: 10px; display: block; color: var(--fp-accent);"></i>
                                    <span style="font-size: 13px;">No ingredients added yet. Click "Add Food Item" to build your meal's recipe details and auto-calculate macros!</span>
                                </div>
                            }
                            else
                            {
                                @for (int i = 0; i < editMealIngredients.Count; i++)
                                {
                                    var idx = i;
                                    var ing = editMealIngredients[idx];
                                    
                                    <div style="background: #262626; padding: 12px; border-radius: 6px; margin-bottom: 10px; border: 1px solid rgba(255,255,255,0.04);">
                                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                                            <span style="font-weight: 700; font-size: 13px; color: #fff;">Food Item #@(idx + 1)</span>
                                            <div style="display: flex; align-items: center; gap: 6px;">
                                                <button type="button" class="fp-btn-outline fp-btn-sm" style="color: #6ee7b7; border-color: rgba(110,231,183,0.3); padding: 2px 8px; font-size: 11px;" @onclick="() => FetchIngredientMacrosFromNinja(ing)">
                                                    <i class="fa fa-bolt"></i> Ninja Fill
                                                </button>
                                                <button type="button" class="fp-icon-btn" style="color: #ff6b6b; border-color: rgba(255,107,107,0.3); width: 24px; height: 24px; display: inline-flex;" @onclick="() => RemoveIngredientFromDictMeal(idx)">
                                                    <i class="fa fa-times"></i>
                                                </button>
                                            </div>
                                        </div>
                                        
                                        <div style="display: flex; gap: 8px; margin-bottom: 8px;">
                                            <div style="flex: 2.2; min-width: 0;">
                                                <input @bind="ing.MealName" placeholder="Food Name (e.g. Basmati Rice)" style="height: 36px; padding: 0 10px; font-size: 13px; background: #1a1a1a; border-radius: 4px; border: 1px solid rgba(255,255,255,0.08);" />
                                            </div>
                                            <div style="flex: 1; min-width: 0;">
                                                <input type="number" step="any" @bind="ing.Quantity" @bind:after="RecalculateDictionaryMealMacros" placeholder="Qty" style="height: 36px; padding: 0 10px; font-size: 13px; background: #1a1a1a; border-radius: 4px; border: 1px solid rgba(255,255,255,0.08);" />
                                            </div>
                                            <div style="flex: 1; min-width: 0;">
                                                <input @bind="ing.Unit" placeholder="Unit (e.g. g)" style="height: 36px; padding: 0 10px; font-size: 13px; background: #1a1a1a; border-radius: 4px; border: 1px solid rgba(255,255,255,0.08);" />
                                            </div>
                                        </div>
                                        
                                        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px;">
                                            <div>
                                                <label style="font-size: 9px; text-transform: uppercase; color: #aaa; display: block; margin-bottom: 2px; font-weight:600;">Protein (g)</label>
                                                <input type="number" @bind="ing.Protein" @bind:after="RecalculateDictionaryMealMacros" style="height: 32px; padding: 0 8px; font-size: 12px; background: #1a1a1a; border-radius: 4px; border: 1px solid rgba(255,255,255,0.08);" />
                                            </div>
                                            <div>
                                                <label style="font-size: 9px; text-transform: uppercase; color: #aaa; display: block; margin-bottom: 2px; font-weight:600;">Carbs (g)</label>
                                                <input type="number" @bind="ing.Carbs" @bind:after="RecalculateDictionaryMealMacros" style="height: 32px; padding: 0 8px; font-size: 12px; background: #1a1a1a; border-radius: 4px; border: 1px solid rgba(255,255,255,0.08);" />
                                            </div>
                                            <div>
                                                <label style="font-size: 9px; text-transform: uppercase; color: #aaa; display: block; margin-bottom: 2px; font-weight:600;">Fats (g)</label>
                                                <input type="number" @bind="ing.Fats" @bind:after="RecalculateDictionaryMealMacros" style="height: 32px; padding: 0 8px; font-size: 12px; background: #1a1a1a; border-radius: 4px; border: 1px solid rgba(255,255,255,0.08);" />
                                            </div>
                                            <div>
                                                <label style="font-size: 9px; text-transform: uppercase; color: #aaa; display: block; margin-bottom: 2px; font-weight:600;">Calories</label>
                                                <input type="number" @bind="ing.Calories" readonly style="height: 32px; padding: 0 8px; font-size: 12px; background: rgba(255,255,255,0.03); border-radius: 4px; border: 1px solid rgba(255,255,255,0.08); color: var(--fp-accent); font-weight: bold;" />
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="fp-modal-footer">
                <button class="fp-btn-outline" @onclick="() => showMealModal = false" disabled="@isSaving">Cancel</button>
                <button class="fp-btn-primary" @onclick="SaveMeal" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span style="width: 12px; height: 12px; border: 2px solid #fff; border-right-color: transparent; border-radius: 50%; display: inline-block; animation: spin 0.75s linear infinite; margin-right: 6px; vertical-align: middle;"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <i class="fa fa-save"></i> <span>Save Meal</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@* Exercise Dictionary Modal *@
@if (showExerciseModal)
{
    <div class="fp-modal-overlay" @onclick="() => showExerciseModal = false">
        <div class="fp-modal" @onclick:stopPropagation="true">
            <div class="fp-modal-header">
                <span class="fp-modal-title"><i class="fa fa-dumbbell"></i> @(editExercise.Id == 0 ? "ADD" : "EDIT") DICTIONARY EXERCISE</span>
                <button class="fp-modal-close" @onclick="() => showExerciseModal = false"><i class="fa fa-times"></i></button>
            </div>
            <div class="fp-modal-body">
                <div class="fp-input-group"><label>Exercise Name *</label><input @bind="editExercise.ExerciseName" /></div>
                <div class="fp-input-group"><label>Video Link</label><input @bind="editExercise.ExcerciseLink" /></div>
            </div>
            <div class="fp-modal-footer">
                <button class="fp-btn-outline" @onclick="() => showExerciseModal = false" disabled="@isSaving">Cancel</button>
                <button class="fp-btn-primary" @onclick="SaveExercise" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span style="width: 12px; height: 12px; border: 2px solid #fff; border-right-color: transparent; border-radius: 50%; display: inline-block; animation: spin 0.75s linear infinite; margin-right: 6px; vertical-align: middle;"></span>
                        <span>Saving...</span>
