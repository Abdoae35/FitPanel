@* Diet Template Modal Editor *@
@if (showDietTemplateModal)
{
    <div class="fp-modal-overlay" @onclick="() => showDietTemplateModal = false">
        <div class="fp-modal" style="max-width: 950px; width: 95%; max-height: 90vh; overflow-y: auto;" @onclick:stopPropagation="true">
            <div class="fp-modal-header">
                <span class="fp-modal-title"><i class="fa fa-folder-open"></i> @(editDietTemplate.Id == 0 ? "CREATE" : "EDIT") DIET TEMPLATE</span>
                <button class="fp-modal-close" @onclick="() => showDietTemplateModal = false"><i class="fa fa-times"></i></button>
            </div>
            <div class="fp-modal-body">
                <div class="fp-grid-2">
                    <div class="fp-input-group">
                        <label>Template Name *</label>
                        <input @bind="editDietTemplate.Name" placeholder="e.g. 2000kcal High Protein Plan" />
                    </div>
                    <div class="fp-input-group">
                        <label>Expected Number of Meals</label>
                        <input type="number" readonly value="@editDietTemplateMeals.Count" style="background:rgba(255,255,255,0.05); color:var(--fp-text-muted);" />
                    </div>
                </div>
                
                <div class="fp-input-group">
                    <label>Instructions & Recipe Guidelines</label>
                    <textarea @bind="editDietTemplate.Instructions" rows="3" placeholder="General rules (e.g. Drink 3L water, take multivitamins in the morning)..."></textarea>
                </div>

                <div style="margin-top:20px; border-top: 1px solid var(--fp-border); padding-top:20px;">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 16px;">
                        <h4 style="margin:0; font-family:'Teko',sans-serif; font-size:24px; color:var(--fp-accent); text-transform:uppercase; letter-spacing:1px;">Meals inside Template</h4>
                        <button type="button" class="fp-btn-outline" @onclick="AddMealToTemplate">
                            <i class="fa fa-plus"></i> Add Meal
                        </button>
                    </div>

                    @if (!editDietTemplateMeals.Any())
                    {
                        <p style="color:var(--fp-text-muted); font-size:14px; font-style:italic;">No meals added to this template yet. Click "Add Meal" above.</p>
                    }
                    else
                    {
                        @for (int i = 0; i < editDietTemplateMeals.Count; i++)
                        {
                            var idx = i;
                            var meal = editDietTemplateMeals[idx];
                            var primaryIng = meal.Ingredients.FirstOrDefault();

                            <div class="fp-plan-card" style="margin-top:0; margin-bottom:16px; background:#1e1e1e; border-radius:8px; padding: 20px;">
                                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
